---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Logo from '../components/ui/Logo.astro';
import StatusBadge from '../components/guide/StatusBadge.astro';
import { href } from '../i18n/locale';
import type { Locale } from '../i18n/routes';
import { formatDate, t } from '../i18n/ui';
import { currentVersion, getFact } from '../lib/data';
import { href as pageHref } from '../i18n/locale';
import { lastModified, websiteJsonLd } from '../lib/seo';
import type { PageFrontmatter } from '../lib/schemas';

interface Props {
  locale: Locale;
  data: PageFrontmatter;
}

const { locale, data } = Astro.props;
const es = locale === 'es';
const statusFacts = ['launch', 'beta', 'level-cap'].map(getFact);
const site = Astro.site ?? new URL('https://sheep-happens.pages.dev');
const homeUrl = new URL(pageHref('home', locale), site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  locale={locale}
  pageId="home"
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  image={`${base}og/${locale}-home.png`}
  jsonLd={[websiteJsonLd(locale, homeUrl, data.description)]}
  modified={lastModified('home', data.reviewed)}
>
  <div class="container home" data-pagefind-body>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__intro">
        <p class="hero__kicker">
          <Logo size={26} />
          World of Warcraft: Forever · {es ? 'Mago' : 'Mage'}
        </p>
        <h1 id="hero-title" data-pagefind-meta="title">{data.title}</h1>
        <p class="hero__lead">{data.description}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={href('guide', locale)}>
            <Icon name="book" size={18} />
            {es ? 'Empezar la guía' : 'Start the guide'}
          </a>
          <a class="button" href={href('changes', locale)}>
            <Icon name="filter" size={18} />
            {es ? 'Ver qué cambia' : 'See what changes'}
          </a>
          <button type="button" class="button" data-search-open aria-haspopup="dialog">
            <Icon name="search" size={18} />
            {t(locale, 'search.open')}
            <kbd aria-hidden="true">/</kbd>
          </button>
        </div>
      </div>

      <aside class="status-card" aria-labelledby="status-title">
        <p class="status-card__title" id="status-title">
          <Icon name="info" size={18} />
          {es ? 'Estado de la información' : 'Information status'}
        </p>
        <p class="status-card__version">{currentVersion.label[locale]}</p>
        <dl>
          {
            statusFacts.map((fact) => (
              <div>
                <dt>
                  {fact.label[locale]} <StatusBadge status={fact.status} compact />
                </dt>
                <dd>{fact.value[locale]}</dd>
              </div>
            ))
          }
        </dl>
        <p class="status-card__reviewed">
          {t(locale, 'meta.reviewed')}: <time datetime={data.reviewed.toISOString().slice(0, 10)}>{formatDate(locale, data.reviewed)}</time>
        </p>
        <a href={href('sources', locale)}>{t(locale, 'meta.howWeVerify')}</a>
      </aside>
    </section>

    <div class="home__content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: var(--space-6);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--border);
  }
  .hero__intro {
    display: grid;
    gap: var(--space-4);
  }
  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .hero__lead {
    max-width: 38rem;
    font-size: var(--step-1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .status-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    box-shadow: var(--shadow);
  }
  .status-card__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warning);
  }
  .status-card__version {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .status-card dl {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--step--1);
  }
  .status-card dt {
    font-weight: 700;
    color: var(--text-muted);
  }
  .status-card dd {
    margin: 0;
  }
  .status-card__reviewed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .status-card a {
    font-size: var(--step--1);
  }
  .home__content {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }
  .home__content :global(h2) {
    margin-top: var(--space-6);
    font-size: var(--step-3);
  }
  .home__content :global(h2:first-child) {
    margin-top: 0;
  }
  .home__content :global(h2 + p) {
    max-width: 46rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import LaunchCountdown from '../components/guide/LaunchCountdown.astro';
import StatusBadge from '../components/guide/StatusBadge.astro';
import { href } from '../i18n/locale';
import type { Locale } from '../i18n/routes';
import { formatDate, t } from '../i18n/ui';
import { currentVersion, getFact } from '../lib/data';
import { lastModified, websiteJsonLd } from '../lib/seo';
import type { PageFrontmatter } from '../lib/schemas';

interface Props {
  locale: Locale;
  data: PageFrontmatter;
  /** MDX source, to date the page by the data it shows. */
  body?: string;
}

const { locale, data, body = '' } = Astro.props;
const modified = lastModified('home', data.reviewed, body);
const es = locale === 'es';
const statusFacts = ['launch', 'beta'].map(getFact);
const { launchAt } = currentVersion;
const site = Astro.site ?? new URL('https://sheephappens.app');
const siteUrl = new URL(import.meta.env.BASE_URL, site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  locale={locale}
  pageId="home"
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  image={`${base}og/${locale}-home.png`}
  jsonLd={[websiteJsonLd(locale, siteUrl, data.description)]}
  modified={modified}
>
  <div class="container home" data-pagefind-body>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__magic" aria-hidden="true">
        <canvas class="hero__motes" data-motes></canvas>
        <svg class="hero__sigil" viewBox="0 0 200 200" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="100" cy="100" r="96" />
            <circle cx="100" cy="100" r="78" stroke-dasharray="2 6" />
            <circle cx="100" cy="100" r="52" />
            <path d="M100 4 L183 148 L17 148 Z" />
            <path d="M100 196 L17 52 L183 52 Z" />
          </g>
          <g class="hero__runes" fill="currentColor"><text x="183.0" y="104.0">ᚠ</text><text x="171.3" y="147.5">ᚢ</text><text x="139.5" y="179.3">ᚦ</text><text x="96.0" y="191.0">ᚨ</text><text x="52.5" y="179.3">ᚱ</text><text x="20.7" y="147.5">ᚲ</text><text x="9.0" y="104.0">ᚷ</text><text x="20.7" y="60.5">ᚹ</text><text x="52.5" y="28.7">ᚺ</text><text x="96.0" y="17.0">ᚾ</text><text x="139.5" y="28.7">ᛁ</text><text x="171.3" y="60.5">ᛃ</text></g>
        </svg>
      </div>
      <div class="hero__intro">
        <h1 id="hero-title" data-pagefind-meta="title">{data.title}</h1>
        <p class="hero__lead">{data.description}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={href('learn', locale)}>
            <Icon name="book" size={18} />
            {es ? 'Soy nuevo: aprende' : "I'm new: learn"}
          </a>
          <a class="button button--primary" href={href('builds', locale)}>
            <Icon name="layers" size={18} />
            {es ? 'Ya sé jugar: builds' : 'I know the class: builds'}
          </a>
          <a class="button" href={href('races', locale)}>
            <Icon name="users" size={18} />
            {es ? '¿Qué raza elijo?' : 'Which race?'}
          </a>
          <a class="button" href={href('level-view', locale)}>
            <Icon name="level" size={18} />
            {es ? 'Estoy a nivel…' : "I'm level…"}
          </a>
        </div>
      </div>

      <aside class="status-card" aria-labelledby="status-title">
        <p class="status-card__title" id="status-title">
          <Icon name="info" size={18} />
          {es ? 'Estado de la información' : 'Information status'}
        </p>
        <p class="status-card__version">{currentVersion.label[locale]}</p>
        <dl>
          {
            statusFacts.map((fact) => (
              <div>
                <dt>
                  {fact.label[locale]} <StatusBadge status={fact.status} compact />
                </dt>
                <dd>
                  {/* The launch: countdown and the time in the reader's time zone (UTC and CET without JS). */}
                  {fact.id === 'launch' && launchAt ? <LaunchCountdown at={launchAt} /> : fact.value[locale]}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="status-card__reviewed">
          {t(locale, 'meta.reviewed')}: <time datetime={modified.toISOString().slice(0, 10)}>{formatDate(locale, modified)}</time>
        </p>
        <a href={href('sources', locale)}>{t(locale, 'meta.howWeVerify')}</a>
      </aside>
    </section>

    <div class="home__content">
      <slot />
    </div>
  </div>
</BaseLayout>

<script>
  // Mana motes for the home hero. They stop when the hero is off screen or the
  // tab is hidden; with «reduce motion» they are drawn once and stay still.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-motes]');
  const context = canvas?.getContext('2d');
  if (canvas && context) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    type Mote = { x: number; y: number; r: number; v: number; p: number };
    let motes: Mote[] = [];
    let width = 0;
    let height = 0;
    let colour = '169, 139, 255';
    const readColour = () => {
      const match = getComputedStyle(canvas).color.match(/\d+(\.\d+)?/g);
      if (match) colour = match.slice(0, 3).join(', ');
    };
    const resize = () => {
      const box = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = box.width;
      height = box.height;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      motes = Array.from({ length: Math.round(Math.min(width, 1400) / 16) }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.8 + 0.4,
        v: Math.random() * 0.25 + 0.08,
        p: Math.random() * Math.PI * 2,
      }));
    };
    const draw = (move: boolean) => {
      context.clearRect(0, 0, width, height);
      context.shadowBlur = 6;
      context.shadowColor = `rgba(${colour}, 0.8)`;
      for (const mote of motes) {
        if (move) {
          mote.y -= mote.v;
          mote.p += 0.02;
          if (mote.y < -4) {
            mote.y = height + 4;
            mote.x = Math.random() * width;
          }
        }
        context.beginPath();
        context.arc(mote.x + Math.sin(mote.p) * 3, mote.y, mote.r, 0, Math.PI * 2);
        context.fillStyle = `rgba(${colour}, ${0.35 + Math.sin(mote.p) * 0.3})`;
        context.fill();
      }
    };
    let visible = true;
    let running = false;
    const tick = () => {
      if (!visible || document.hidden) {
        running = false;
        return;
      }
      draw(true);
      requestAnimationFrame(tick);
    };
    const start = () => {
      if (calm || running || !visible || document.hidden) return;
      running = true;
      requestAnimationFrame(tick);
    };
    readColour();
    resize();
    draw(false);
    new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      start();
    }).observe(canvas);
    document.addEventListener('visibilitychange', start);
    window.addEventListener('resize', () => {
      resize();
      draw(false);
    });
    // The theme switch changes the accent colour.
    new MutationObserver(() => {
      readColour();
      if (calm) draw(false);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColour);
  }
</script>

<style>
  .home {
    padding-top: var(--space-6);
  }
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--border);
  }
  /* The arcane field: mana motes drifting up and a rune circle turning very slowly. */
  .hero__magic {
    position: absolute;
    inset: calc(var(--space-6) * -1) calc(var(--gutter) * -1) 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    color: var(--accent);
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .hero__motes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__sigil {
    position: absolute;
    top: 50%;
    right: 40%;
    width: 24rem;
    height: 24rem;
    translate: 50% -50%;
    opacity: 0.18;
    animation: hero-sigil 240s linear infinite;
  }
  .hero__runes {
    font-family: serif;
    font-size: 11px;
  }
  @keyframes hero-sigil {
    to {
      rotate: 360deg;
    }
  }
  .hero__intro {
    display: grid;
    gap: var(--space-4);
  }
  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .hero__lead {
    max-width: 38rem;
    font-size: var(--step-1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .status-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface-1) 86%, transparent);
    backdrop-filter: blur(3px);
    box-shadow: var(--shadow);
  }
  .status-card__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warning);
  }
  .status-card__version {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .status-card dl {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--step--1);
  }
  .status-card dt {
    font-weight: 700;
    color: var(--text-muted);
  }
  .status-card dd {
    margin: 0;
  }
  .status-card__reviewed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .status-card a {
    font-size: var(--step--1);
  }
  .home__content {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }
  .home__content :global(h2) {
    margin-top: var(--space-6);
    font-size: var(--step-3);
  }
  .home__content :global(h2:first-child) {
    margin-top: 0;
  }
  .home__content :global(h2 + p) {
    max-width: 46rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .hero__sigil {
      right: 0;
      top: 30%;
    }
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>

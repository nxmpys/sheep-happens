---
import BaseLayout from './BaseLayout.astro';
import LandingHero from '../components/home/LandingHero.astro';
import SayHi from '../components/home/SayHi.astro';
import type { Locale } from '../i18n/routes';
import { currentVersion } from '../lib/data';
import { lastModified, websiteJsonLd } from '../lib/seo';
import type { PageFrontmatter } from '../lib/schemas';

interface Props {
  locale: Locale;
  data: PageFrontmatter;
  /** MDX source, to date the page by the data it shows. */
  body?: string;
}

const { locale, data, body = '' } = Astro.props;
const modified = lastModified('home', data.reviewed, body);
const { launchAt } = currentVersion;
const site = Astro.site ?? new URL('https://sheephappens.app');
const siteUrl = new URL(import.meta.env.BASE_URL, site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  locale={locale}
  pageId="home"
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  image={`${base}og/${locale}-home.png`}
  jsonLd={[websiteJsonLd(locale, siteUrl, data.description)]}
  modified={modified}
>
  <div class="container home" data-pagefind-body>
    <LandingHero locale={locale} pageTitle={data.title} launchAt={launchAt} />

    <!-- A sheet that rises over the hero: the arcs stay in the window for as long as it lasts. -->
    <div class="home__below" data-home-below>
      <div class="home__backdrop" aria-hidden="true"><canvas class="home__arcs" data-home-arcs></canvas></div>
      <div class="home__content">
        <slot />
      </div>
      <SayHi />
    </div>
  </div>
</BaseLayout>

<script>
  import { startHomeArcs } from '../scripts/home-arcs';

  const arcs = document.querySelector<HTMLCanvasElement>('[data-home-arcs]');
  if (arcs) startHomeArcs(arcs);

  // The header stops being dark on the picture once the sheet reaches it.
  const below = document.querySelector<HTMLElement>('[data-home-below]');
  const header = document.querySelector<HTMLElement>('.site-header');
  const place = () => {
    if (below && header) document.body.classList.toggle('is-past-hero', below.getBoundingClientRect().top <= header.offsetHeight);
  };
  place();
  addEventListener('scroll', place, { passive: true });
  addEventListener('resize', place);
</script>

<style>
  /* Over the picture the header has no bar of its own, and it reads as dark. */
  :global(body:has(.lhero):not(.is-past-hero) .site-header) {
    color-scheme: dark;
  }
  @supports (animation-timeline: scroll()) {
    :global(body:has(.lhero) .site-header) {
      animation: header-over linear both;
      animation-timeline: scroll(root);
      animation-range: 0 60svh;
    }
  }
  @keyframes header-over {
    from {
      background: transparent;
      border-color: transparent;
      backdrop-filter: none;
    }
  }
  .home__below {
    position: relative;
    z-index: 1;
  }
  .home__backdrop {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    overflow: clip;
    border-radius: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) 0 0;
    /* The shadow falls on the hero only, never on the footer. */
    box-shadow: 0 -30px 80px rgb(5 7 15 / 0.7);
    clip-path: inset(-120px 0 0);
    background: var(--bg);
    pointer-events: none;
  }
  .home__arcs {
    position: sticky;
    top: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: 100svh;
  }
  /* The arcs die out before the footer, so nothing cuts them off. */
  .home__backdrop::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 60svh;
    background: linear-gradient(0deg, var(--bg), transparent);
  }
  .home__content {
    position: relative;
    display: grid;
    gap: var(--space-4);
  }
  .home__content :global(h2) {
    margin-top: clamp(4rem, 10vh, 7rem);
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.25rem);
  }
  .home__content :global(h2:first-child) {
    margin-top: 0;
  }
  .home__content :global(h2 + p) {
    max-width: 46rem;
    color: var(--text-muted);
  }
  /* Whatever comes into view rises a little; nothing starts hidden. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .home__content > :global(:not(.qglobe)) {
        animation: home-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
    }
  }
  @keyframes home-rise {
    from {
      opacity: 0.4;
      transform: translateY(26px);
    }
  }
</style>

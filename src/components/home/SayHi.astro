---
/**
 * End of the home page: «Say hi» as a letter, then the site name as large as the
 * window. The email is the address line (it opens the mail app; the button copies
 * it), and the other ways to find me are its postscripts. The name's letters rise
 * one by one each time it comes into view; without JavaScript they are simply there.
 */
import '@fontsource/permanent-marker';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/nunito/wght.css';
import Logo from '../ui/Logo.astro';
import { getLocale, href } from '../../i18n/locale';

const locale = getLocale(Astro);
const es = locale === 'es';
const email = 'hello@sheephappens.app';
const name = 'Sheep Happens';
const strings = es
  ? {
      title: 'Escríbeme',
      lead: '¿Has visto un dato mal, tienes una duda o solo quieres hablar del Mago? Mándame una carta. Bueno, un correo.',
      to: 'Para',
      copy: 'Copiar',
      copied: '¡Copiado!',
      sign: 'Nxmpys',
    }
  : {
      title: 'Say hi',
      lead: 'Spotted a wrong number, have a question or just want to talk Mage? Send me a letter. Well, an email.',
      to: 'To',
      copy: 'Copy',
      copied: 'Copied!',
      sign: 'Nxmpys',
    };
const postscripts = es
  ? [
      { tag: 'P. D.', before: '¿Perdido? ', link: 'La guía empieza aquí', after: '.', url: href('learn', locale) },
      { tag: 'P. P. D.', before: 'También hago ', link: 'MageProcs', after: ', un addon de alertas de procs.', url: href('addons', locale) },
      { tag: 'P. P. P. D.', before: 'Estoy en X como ', link: '@nxmpys', after: '.', url: 'https://x.com/nxmpys', external: true },
    ]
  : [
      { tag: 'P.S.', before: 'Lost? ', link: 'The guide starts here', after: '.', url: href('learn', locale) },
      { tag: 'P.P.S.', before: 'I also make ', link: 'MageProcs', after: ', a proc alert addon.', url: href('addons', locale) },
      { tag: 'P.P.P.S.', before: 'I’m on X as ', link: '@nxmpys', after: '.', url: 'https://x.com/nxmpys', external: true },
    ];
---

<section class="mail" data-no-spell-links aria-labelledby="say-hi">
  <div class="mail__inner">
    <div class="mail__intro">
      <h2 class="mail__title" id="say-hi">{strings.title}</h2>
      <p class="mail__lead">{strings.lead}</p>
    </div>

    <div class="letter">
      <span class="letter__seal" aria-hidden="true"><Logo size={40} /></span>
      <p class="letter__to">{strings.to}:</p>
      <div class="letter__address">
        <a class="letter__email" href={`mailto:${email}`}>{email}</a>
        <button class="letter__copy" type="button" data-copy-email={JSON.stringify({ email, copied: strings.copied, copy: strings.copy })}>
          <span data-copy-label aria-live="polite">{strings.copy}</span>
        </button>
      </div>
      <ul class="letter__ps">
        {
          postscripts.map((ps) => (
            <li>
              <span class="letter__tag">{ps.tag}</span> {ps.before}
              <a href={ps.url} {...(ps.external && { target: '_blank', rel: 'noopener' })}>
                {ps.link}
              </a>
              {ps.after}
            </li>
          ))
        }
      </ul>
      <p class="letter__sign">— {strings.sign}</p>
    </div>
  </div>

  <p class="mail__name" aria-hidden="true" data-pagefind-ignore data-mail-name>
    {
      name.split(' ').map((word, w) => (
        <span class="mail__word">
          {word.split('').map((letter, i) => (
            <span style={`--i: ${w * 6 + i}`}>{letter}</span>
          ))}
        </span>
      ))
    }
  </p>
</section>

<script>
  import { copyText } from '../../scripts/clipboard';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
    const { email, copied, copy } = JSON.parse(button.dataset.copyEmail ?? '{}');
    const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      if (!(await copyText(email))) return;
      label.textContent = copied;
      button.classList.add('is-copied');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = copy;
        button.classList.remove('is-copied');
      }, 1800);
    });
  }

  const name = document.querySelector<HTMLElement>('[data-mail-name]');
  if (name && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    name.classList.add('is-waiting');
    // Out of sight it gets ready again, so it rises every time the reader comes back down.
    new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.intersectionRatio >= 0.25) name.classList.remove('is-waiting');
        else if (!entry.isIntersecting) name.classList.add('is-waiting');
      },
      { threshold: [0, 0.25] },
    ).observe(name);
  }
</script>

<style>
  /* The name closes the page, right on top of the footer. */
  :global(body:has(.mail) .site-footer) {
    margin-top: 0;
  }
  .mail {
    --font-display: 'Fraunces Variable', 'Spectral', Georgia, serif;
    --font-body: 'Nunito Variable', 'Inter Variable', system-ui, sans-serif;
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    z-index: 1;
    margin-top: clamp(4rem, 10vh, 7rem);
    padding-top: clamp(4rem, 12vh, 8rem);
    overflow: clip;
    color: var(--text);
    font-family: var(--font-body);
    font-variation-settings: 'SOFT' 100;
  }
  .mail__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .mail__intro {
    display: grid;
    gap: var(--space-4);
  }
  .mail__title {
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
    line-height: 1.05;
  }
  .mail__lead {
    max-width: 30rem;
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Barely there against the page, as wide as the window, resting on its lower edge. */
  .mail__name {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.28em;
    margin: clamp(3rem, 9vh, 6rem) 0 0;
    font-family: 'Cinzel Decorative', var(--font-display);
    font-size: 10.6vw;
    font-weight: 700;
    line-height: 1.05;
    white-space: nowrap;
    color: color-mix(in srgb, var(--text) 12%, transparent);
    user-select: none;
  }
  .mail__word span {
    display: inline-block;
    transition:
      transform 1.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 45ms);
  }
  .mail__name.is-waiting .mail__word span {
    transition: none;
    opacity: 0;
    transform: translateY(0.4em);
  }
  @media (max-width: 560px) {
    .mail__name {
      font-size: 18vw;
      flex-direction: column;
      align-items: center;
    }
  }

  /* The letter: parchment, slightly askew, straightening up when you come close. */
  .letter {
    position: relative;
    display: grid;
    gap: var(--space-4);
    width: min(100%, 34rem);
    justify-self: center;
    padding: clamp(1.5rem, 1rem + 3vw, 2.75rem);
    border-radius: 6px;
    background:
      repeating-linear-gradient(180deg, transparent 0 31px, rgb(120 84 40 / 0.12) 31px 32px),
      radial-gradient(120% 90% at 20% 10%, #f8eed8, #e6d3ab);
    box-shadow:
      0 30px 60px rgb(0 0 0 / 0.5),
      inset 0 0 40px rgb(120 84 40 / 0.25);
    color: #2b1d10;
    transform: rotate(-1.5deg);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .letter:hover,
  .letter:focus-within {
    transform: rotate(0);
  }
  /* A wax seal with the sheep pressed in. */
  .letter__seal {
    position: absolute;
    top: -22px;
    right: clamp(1rem, 4vw, 2rem);
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 47% 53% 50% 50% / 52% 48% 52% 48%;
    background: radial-gradient(circle at 35% 30%, #c2465a, #8a1c30 60%, #5e1020);
    box-shadow:
      0 6px 14px rgb(0 0 0 / 0.4),
      inset 0 -3px 6px rgb(0 0 0 / 0.35),
      inset 0 2px 4px rgb(255 255 255 / 0.25);
    color: #f6d9c4;
    transform: rotate(12deg);
  }
  .letter__seal :global(.logo) {
    fill: currentColor;
    opacity: 0.85;
  }
  .letter__seal :global(.logo *) {
    fill: currentColor;
  }
  .letter__to {
    margin: 0;
    font-family: 'Permanent Marker', var(--font-display);
    font-size: var(--step-1);
    color: #7a3fd1;
  }
  .letter__address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 2px dashed rgb(120 84 40 / 0.35);
  }
  .letter__email {
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    font-weight: 700;
    color: #2b1d10;
    text-decoration: underline;
    text-decoration-color: rgb(122 63 209 / 0.4);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }
  .letter__email:hover {
    color: #5b2fc4;
    text-decoration-color: currentColor;
  }
  .letter__copy {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 2px solid #2b1d10;
    border-radius: 999px;
    background: none;
    color: #2b1d10;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .letter__copy:hover {
    background: #2b1d10;
    color: #f8eed8;
  }
  .letter__copy.is-copied {
    border-color: #13723f;
    color: #13723f;
    background: none;
  }
  .letter__ps {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.6;
    color: #4a3520;
  }
  .letter__ps li {
    margin: 0 !important;
  }
  .letter__tag {
    font-family: 'Permanent Marker', var(--font-display);
    color: #7a3fd1;
  }
  .letter__ps a {
    color: #5b2fc4;
    font-weight: 700;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .letter__ps a:hover {
    color: #3f1a99;
  }
  .letter a:focus-visible,
  .letter__copy:focus-visible {
    outline: 3px solid #b25d00;
    outline-offset: 3px;
  }
  .letter__sign {
    justify-self: end;
    margin: 0;
    font-family: 'Permanent Marker', var(--font-display);
    font-size: var(--step-2);
    color: #2b1d10;
    transform: rotate(-4deg);
  }
  @media (min-width: 900px) {
    .mail__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .letter {
      transform: none;
    }
  }
</style>

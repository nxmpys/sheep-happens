---
/**
 * Second screen of the home page, sliding over the hero: why this guide exists,
 * in the author's words, over the Mage library, with the launch countdown and
 * the grimoire (three ways in, and the button to the guide). This markup is a
 * plain section; scripts/welcome-scene.ts turns it into a scene told by the
 * scroll wherever it can. On phones the book comes first and the text after.
 * Always dark, whatever the theme; Fraunces and Nunito, like the about page.
 */
import '@fontsource/permanent-marker';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/nunito/wght.css';
import LaunchCountdown from '../guide/LaunchCountdown.astro';
import MageGuideCTA from '../about/MageGuideCTA.astro';
import StoryArt from '../about/StoryArt.astro';
import { STORY_COPY } from '../about/story-copy';
import { href } from '../../i18n/locale';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
  /** Launch instant in UTC, for the countdown over the grimoire. */
  launchAt?: string | undefined;
}

const { locale, launchAt } = Astro.props;
const copy = STORY_COPY[locale].guide;
// Left %, seconds, size px: a little dust in the light of the library.
const motes = [
  [8, 23, 3], [17, 31, 2], [26, 27, 4], [35, 36, 2], [44, 25, 3], [52, 33, 2], [58, 21, 4], [64, 29, 3],
  [70, 24, 5], [75, 34, 2], [80, 22, 4], [85, 30, 3], [90, 26, 2], [95, 35, 3],
] as const;
---

<section class="welcome" data-welcome-scene data-no-spell-links aria-labelledby="welcome-title">
  <div class="welcome__pin" data-welcome-pin>
    <div class="welcome__backdrop" aria-hidden="true"><StoryArt name="grimoire" locale={locale} /></div>
    <div class="welcome__shade" aria-hidden="true"></div>
    <div class="welcome__light" aria-hidden="true"></div>
    <div class="welcome__dust" aria-hidden="true">
      {motes.map(([left, time, size], i) => <span style={`left: ${left}%; width: ${size}px; height: ${size}px; animation-duration: ${time}s; animation-delay: -${i * 2.7}s`} />)}
    </div>
    <div class="welcome__inner">
      <div class="welcome__copy">
        <h2 class="welcome__title" id="welcome-title" data-welcome-title>{copy.title}</h2>
        {copy.body.map((text) => <p class="welcome__text" data-welcome-text>{text}</p>)}
        <p class="welcome__signature">
          — <a href={href('about', locale)}>{copy.signature}</a>
        </p>
      </div>
      <div class="welcome__aside">
        {launchAt && <LaunchCountdown at={launchAt} compact />}
        <MageGuideCTA locale={locale} copy={copy} />
      </div>
    </div>
  </div>
</section>

<script>
  import { startWelcomeScene } from '../../scripts/welcome-scene';

  for (const section of document.querySelectorAll<HTMLElement>('[data-welcome-scene]')) startWelcomeScene(section);
</script>

<style>
  /* Full width out of the page column; the body clips the overflow so no sideways scroll. */
  :global(body:has(.welcome)) {
    overflow-x: clip;
  }
  .welcome {
    --font-display: 'Fraunces Variable', 'Spectral', Georgia, serif;
    --font-body: 'Nunito Variable', 'Inter Variable', system-ui, sans-serif;
    --focus: #ffd56a;
    --p: 1;
    --intro: 0;
    --enter: 1;
    color-scheme: dark;
    position: relative;
    z-index: 1;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    border-radius: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) 0 0;
    box-shadow: 0 -30px 80px rgb(5 7 15 / 0.7);
    background: #05070f;
    color: #ecebf4;
    font-family: var(--font-body);
    font-variation-settings: 'SOFT' 100;
  }
  .welcome :global(:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .welcome__pin {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: clamp(5rem, 12vh, 8rem);
    overflow: clip;
    border-radius: inherit;
  }
  .welcome__backdrop {
    position: absolute;
    inset: 0;
    opacity: calc(0.2 + 0.62 * var(--p));
    transform: scale(calc(1.24 - 0.24 * var(--p)));
    transform-origin: 62% 50%;
  }
  /* Darker behind the text column, so the library stays a mood and not a distraction. */
  .welcome__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(5 7 15 / 0.92) 8%, rgb(5 7 15 / 0.62) 46%, rgb(5 7 15 / 0.08) 78%),
      linear-gradient(0deg, #05070f, transparent 24%);
  }
  /* The light of the book: grows as it turns, and flares when it opens. */
  .welcome__light {
    position: absolute;
    top: 50%;
    left: 74%;
    width: min(70rem, 90vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(185 139 255 / 0.5), rgb(120 90 255 / 0.2) 42%, transparent);
    opacity: calc(var(--enter) * 0.85);
    transform: scale(calc(0.6 + 0.4 * var(--enter)));
    pointer-events: none;
  }
  .welcome__light::after {
    content: '';
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 236 190 / 0.85), rgb(255 205 120 / 0.28) 45%, transparent);
    opacity: 0;
    transition:
      opacity 0.9s ease,
      transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
    transform: scale(0.5);
  }
  .welcome.is-open .welcome__light::after {
    opacity: 0.8;
    transform: scale(1.15);
  }
  .welcome__dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .welcome__dust span {
    position: absolute;
    bottom: -12px;
    border-radius: 50%;
    background: #ffe7b8;
    box-shadow: 0 0 8px 1px rgb(201 170 255 / 0.8);
    opacity: 0;
    animation: dust-rise linear infinite;
  }
  @keyframes dust-rise {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    12% {
      opacity: 0.75;
    }
    60% {
      transform: translate(26px, -60svh);
    }
    100% {
      transform: translate(-14px, -108svh);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .welcome__dust {
      display: none;
    }
  }
  /* Phones: countdown, book and button, then the text. */
  .welcome__inner {
    position: relative;
    display: grid;
    grid-template-areas: 'aside' 'copy';
    gap: var(--space-7);
    align-items: center;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .welcome__copy {
    grid-area: copy;
    display: grid;
    gap: var(--space-4);
    max-width: 36rem;
  }
  .welcome__title {
    max-width: 16ch;
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
    font-weight: 700;
    line-height: 1.02;
    color: #fff8ec;
  }
  .welcome__text {
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.7;
    color: #eeeaf8;
    text-shadow: 0 1px 14px rgb(5 7 15 / 0.8);
  }
  /* Before their turn the words wait dimmed, still readable to anyone who stops here. */
  .welcome :global(.welcome-word) {
    opacity: 0.3;
    transition: opacity 0.35s ease;
  }
  .welcome :global(.welcome-word.is-lit) {
    opacity: 1;
  }
  .welcome__signature {
    margin: var(--space-2) 0 0;
    font-family: 'Permanent Marker', var(--font-display);
    font-size: var(--step-1);
    color: #cfa6ff;
  }
  .welcome__signature a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .welcome__signature a:hover {
    color: #e4d8ff;
  }
  /* The countdown sits over the book, with room to breathe. */
  .welcome__aside {
    grid-area: aside;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    min-width: 0;
  }
  @media (min-width: 900px) {
    /* Wide screens: the text on the left, centred against the book on the right. */
    .welcome__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-areas: 'copy aside';
    }
  }

  /* ---- The scene: the section grows and its contents stay pinned while it passes ---- */
  .welcome.is-scene {
    height: 340svh;
  }
  .is-scene .welcome__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    padding-block: var(--header-h) 0;
  }
  .is-scene .welcome__title {
    font-size: clamp(2.2rem, 6.4svh, 3.75rem);
    transform-origin: 0 0;
    transform: translate(calc(var(--intro) * var(--title-x, 0px)), calc(var(--intro) * var(--title-y, 0px))) scale(calc(1 + var(--intro) * (var(--title-scale, 1) - 1)));
  }
  .is-scene .welcome__text {
    font-size: clamp(0.98rem, 2.1svh, 1.15rem);
    line-height: 1.62;
    opacity: calc(1 - var(--intro));
  }
  .is-scene .welcome__signature {
    opacity: calc((var(--p) - 0.6) * 12);
  }
  .is-scene .welcome__copy {
    gap: clamp(0.5rem, 1.6svh, 1rem);
  }
  /* The book comes up from below, turned away, and ends facing the reader. */
  .is-scene .welcome__aside {
    gap: clamp(0.75rem, 2svh, 1.5rem);
    opacity: min(1, calc(var(--enter) * 2.5));
    transform: translateY(calc((1 - var(--enter)) * 34svh)) perspective(1400px) rotateY(calc((1 - var(--enter)) * -42deg)) rotateZ(calc((1 - var(--enter)) * 7deg)) scale(calc(0.82 + 0.18 * var(--enter)));
  }
  .is-scene .welcome__aside :global(.grimoire__stage) {
    --page-w: min(270px, 20.5vw, 37svh);
  }
  .is-scene .welcome__aside :global(.grimoire) {
    gap: clamp(0.75rem, 2.4svh, 1.5rem);
  }
  /* Short of room between 900 and 1100 px: the open book may cover the end of the column, so narrow the words. */
  @media (max-width: 1100px) {
    .is-scene .welcome__copy {
      max-width: 27rem;
    }
  }

  /* Phones and short windows: no pin; the library stays in place behind the words. */
  .is-flow .welcome__backdrop {
    position: sticky;
    top: 0;
    inset-inline: 0;
    height: 100svh;
    margin-bottom: -100svh;
    opacity: 0.5;
    transform: none;
  }
  .welcome.is-flow .welcome__pin {
    display: block;
    padding-block: 0 clamp(4rem, 10vh, 6rem);
  }
  .is-flow .welcome__inner {
    padding-top: clamp(4rem, 10vh, 6rem);
  }
  .is-flow .welcome__light {
    top: 19rem;
    left: 50%;
    opacity: 0.7;
    transform: none;
  }
  .is-flow .welcome__shade {
    background: linear-gradient(0deg, rgb(5 7 15 / 0.82), rgb(5 7 15 / 0.45));
  }
</style>

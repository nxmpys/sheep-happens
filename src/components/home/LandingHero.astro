---
/**
 * First screen of the home page: one full-window picture from the Forever
 * cinematic, the launch countdown in its centre and the site name. The picture
 * stays pinned while the next section slides over it like a curtain. The words
 * are in the normal flow, so they rise at exactly the pace of that section, and
 * they fade out on reaching the top through CSS scroll timelines: no script runs
 * here, and browsers without them only miss the fade.
 */
import Icon from '../ui/Icon.astro';
import LaunchCountdown from '../guide/LaunchCountdown.astro';
import Signature from './Signature.astro';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
  /** The page title: this page's h1. */
  pageTitle: string;
  /** Launch instant in UTC, for the countdown. */
  launchAt?: string | undefined;
}

const { locale, pageTitle, launchAt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = 'Sheep Happens';
const alt = {
  es: 'Torres de una ciudad bajo un inmenso escudo de energía violeta, con el sol detrás',
  en: 'The towers of a city under a vast shield of violet energy, the sun behind them',
};
const more = { es: 'Sigue bajando', en: 'Keep scrolling' };
---

<section class="lhero" data-no-spell-links aria-labelledby="lhero-title">
  <div class="lhero__pin">
    <img
      class="lhero__image"
      src={`${base}home/hero.webp`}
      srcset={`${base}home/hero-1280.webp 1280w, ${base}home/hero.webp 2560w`}
      sizes="max(100vw, 240svh)"
      width="2560"
      height="1067"
      alt={alt[locale]}
      fetchpriority="high"
      decoding="async"
    />
    <div class="lhero__shade" aria-hidden="true"></div>
  </div>
  <div class="lhero__front">
    {launchAt && <div class="lhero__launch"><LaunchCountdown at={launchAt} compact /></div>}
    <div class="lhero__words">
      <h1 class="lhero__kicker" id="lhero-title">{pageTitle}</h1>
      <p class="lhero__name" aria-label={name}>
        {
          name.split(' ').map((word, w) => (
            <span class="lhero__word" aria-hidden="true">
              {word.split('').map((letter, i) => (
                <span class="lhero__letter" style={`--i: ${w * 6 + i}`}>
                  {letter}
                </span>
              ))}
            </span>
          ))
        }
      </p>
      <div class="lhero__signature"><Signature /></div>
    </div>
    <a class="lhero__more" href="#questions">
      {more[locale]}
      <Icon name="chevronDown" size={16} strokeWidth={2} />
    </a>
  </div>
</section>

<style>
  /* Full width out of the page column; the body clips the overflow so no sideways scroll. */
  :global(body:has(.lhero)) {
    overflow-x: clip;
  }
  /* Two windows tall so the picture stays pinned for one, and the next section starts after the first. */
  .lhero {
    --focus: #ffd56a;
    color-scheme: dark;
    position: relative;
    width: 100vw;
    height: 200svh;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--header-h));
    margin-bottom: -100svh;
    color: #fff;
  }
  .lhero__pin {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: hidden;
    background: #05070f;
  }
  .lhero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 58% 42%;
  }
  .lhero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(5 7 15 / 0.78), rgb(5 7 15 / 0.45) 9%, transparent 24%),
      linear-gradient(0deg, rgb(5 7 15 / 0.92), rgb(5 7 15 / 0.3) 38%, transparent 62%);
  }
  /* Equal rows above and below keep the countdown in the very centre of the window. */
  .lhero__front {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    height: 100svh;
    pointer-events: none;
  }
  .lhero__launch {
    grid-row: 2;
    display: grid;
    justify-items: center;
    padding-inline: var(--gutter);
  }
  .lhero__words {
    grid-row: 3;
    align-self: end;
    position: relative;
    display: grid;
    gap: clamp(0.25rem, 1vw, 0.75rem);
    padding: 0 var(--gutter) clamp(4.5rem, 11svh, 7rem);
    text-align: center;
  }
  /* Signed under the end of the name, rising a little like a real signature. */
  .lhero__signature {
    position: absolute;
    right: calc(var(--gutter) + 2vw);
    bottom: clamp(1rem, 3svh, 2.25rem);
    width: clamp(10rem, 19vw, 22rem);
    rotate: -6deg;
  }
  /* Too short for the centre (a phone on its side): countdown and name stack at the bottom. */
  @media (max-height: 520px) {
    .lhero__front {
      grid-template-rows: 1fr auto auto;
      row-gap: var(--space-3);
    }
  }
  .lhero__kicker {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 0.65rem + 0.3vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.5;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.86);
  }
  .lhero__name {
    margin: 0;
    font-family: 'Cinzel Decorative', var(--font-display);
    font-size: clamp(2.9rem, 10.6vw, 12rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.005em;
    text-shadow: 0 2px 40px rgb(5 7 15 / 0.55);
  }
  .lhero__word {
    display: inline-block;
    white-space: nowrap;
  }
  .lhero__word + .lhero__word {
    margin-left: 0.28em;
  }
  .lhero__letter {
    display: inline-block;
  }
  .lhero__more {
    position: absolute;
    bottom: clamp(1rem, 3svh, 1.75rem);
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.78);
    font-size: 0.8125rem;
    text-decoration: none;
    pointer-events: auto;
  }
  .lhero__more:hover {
    color: #fff;
  }
  @media (max-width: 560px) {
    .lhero__word {
      display: block;
    }
    .lhero__word + .lhero__word {
      margin-left: 0;
    }
    .lhero__name {
      font-size: clamp(3rem, 17vw, 5rem);
    }
    /* The signature takes the room over «keep scrolling». */
    .lhero__words {
      padding-bottom: 6.5rem;
    }
    .lhero__signature {
      right: var(--gutter);
      bottom: 2.75rem;
      width: 9rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The letters settle in on arrival; they are never fully hidden. */
    .lhero__letter {
      animation: letter-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i) * 28ms);
    }
    .lhero__more :global(svg) {
      animation: more-nudge 2.4s ease-in-out infinite;
    }
    @supports (animation-timeline: scroll()) {
      .lhero__image {
        animation: lhero-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100svh;
      }
      .lhero__more {
        animation: lhero-out linear both;
        animation-timeline: scroll(root);
        animation-range: 0 20svh;
      }
    }
    /* Each block fades as it goes under the header, whatever its height. */
    @supports (animation-timeline: view()) {
      .lhero__launch,
      .lhero__words {
        animation: lhero-out linear both;
        animation-timeline: view(block var(--header-h) 0px);
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes letter-in {
    from {
      opacity: 0.25;
      transform: translateY(0.14em);
    }
  }
  @keyframes more-nudge {
    50% {
      transform: translateY(4px);
    }
  }
  @keyframes lhero-zoom {
    to {
      transform: scale(1.12);
    }
  }
  @keyframes lhero-out {
    to {
      opacity: 0;
    }
  }
</style>

---
/**
 * First screen of the home page: one full-window picture from the Forever
 * cinematic and the site name. It stays pinned while the next section slides
 * over it like a curtain, and it drifts with the scroll through CSS scroll
 * timelines, so no script runs here and browsers without them get it still.
 */
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/routes';

interface Props {
  locale: Locale;
  /** The page title: this page's h1. */
  pageTitle: string;
}

const { locale, pageTitle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const name = 'Sheep Happens';
const alt = {
  es: 'Torres de una ciudad bajo un inmenso escudo de energía violeta, con el sol detrás',
  en: 'The towers of a city under a vast shield of violet energy, the sun behind them',
};
const more = { es: 'Sigue bajando', en: 'Keep scrolling' };
---

<section class="lhero" data-no-spell-links aria-labelledby="lhero-title">
  <img
    class="lhero__image"
    src={`${base}home/hero.webp`}
    srcset={`${base}home/hero-1280.webp 1280w, ${base}home/hero.webp 2560w`}
    sizes="max(100vw, 240svh)"
    width="2560"
    height="1067"
    alt={alt[locale]}
    fetchpriority="high"
    decoding="async"
  />
  <div class="lhero__shade" aria-hidden="true"></div>
  <div class="lhero__words">
    <h1 class="lhero__kicker" id="lhero-title">{pageTitle}</h1>
    <p class="lhero__name" aria-label={name}>
      {
        name.split(' ').map((word, w) => (
          <span class="lhero__word" aria-hidden="true">
            {word.split('').map((letter, i) => (
              <span class="lhero__letter" style={`--i: ${w * 6 + i}`}>
                {letter}
              </span>
            ))}
          </span>
        ))
      }
    </p>
  </div>
  <a class="lhero__more" href="#welcome-title">
    {more[locale]}
    <Icon name="chevronDown" size={16} strokeWidth={2} />
  </a>
</section>

<style>
  .lhero {
    --focus: #ffd56a;
    color-scheme: dark;
    position: sticky;
    top: 0;
    z-index: 0;
    display: grid;
    align-content: end;
    width: 100vw;
    height: 100svh;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--header-h));
    overflow: hidden;
    background: #05070f;
    color: #fff;
  }
  .lhero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 58% 42%;
  }
  .lhero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(5 7 15 / 0.78), rgb(5 7 15 / 0.45) 9%, transparent 24%),
      linear-gradient(0deg, rgb(5 7 15 / 0.92), rgb(5 7 15 / 0.3) 38%, transparent 62%);
  }
  .lhero__words {
    position: relative;
    display: grid;
    gap: clamp(0.25rem, 1vw, 0.75rem);
    padding: 0 var(--gutter) clamp(4.5rem, 11svh, 7rem);
    text-align: center;
  }
  .lhero__kicker {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 0.65rem + 0.3vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.2em;
    line-height: 1.5;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.86);
  }
  .lhero__name {
    margin: 0;
    font-family: 'Cinzel Decorative', var(--font-display);
    font-size: clamp(2.9rem, 10.6vw, 12rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.005em;
    text-shadow: 0 2px 40px rgb(5 7 15 / 0.55);
  }
  .lhero__word {
    display: inline-block;
    white-space: nowrap;
  }
  .lhero__word + .lhero__word {
    margin-left: 0.28em;
  }
  .lhero__letter {
    display: inline-block;
  }
  .lhero__more {
    position: absolute;
    bottom: clamp(1rem, 3svh, 1.75rem);
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.78);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  .lhero__more:hover {
    color: #fff;
  }
  @media (max-width: 560px) {
    .lhero__word {
      display: block;
    }
    .lhero__word + .lhero__word {
      margin-left: 0;
    }
    .lhero__name {
      font-size: clamp(3rem, 17vw, 5rem);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The letters settle in on arrival; they are never fully hidden. */
    .lhero__letter {
      animation: letter-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i) * 28ms);
    }
    .lhero__more :global(svg) {
      animation: more-nudge 2.4s ease-in-out infinite;
    }
    @supports (animation-timeline: scroll()) {
      .lhero__image {
        animation: lhero-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100svh;
      }
      .lhero__words,
      .lhero__more {
        animation: lhero-leave linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70svh;
      }
    }
  }
  @keyframes letter-in {
    from {
      opacity: 0.25;
      transform: translateY(0.14em);
    }
  }
  @keyframes more-nudge {
    50% {
      transform: translateY(4px);
    }
  }
  @keyframes lhero-zoom {
    to {
      transform: scale(1.12);
    }
  }
  @keyframes lhero-leave {
    to {
      opacity: 0;
      transform: translateY(-3rem);
    }
  }
</style>

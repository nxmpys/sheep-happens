---
/**
 * Quick recommendations on the professions page: one card per goal with the
 * pair to pick, why, the main advantage, what you give up, who it suits and an
 * alternative. Data in profession-picks.json; each card's id is "pick-<goal>".
 */
import { getLocale } from '../../i18n/locale';
import { tp } from '../../i18n/professions';
import { getProfession, picks } from '../../lib/data';
import { professionAnchor } from '../../lib/professions';

const locale = getLocale(Astro);
const and = locale === 'es' ? ' y ' : ' and ';
const pair = (ids: readonly string[]) => ids.map(getProfession);
---

<div class="picks">
  {
    picks.map((pick, index) => (
      <article class:list={['pick', { 'pick--featured': index === 0 }]} id={`pick-${pick.id}`} aria-labelledby={`pick-${pick.id}-title`}>
        <h3 class="pick__goal" id={`pick-${pick.id}-title`}>
          {pick.goal[locale]}
        </h3>
        <p class="pick__pair">
          <span class="visually-hidden">{tp(locale, 'pick.pair')}: </span>
          {pair(pick.professions).map((profession, i) => (
            <>
              {i > 0 && (
                <>
                  <span class="pick__plus" aria-hidden="true">
                    +
                  </span>
                  <span class="visually-hidden">{and}</span>
                </>
              )}
              <a href={`#${professionAnchor(profession, locale)}`}>{profession.name[locale]}</a>
            </>
          ))}
        </p>
        <p class="pick__why">{pick.why[locale]}</p>
        <dl class="pick__facts">
          <div>
            <dt>{tp(locale, 'pick.advantage')}</dt>
            <dd>{pick.advantage[locale]}</dd>
          </div>
          <div>
            <dt>{tp(locale, 'pick.sacrifice')}</dt>
            <dd>{pick.sacrifice[locale]}</dd>
          </div>
          <div>
            <dt>{tp(locale, 'pick.profile')}</dt>
            <dd>{pick.profile[locale]}</dd>
          </div>
        </dl>
        {pick.alternative && (
          <p class="pick__alt">
            <span class="pick__label">{tp(locale, 'pick.alternative')}:</span>{' '}
            {`${pair(pick.alternative.professions)
              .map((profession) => profession.name[locale])
              .join(' + ')}. ${pick.alternative.when[locale]}`}
          </p>
        )}
      </article>
    ))
  }
</div>

<style>
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    align-items: start;
  }
  .pick {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-top: 4px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .pick--featured {
    border-top-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .pick:target {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .pick p,
  .pick dl {
    margin: 0;
  }
  .pick__goal {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pick--featured .pick__goal {
    color: var(--accent);
  }
  .pick__pair {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
  }
  .pick__pair a {
    color: var(--text);
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
  }
  .pick__pair a:hover {
    color: var(--link-hover);
  }
  .pick__plus {
    color: var(--text-subtle);
    font-weight: 400;
  }
  .pick__why {
    font-size: var(--step--1);
  }
  .pick__facts {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .pick__facts dt,
  .pick__label {
    font-weight: 700;
    color: var(--text-muted);
  }
  .pick__facts dd {
    margin: 0;
  }
  .pick__alt {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    font-size: var(--step--1);
  }
</style>

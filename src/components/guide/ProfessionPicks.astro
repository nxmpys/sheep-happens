---
/**
 * The short answer on the professions page: a tab per goal with the pair to pick
 * as two big icons and its main advantage. Why, what you give up, who it suits
 * and an alternative stay folded. Data in profession-picks.json; each panel's id
 * is "pick-<goal>".
 */
import GameIcon from '../learn/GameIcon.astro';
import '../../styles/learn.css';
import { getLocale } from '../../i18n/locale';
import { tp } from '../../i18n/professions';
import { getProfession, picks } from '../../lib/data';
import { PROFESSION_ICONS, professionAnchor } from '../../lib/professions';

const locale = getLocale(Astro);
const es = locale === 'es';
const pair = (ids: readonly string[]) => ids.map(getProfession);
---

<pick-panel class="picks" role="group" aria-label={tp(locale, 'pick.pair')} data-no-spell-links>
  {
    picks.map((pick) => (
      <div class="pick">
        <button type="button" class="pick__button" data-pick={pick.id}>
          <span class="picks__mini">
            {pick.professions.map((id) => (
              <GameIcon icon={PROFESSION_ICONS[id]} size={24} plain />
            ))}
          </span>
          <span>{pick.goal[locale]}</span>
        </button>
        <article class="pick__panel" data-panel={pick.id} id={`pick-${pick.id}`}>
          <p class="picks__pair">
            <span class="visually-hidden">{tp(locale, 'pick.pair')}: </span>
            {pair(pick.professions).map((profession, i) => (
              <>
                {i > 0 && (
                  <span class="picks__plus" aria-hidden="true">
                    +
                  </span>
                )}
                <a class="picks__prof" href={`#${professionAnchor(profession, locale)}`}>
                  <GameIcon icon={PROFESSION_ICONS[profession.id]} size={56} />
                  <span>{profession.name[locale]}</span>
                </a>
              </>
            ))}
          </p>
          <p class="picks__advantage">{pick.advantage[locale]}</p>
          <details class="picks__more">
            <summary>{es ? 'Por qué, y lo que sacrificas' : 'Why, and what you give up'}</summary>
            <p>{pick.why[locale]}</p>
            <dl class="picks__facts">
              <div>
                <dt>{tp(locale, 'pick.sacrifice')}</dt>
                <dd>{pick.sacrifice[locale]}</dd>
              </div>
              <div>
                <dt>{tp(locale, 'pick.profile')}</dt>
                <dd>{pick.profile[locale]}</dd>
              </div>
              {pick.alternative && (
                <div>
                  <dt>{tp(locale, 'pick.alternative')}</dt>
                  <dd>
                    {`${pair(pick.alternative.professions)
                      .map((profession) => profession.name[locale])
                      .join(' + ')}. ${pick.alternative.when[locale]}`}
                  </dd>
                </div>
              )}
            </dl>
          </details>
        </article>
      </div>
    ))
  }
</pick-panel>

<script>
  import '../../scripts/pick-panel';
</script>

<style>
  /* Six goals: buttons with room for two icons and a label. */
  .picks :global(.pick__button) {
    flex-basis: 13rem;
  }
  .picks__mini {
    display: flex;
    flex: none;
    gap: 2px;
  }
  .pick__panel p,
  .pick__panel dl {
    margin: 0;
  }
  .picks__pair {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }
  .picks__prof {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    text-decoration: none;
  }
  .picks__prof:hover {
    color: var(--link-hover);
  }
  .picks__plus {
    color: var(--text-subtle);
    font-size: var(--step-2);
  }
  .picks__advantage {
    font-weight: 600;
  }
  .picks__more {
    font-size: var(--step--1);
  }
  .picks__more summary {
    color: var(--link);
    font-weight: 600;
    cursor: pointer;
  }
  .picks__more > * + * {
    margin-top: var(--space-2) !important;
  }
  .picks__facts {
    display: grid;
    gap: var(--space-2);
  }
  .picks__facts dt {
    font-weight: 700;
    color: var(--text-muted);
  }
  .picks__facts dd {
    margin: 0;
  }
</style>

---
/**
 * The builds index, generated from builds.json, so a new build needs no edit
 * here: one block per content (leveling 1-60, PvP, dungeons, raid) with the
 * builds that exist for it, the recommended one labelled. A block with builds
 * is a link to its content page (/builds/<use>/), where each build shows its
 * three trees; a block without builds says so and links nowhere. There is no
 * content × tree matrix: a tree without a build for a content is not listed.
 */
import Icon from '../ui/Icon.astro';
import { SPEC_LABELS, USE_TITLES, tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';
import { buildRole, type BuildRole } from '../../lib/build-roles';
import { buildIcon, contentPath } from '../../lib/build-routes';
import { builds } from '../../lib/data';
import { BUILD_USES, type BuildUse } from '../../lib/schemas';

const locale = getLocale(Astro);
const ROLE_ORDER: Record<BuildRole, number> = { recommended: 0, viable: 1, 'not-recommended': 2 };
const forUse = (use: BuildUse) =>
  builds.filter((b) => b.uses.includes(use)).sort((a, b) => ROLE_ORDER[buildRole(a, use)] - ROLE_ORDER[buildRole(b, use)]);
---

<ul class="uses">
  {
    BUILD_USES.map((use) => {
      const list = forUse(use);
      return (
        <li class:list={['use', 'has-glow', { 'use--empty': list.length === 0 }]} id={`uses-${use}`}>
          {list.length > 0 && <span class="arcane-glow" aria-hidden="true" />}
          <p class="use__title">
            {list.length > 0 ? (
              <a class="use__link" href={contentPath(use, locale, { base: import.meta.env.BASE_URL })}>
                {USE_TITLES[locale][use]}
              </a>
            ) : (
              USE_TITLES[locale][use]
            )}
            {list.length > 0 && <Icon name="arrowRight" size={18} class="use__arrow" />}
          </p>
          {list.length > 0 ? (
            <ul class="use__list">
              {list.map((build) => {
                const role = buildRole(build, use);
                return (
                  <li class={`use__build school-${build.spec}`}>
                    <Icon name={buildIcon(build)} size={22} class="use__icon" />
                    <span class="use__text">
                      <span class="use__name">{build.name[locale]}</span>
                      <span class="use__meta">
                        {SPEC_LABELS[locale][build.spec]}
                        {role !== 'viable' && <span class:list={['use__role', `use__role--${role}`]}>{tb(locale, `build.${role}`)}</span>}
                        {build.status !== 'tested' && <span class="use__role use__role--untested">{tb(locale, 'build.untested')}</span>}
                      </span>
                      <span class="use__desc">{build.tagline[locale]}</span>
                    </span>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="use__none">{tb(locale, 'index.none')}</p>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .uses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .use {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .use + .use {
    margin-top: 0;
  }
  .use:not(.use--empty):hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .use--empty {
    background: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .use {
      transition: none;
    }
    .use:not(.use--empty):hover {
      transform: none;
    }
  }
  .use__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .use--empty .use__title {
    color: var(--text-muted);
  }
  .use__link {
    color: var(--text);
    text-decoration: none;
  }
  /* The whole block is the link. */
  .use__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-lg);
  }
  .use__link:focus-visible {
    outline: none;
  }
  .use:has(.use__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .use__title :global(.use__arrow) {
    color: var(--accent);
  }
  .use__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .use__build {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-left: 4px solid var(--school);
    border-radius: var(--radius-lg);
    background: var(--surface-2, var(--surface-1));
  }
  .use__build :global(.use__icon) {
    flex-shrink: 0;
    margin-top: 0.1em;
    color: var(--school);
  }
  .use__text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }
  .use__name {
    font-weight: 700;
  }
  .use__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .use__role {
    padding: 0 0.55em;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .use__role--recommended {
    background: var(--school);
    color: var(--accent-contrast);
  }
  .use__role--not-recommended {
    border: 1px dashed var(--border-strong);
  }
  /* Not played yet: shown until the build's status is «tested». */
  .use__role--untested {
    border: 1px solid color-mix(in srgb, var(--warning) 60%, transparent);
    color: var(--warning);
  }
  .use__desc {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
  }
  .use__none {
    margin: 0;
    padding: var(--space-3);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>

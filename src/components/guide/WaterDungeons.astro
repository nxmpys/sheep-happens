---
/**
 * Dungeons already open by a level, Classic against Forever (chart), and the
 * ones up to level 30 with the quest experience of the new ones (table).
 */
import Table from '../ui/Table.astro';
import VerifyTag from './VerifyTag.astro';
import { getLocale } from '../../i18n/locale';
import { mageWater } from '../../lib/data';
import { dungeonsBy, formatNumber, formatPercent } from '../../lib/water';

interface Props {
  view: 'chart' | 'table';
}

const { view } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const tiers = [20, 30, 40, 50, 60].map((level) => dungeonsBy(mageWater.dungeons, level));
const scale = Math.max(...tiers.map((tier) => tier.forever));
const early = mageWater.dungeons.filter((dungeon) => dungeon.start <= 30);
const summary = es
  ? tiers.map((t) => `hasta el nivel ${t.level}, ${t.classic} en Classic y ${t.forever} en Forever`).join('; ')
  : tiers.map((t) => `by level ${t.level}, ${t.classic} in Classic and ${t.forever} in Forever`).join('; ');
---

{
  view === 'chart' && (
    <figure class="chart">
      <figcaption class="chart__title">{es ? 'Mazmorras que ya han empezado a cada nivel' : 'Dungeons already started by each level'}</figcaption>
      <p class="legend">
        <span class="legend__item"><span class="swatch swatch--classic" aria-hidden="true" />Classic</span>
        <span class="legend__item"><span class="swatch swatch--forever" aria-hidden="true" />Forever</span>
      </p>
      <ul class="tiers">
        {tiers.map((tier) => (
          <li class="tier">
            <span class="tier__level">{es ? `Hasta nivel ${tier.level}` : `By level ${tier.level}`}</span>
            <span class="tier__rows">
              <span class="row" title={`Classic: ${tier.classic}`}>
                <span class="row__name">Classic</span>
                <span class="row__track" aria-hidden="true"><span class="row__fill row__fill--classic" style={`width:${(tier.classic / scale) * 100}%`} /></span>
                <span class="row__value">{tier.classic}</span>
              </span>
              <span class="row" title={`Forever: ${tier.forever}`}>
                <span class="row__name">Forever</span>
                <span class="row__track" aria-hidden="true"><span class="row__fill row__fill--forever" style={`width:${(tier.forever / scale) * 100}%`} /></span>
                <span class="row__value">{tier.forever} <span class="row__growth">+{formatPercent(tier.growth, locale)}</span></span>
              </span>
            </span>
          </li>
        ))}
      </ul>
      <p class="chart__desc">{es ? 'En números: ' : 'In numbers: '}{summary}.</p>
    </figure>
  )
}

{
  view === 'table' && (
    <Table>
      <caption class="visually-hidden">{es ? 'Mazmorras que empiezan hasta el nivel 30 y experiencia de las misiones de las nuevas' : 'Dungeons starting by level 30 and the quest experience of the new ones'}</caption>
      <thead>
        <tr>
          <th scope="col">{es ? 'Mazmorra' : 'Dungeon'}</th>
          <th scope="col">{es ? 'Niveles' : 'Levels'}</th>
          <th scope="col">{es ? 'Origen' : 'From'}</th>
          <th scope="col">{es ? 'Misiones, Alianza' : 'Quests, Alliance'}</th>
          <th scope="col">{es ? 'Misiones, Horda' : 'Quests, Horde'}</th>
          <th scope="col">{es ? 'Niveles que dan (A / H)' : 'Levels they give (A / H)'}</th>
        </tr>
      </thead>
      <tbody>
        {early.map((dungeon) => (
          <tr>
            <th scope="row">{dungeon.name[locale]}</th>
            <td class="nowrap">{dungeon.start}–{dungeon.end} {dungeon.todo && <VerifyTag />}</td>
            <td>{dungeon.isNew ? <strong>{es ? 'Nueva' : 'New'}</strong> : 'Classic'}</td>
            <td>{dungeon.quests ? `${formatNumber(dungeon.quests.alliance, locale)} XP` : '—'}</td>
            <td>{dungeon.quests ? `${formatNumber(dungeon.quests.horde, locale)} XP` : '—'}</td>
            <td class="nowrap">{dungeon.quests ? (es ? dungeon.quests.levels : dungeon.quests.levelsEn) : '—'}</td>
          </tr>
        ))}
      </tbody>
    </Table>
  )
}

<style>
  .chart {
    /* The site's Classic gold and Forever violet, stepped to stay apart as chart fills. */
    --chart-classic: light-dark(#946c00, #b88912);
    --chart-forever: light-dark(#6b3fd6, #9474f5);
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .chart__title {
    font-weight: 700;
  }
  .chart__desc {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .legend {
    display: flex;
    gap: var(--space-4);
    font-size: var(--step--1);
  }
  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .swatch--classic {
    background: var(--chart-classic);
  }
  .swatch--forever {
    background: var(--chart-forever);
  }
  .tiers {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tier {
    display: grid;
    gap: var(--space-1);
  }
  .tier__level {
    font-size: var(--step--1);
    font-weight: 650;
  }
  .tier__rows {
    display: grid;
    gap: 2px;
  }
  .row {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr) 5.5rem;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  .row__name {
    color: var(--text-muted);
  }
  .row__track {
    display: block;
    height: 10px;
  }
  .row__fill {
    display: block;
    height: 100%;
    border-radius: 0 4px 4px 0;
  }
  .row__fill--classic {
    background: var(--chart-classic);
  }
  .row__fill--forever {
    background: var(--chart-forever);
  }
  .row__value {
    font-weight: 700;
  }
  .row__growth {
    font-weight: 400;
    color: var(--text-muted);
  }
  .nowrap {
    white-space: nowrap;
  }
</style>

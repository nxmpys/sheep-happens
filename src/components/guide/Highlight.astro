---
/**
 * One headline change, as a picture card inside <Highlights>. The whole card
 * links to the change. The text stays in MDX, so bold spell names keep their
 * tooltips; `featured` spans two columns.
 */
import Icon from '../ui/Icon.astro';
import { getLocale, href } from '../../i18n/locale';
import type { PageId } from '../../i18n/routes';

interface Props {
  school: 'arcane' | 'fire' | 'frost' | 'frostfire';
  /** File in public/home/ behind the card. */
  image: string;
  /** Short line above the text, e.g. "Escarcha · talentos nuevos". */
  label: string;
  to: PageId;
  hash?: string;
  /** Raw query string without "?" (language-neutral filter ids). */
  query?: string;
  /** Link text at the bottom of the card. */
  cta: string;
  featured?: boolean;
}

const { school, image, label, to, hash, query, cta, featured = false } = Astro.props;
const locale = getLocale(Astro);
const url = `${href(to, locale)}${query ? `?${query}` : ''}${hash ? `#${hash}` : ''}`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<li class:list={['highlight', `school-${school === 'frostfire' ? 'baseline' : school}`, { 'highlight--frostfire': school === 'frostfire', 'highlight--featured': featured }]}>
  <img class="highlight__picture" src={`${base}home/${image}.webp`} alt="" width="900" height="375" loading="lazy" decoding="async" />
  <p class="highlight__label" data-no-spell-links>
    <span class="highlight__icon">
      <Icon name={school} size={featured ? 26 : 20} strokeWidth={1.6} />
    </span>
    <span>{label}</span>
  </p>
  <div class="highlight__body">
    <slot />
  </div>
  <a class="highlight__link" href={url}>
    {cta}
    <Icon name="arrowRight" size={16} />
  </a>
</li>

<style>
  .highlight {
    color-scheme: dark;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-3);
    min-height: clamp(22rem, 46svh, 28rem);
    margin: 0;
    padding: var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-lg);
    background: #05070f;
    color: #f4f5fb;
    transition: border-color 0.25s;
  }
  .highlight:hover {
    border-color: var(--school);
  }
  .highlight:has(.highlight__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .highlight__picture {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 118%;
    max-width: none;
    object-fit: cover;
    transition: scale 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .highlight:hover .highlight__picture {
    scale: 1.05;
  }
  /* Dark enough under the words whatever the picture does. */
  .highlight::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, #05070f 22%, rgb(5 7 15 / 0.78) 50%, rgb(5 7 15 / 0.08) 86%);
    pointer-events: none;
  }
  /* The picture drifts inside its frame as the card crosses the screen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .highlight__picture {
        animation: highlight-drift linear both;
        animation-timeline: view();
      }
    }
  }
  @keyframes highlight-drift {
    from {
      transform: translateY(-15%);
    }
    to {
      transform: translateY(0);
    }
  }
  /* Two columns only when the grid has at least two (see Highlights.astro). */
  @container highlights (min-width: 41rem) {
    .highlight--featured {
      grid-column: span 2;
    }
    .highlight--featured .highlight__body {
      font-size: var(--step-1);
    }
  }
  /* The text lets clicks through to the card's link; spell names keep their tooltips. */
  .highlight__label,
  .highlight__body {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .highlight__body :global(strong),
  .highlight__body :global(.spell-ref) {
    pointer-events: auto;
  }
  .highlight__label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--school);
  }
  .highlight__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--school) 45%, transparent);
    background: rgb(5 7 15 / 0.72);
  }
  .highlight--featured .highlight__icon {
    width: 3rem;
    height: 3rem;
  }
  .highlight--frostfire .highlight__icon {
    color: var(--fire);
    border-color: color-mix(in srgb, var(--fire) 45%, transparent);
  }
  .highlight__body {
    line-height: 1.55;
  }
  .highlight__body > :global(*) {
    margin: 0;
  }
  .highlight__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    align-self: flex-start;
    color: #fff;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .highlight__link:focus-visible {
    outline: none;
  }
  /* The whole card is the link. */
  .highlight__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .highlight__link :global(.icon) {
    transition: transform 0.15s ease;
  }
  .highlight:hover .highlight__link :global(.icon) {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .highlight__picture,
    .highlight__link :global(.icon) {
      transition: none;
    }
  }
</style>

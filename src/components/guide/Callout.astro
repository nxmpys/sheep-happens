---
import Icon from '../ui/Icon.astro';

interface Props {
  variant?: 'info' | 'tip' | 'warning' | 'arcane';
  title?: string;
}

const { variant = 'info', title } = Astro.props;
const icon = variant === 'warning' ? 'warning' : variant === 'tip' ? 'analysis' : 'info';
---

<aside class:list={['callout', `callout--${variant}`]}>
  {
    variant === 'arcane' ? (
      <span class="callout__sigil" aria-hidden="true">
        !
      </span>
    ) : (
      <Icon name={icon} size={20} class="callout__icon" />
    )
  }
  <div class="callout__body">
    {title && <p class="callout__title">{title}</p>}
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    border-left: 4px solid var(--callout-color);
    background: var(--surface-1);
  }
  .callout--info {
    --callout-color: var(--status-reported);
  }
  .callout--tip {
    --callout-color: var(--status-analysis);
  }
  .callout--warning {
    --callout-color: var(--warning);
    background: var(--warning-soft);
  }
  .callout :global(.callout__icon) {
    color: var(--callout-color);
    margin-top: 0.2em;
  }
  .callout__body {
    min-width: 0;
  }
  .callout__body > :global(* + *) {
    margin-top: var(--space-2);
  }
  .callout__title {
    font-weight: 700;
  }
  /* A warning with a glowing sigil, for advice that frames a whole page. */
  .callout--arcane {
    --callout-color: var(--arcane);
    position: relative;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--arcane) 40%, transparent);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 2.75rem 2.75rem, color-mix(in srgb, var(--arcane) 22%, transparent), transparent 14rem),
      linear-gradient(135deg, var(--arcane-soft), var(--surface-1) 70%);
    box-shadow: 0 0 24px color-mix(in srgb, var(--arcane) 14%, transparent);
  }
  .callout--arcane .callout__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--arcane);
  }
  .callout__sigil {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--arcane);
    border-radius: 999px;
    background: var(--surface-1);
    box-shadow: 0 0 16px color-mix(in srgb, var(--arcane) 50%, transparent);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--arcane);
  }
  /* A dashed rune ring turning slowly around the sigil. */
  .callout__sigil::before {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px dashed color-mix(in srgb, var(--arcane) 60%, transparent);
    border-radius: 999px;
    animation: sigil-turn 24s linear infinite;
  }
  @keyframes sigil-turn {
    to {
      transform: rotate(1turn);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .callout__sigil::before {
      animation: none;
    }
  }
</style>

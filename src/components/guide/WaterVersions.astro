---
/** The dates and builds behind the water page: a notice at the top and the list at the end. */
import Callout from './Callout.astro';
import { getLocale } from '../../i18n/locale';
import { mageWater } from '../../lib/data';

interface Props {
  view: 'notice' | 'versions';
}

const { view } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const { builds, reviewed } = mageWater;
const date = new Date(`${reviewed}T00:00:00Z`).toLocaleDateString(es ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

{
  view === 'notice' && (
    <Callout variant="warning" title={es ? 'Son datos de la beta' : 'This is beta data'}>
      <p>
        {es
          ? `Salen del cliente de la beta y pueden cambiar antes del lanzamiento del 4 de noviembre. Última revisión de los datos: ${date}, con la build ${builds.forever}. No lo he medido jugando.`
          : `They come from the beta client and may change before the 4 November launch. Data last reviewed: ${date}, on build ${builds.forever}. I have not measured any of this in play.`}
      </p>
    </Callout>
  )
}

{
  view === 'versions' && (
    <ul>
      <li>Forever: build {builds.forever}.</li>
      <li>Classic Era: build {builds.classic}.</li>
      <li>{es ? `Última revisión de los datos: ${date}.` : `Data last reviewed: ${date}.`}</li>
    </ul>
  )
}

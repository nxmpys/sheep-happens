---
import SourceRefs from './SourceRefs.astro';
import { getLocale, href } from '../../i18n/locale';
import { NAV_LABELS, formatDate, t, type UiKey } from '../../i18n/ui';
import { sortedChangelog } from '../../lib/data';
import { resolveRefs } from '../../lib/refs';
import { firstSentence } from '../../lib/text';

interface Props {
  limit?: number;
  headingLevel?: 'h2' | 'h3';
  /**
   * Headline, date, type and one line only, each linking to the full entry on
   * the updates page (home page). The full detail stays there.
   */
  compact?: boolean;
}

const { limit, headingLevel = 'h3', compact = false } = Astro.props;
const Heading = headingLevel;
const locale = getLocale(Astro);
const entries = sortedChangelog().slice(0, limit);
---

<ol class:list={['log', { 'log--compact': compact }]}>
  {
    entries.map((entry) => compact ? (
      <li class="log__entry">
        <p class="log__meta">
          <time datetime={entry.date}>{formatDate(locale, new Date(`${entry.date}T00:00:00Z`))}</time>
          <span class:list={['chip', `log__type--${entry.type}`]}>{t(locale, `updates.type.${entry.type}` as UiKey)}</span>
        </p>
        <Heading class="log__title">
          <a href={href('updates', locale, `update-${entry.id}`)}>{entry.title[locale]}</a>
        </Heading>
        <p class="log__body">{firstSentence(entry.body[locale])}</p>
      </li>
    ) : (
      <li class="log__entry">
        <p class="log__meta">
          <time datetime={entry.date}>{formatDate(locale, new Date(`${entry.date}T00:00:00Z`))}</time>
          <span class:list={['chip', `log__type--${entry.type}`]}>{t(locale, `updates.type.${entry.type}` as UiKey)}</span>
          {entry.build && (
            <span class="chip">
              {t(locale, 'updates.build')} {entry.build}
            </span>
          )}
        </p>
        <Heading class="log__title" id={`update-${entry.id}`}>
          {entry.title[locale]}
        </Heading>
        <p class="log__body">{entry.body[locale]}</p>
        {resolveRefs(entry.refs, locale).length > 0 && (
          <p class="log__refs">
            <span class="log__refs-label">{t(locale, 'updates.refs')}:</span>
            {resolveRefs(entry.refs, locale).map((ref) => {
              return ref.href ? (
                <a class="chip log__ref" href={ref.href}>
                  {ref.label}
                </a>
              ) : (
                <span class="chip log__ref">{ref.label}</span>
              );
            })}
          </p>
        )}
        {(entry.pages.length > 0 || entry.sources.length > 0) && (
          <p class="log__links">
            {entry.pages.map((page) => (
              <a href={href(page, locale)}>{NAV_LABELS[locale][page]}</a>
            ))}
            {entry.sources.length > 0 && <SourceRefs ids={entry.sources} />}
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }
  .log__entry {
    position: relative;
    margin: 0;
    padding: 0 0 var(--space-5) var(--space-5);
  }
  .log__entry + .log__entry {
    margin-top: 0;
  }
  .log__entry::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.45em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
  }
  .log__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .log__title {
    margin: var(--space-1) 0 0;
    font-size: var(--step-1);
  }
  .log__title::before {
    display: none;
  }
  .log--compact .log__entry {
    padding-bottom: var(--space-4);
  }
  .log--compact .log__title a {
    color: var(--text);
    text-decoration: none;
  }
  .log--compact .log__title a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .log__body {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }
  .log__refs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-size: var(--step--1);
  }
  .log__refs-label {
    color: var(--text-subtle);
    margin-right: var(--space-1);
  }
  a.log__ref {
    color: var(--link);
    text-decoration: none;
  }
  a.log__ref:hover {
    border-color: var(--accent);
  }
  .log__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--step--1);
  }
  .log__type--game {
    color: var(--status-reported);
  }
  .log__type--guide {
    color: var(--status-analysis);
  }
</style>

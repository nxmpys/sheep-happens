---
/**
 * Link to a content's builds page, so MDX never hardcodes its URL. The guide
 * never links to a concrete build, because builds change. A content with no
 * page goes to the builds index:
 *   <BuildLink use="leveling">las builds de leveo</BuildLink>
 */
import { getLocale, href } from '../../i18n/locale';
import { contentPages, contentPath } from '../../lib/build-routes';
import { builds } from '../../lib/data';
import type { BuildUse } from '../../lib/schemas';

type Props = { use: BuildUse };

const { use } = Astro.props;
const locale = getLocale(Astro);
const base = import.meta.env.BASE_URL;
const url = contentPages(builds).includes(use) ? contentPath(use, locale, { base }) : href('builds', locale);
---

<a href={url}><slot /></a>

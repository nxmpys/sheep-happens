---
/**
 * Link to a build's own page by build id, or to a content's builds page by
 * use, so MDX never hardcodes their URLs:
 *   <BuildLink id="frost-leveling-solo">la build de leveo</BuildLink>
 *   <BuildLink use="leveling">las builds de leveo</BuildLink>
 */
import { getLocale } from '../../i18n/locale';
import { buildPath, contentPath } from '../../lib/build-routes';
import { getBuild } from '../../lib/data';
import type { BuildUse } from '../../lib/schemas';

type Props = { id: string; use?: never } | { use: BuildUse; id?: never };

const { id, use } = Astro.props;
const locale = getLocale(Astro);
const base = import.meta.env.BASE_URL;
const url = id ? buildPath(getBuild(id), locale, { base }) : contentPath(use!, locale, { base });
---

<a href={url}><slot /></a>

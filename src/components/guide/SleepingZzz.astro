---
/**
 * Sleepy z's, saved from the first "play first" note (b481a7f), where they
 * drifted up from the Polymorph sheep's head. Not used right now: drop it
 * inside a positioned parent (it anchors with right/top) to bring it back.
 * With «reduce motion» the z's sit in a row.
 */
---

<span class="zzz" aria-hidden="true"><span>z</span><span>z</span><span>Z</span></span>

<style>
  /* Soft serif italics in the arcane tint, rising from the head. */
  .zzz {
    position: absolute;
    right: 72%;
    top: 6px;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    line-height: 1;
    color: var(--arcane);
    text-shadow: 0 0 8px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .zzz > :nth-child(1) {
    font-size: 16px;
  }
  .zzz > :nth-child(2) {
    font-size: 21px;
    margin-bottom: 8px;
  }
  .zzz > :nth-child(3) {
    font-size: 27px;
    margin-bottom: 18px;
  }

  @media (max-width: 480px) {
    .zzz {
      right: 70%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Each z starts at the head and floats off on its own, a third of a cycle apart. */
    .zzz {
      display: block;
      width: 0;
      height: 0;
      top: 26px;
    }
    .zzz > * {
      position: absolute;
      right: 0;
      bottom: 0;
      margin: 0 !important;
      opacity: 0;
      animation: zzz-drift 6s ease-in-out infinite;
    }
    .zzz > :nth-child(2) {
      animation-delay: 2s;
    }
    .zzz > :nth-child(3) {
      animation-delay: 4s;
    }
  }

  /* Drifts up and to the left in a lazy wave, growing as it fades. */
  @keyframes zzz-drift {
    0% {
      transform: translate(0, 0) scale(0.5) rotate(-8deg);
      opacity: 0;
    }
    15% {
      opacity: 0.95;
    }
    35% {
      transform: translate(-14px, -22px) scale(0.8) rotate(6deg);
    }
    65% {
      transform: translate(-22px, -46px) scale(1) rotate(-6deg);
      opacity: 0.8;
    }
    100% {
      transform: translate(-40px, -72px) scale(1.2) rotate(4deg);
      opacity: 0;
    }
  }
</style>

---
/**
 * Body of a build page (/builds/<use>/<slug>/). Same template for every build,
 * short on purpose: tree, content, focus and status as chips with one line for
 * and one against; the three trees with the actions below; why these talents;
 * tips; how to play with the cooldowns apart; gear; the leveling point order
 * folded away; and variants. A section without data is left out, here and in
 * the page index (buildSections). Consumables and races are class-wide, so
 * they live in their own guides, not here.
 */
import BuildActions from './BuildActions.astro';
import BuildReasons from './BuildReasons.astro';
import BuildTrees from './BuildTrees.astro';
import BuildVariants from './BuildVariants.astro';
import ItemCards from './ItemCards.astro';
import StatusBadge from './StatusBadge.astro';
import RotationSteps from './RotationSteps.astro';
import TalentOrder from './TalentOrder.astro';
import Icon from '../ui/Icon.astro';
import { FOCUS_LABELS, SPEC_LABELS, USE_LABELS, USE_TITLES, tb } from '../../i18n/builds';
import { getLocale, href } from '../../i18n/locale';
import { buildRole } from '../../lib/build-roles';
import { buildIcon, contentPath } from '../../lib/build-routes';
import { buildSections } from '../../lib/build-page';
import type { Build } from '../../lib/schemas';

interface Props {
  build: Build;
}

const { build } = Astro.props;
const locale = getLocale(Astro);
const sections = buildSections(locale, build);
const specLabel = build.hybridWith
  ? tb(locale, 'build.hybrid', { spec: SPEC_LABELS[locale][build.spec], other: SPEC_LABELS[locale][build.hybridWith] })
  : SPEC_LABELS[locale][build.spec];
const base = import.meta.env.BASE_URL;
---

<div class={`build-page school-${build.spec}`}>
  <ul class="build-page__chips" data-pagefind-ignore>
    <li>
      <a class="chip build-page__spec" href={href(`talents-${build.spec}`, locale)}>
        <Icon name={buildIcon(build)} size={16} />
        {specLabel}
      </a>
    </li>
    {
      build.uses.map((use) => {
        const role = buildRole(build, use);
        return (
          <li>
            <a
              class:list={['chip', 'build-page__use', `build-page__use--${role}`]}
              href={contentPath(use, locale, { base })}
              title={tb(locale, `build.roleHint.${role}`, { use: USE_LABELS[locale][use], level: build.level })}
            >
              {USE_TITLES[locale][use]} · {tb(locale, `build.${role}`)}
            </a>
          </li>
        );
      })
    }
    <li><span class="chip">{FOCUS_LABELS[locale][build.focus]}</span></li>
    <li><StatusBadge status={build.status} /></li>
    {
      build.playing && (
        <li>
          <span class="chip build-page__playing">{tb(locale, 'build.playing')}</span>
        </li>
      )
    }
  </ul>

  {
    (build.upside || build.downside) && (
      <ul class="build-page__trade">
        {build.upside && (
          <li>
            <span class="build-page__sign build-page__sign--pro" aria-hidden="true">
              +
            </span>
            <span>
              <span class="visually-hidden">{tb(locale, 'build.page.pro')}: </span>
              {build.upside[locale]}
            </span>
          </li>
        )}
        {build.downside && (
          <li>
            <span class="build-page__sign build-page__sign--con" aria-hidden="true">
              −
            </span>
            <span>
              <span class="visually-hidden">{tb(locale, 'build.page.con')}: </span>
              {build.downside[locale]}
            </span>
          </li>
        )}
      </ul>
    )
  }

  {
    sections.map((section) => {
      switch (section.key) {
        case 'talents':
          return (
            <>
              <h2 id={section.id}>{section.text}</h2>
              <BuildTrees build={build} />
              <BuildActions build={build} />
            </>
          );
        case 'why':
          return (
            <>
              <h2 id={section.id}>{section.text}</h2>
              <BuildReasons build={build} />
            </>
          );
        case 'tips':
          return (
            <>
              <h2 id={section.id}>{section.text}</h2>
              <ul class="build-page__tips">
                {build.tips.map((tip) => (
                  <li>{tip[locale]}</li>
                ))}
              </ul>
            </>
          );
        case 'rotation':
          return (
            <>
              <h2 id={section.id}>{section.text}</h2>
              {build.playstyle.length > 0 && <RotationSteps steps={build.playstyle} school={build.spec} />}
              {build.cooldowns.length > 0 && (
                <>
                  <h3>{tb(locale, 'build.page.rotation.cooldowns')}</h3>
                  <RotationSteps steps={build.cooldowns} school={build.spec} />
                </>
              )}
            </>
          );
        case 'gear':
          return (
            <>
              <h2 id={section.id}>{section.text}</h2>
              {build.itemIds.length > 0 && <ItemCards ids={build.itemIds} />}
              {build.items.length > 0 && (
                <ul>
                  {build.items.map((item) => (
                    <li>{item[locale]}</li>
                  ))}
                </ul>
              )}
              {build.stats.length > 0 && (
                <>
                  <h3>{tb(locale, 'build.page.stats')}</h3>
                  <ol>
                    {build.stats.map((item) => (
                      <li>{item[locale]}</li>
                    ))}
                  </ol>
                </>
              )}
            </>
          );
        case 'order':
          return (
            <details class="build-page__order">
              <summary>
                <h2 id={section.id}>{section.text}</h2>
                <span class="build-page__order-hint">{tb(locale, 'build.page.orderOpen')}</span>
              </summary>
              <TalentOrder build={build} />
            </details>
          );
        case 'variants':
          return (
            <>
              <h2 id={section.id}>{section.text}</h2>
              <BuildVariants build={build} />
            </>
          );
      }
    })
  }
</div>

<script>
  /** Opening the page at the point order's anchor (or following it from the index) unfolds it. */
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    const details = target?.closest('details');
    if (target && details && !details.open) {
      details.open = true;
      target.scrollIntoView();
    }
  };
  openTarget();
  addEventListener('hashchange', openTarget);
</script>

<style>
  .build-page__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
  }
  .build-page__chips li {
    margin: 0;
  }
  .build-page__spec {
    text-decoration: none;
    color: var(--text);
  }
  .build-page__spec :global(svg) {
    color: var(--school);
  }
  .build-page__use {
    text-decoration: none;
    color: var(--text);
  }
  .build-page__use--recommended {
    border-color: var(--school);
    font-weight: 700;
  }
  .build-page__use--not-recommended {
    color: var(--text-muted);
  }
  /* The build I am playing right now (`playing` in builds.json). */
  .build-page__playing {
    gap: 0.4em;
    border-color: color-mix(in srgb, var(--status-tested) 55%, transparent);
    background: color-mix(in srgb, var(--status-tested) 12%, transparent);
    color: var(--status-tested);
    font-weight: 700;
  }
  .build-page__playing::before {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: currentColor;
  }

  /* One line for and one against, under the chips. */
  .build-page__trade {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .build-page__trade li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
  }
  .build-page__sign {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    font-weight: 700;
    line-height: 1;
    color: #0e0d16;
  }
  .build-page__sign--pro {
    background: #3fbf6a;
  }
  .build-page__sign--con {
    background: #e0605a;
  }

  .build-page__tips {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .build-page__tips li {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--school);
    border-radius: var(--radius-sm, 6px);
    background: color-mix(in srgb, var(--school) 7%, transparent);
  }

  /* The leveling point order, folded: its heading is the summary, so the index can link it. */
  .build-page__order {
    margin-top: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .build-page__order > summary {
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
  }
  .build-page__order > summary h2 {
    display: inline;
    margin: 0;
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .build-page__order-hint {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .build-page__order[open] > summary {
    border-bottom: 1px solid var(--border);
  }
  .build-page__order > :not(summary) {
    margin: var(--space-4);
  }
</style>

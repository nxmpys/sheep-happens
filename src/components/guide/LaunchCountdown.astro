---
/**
 * Launch block of the home status card: a countdown to the launch instant and
 * the launch date and time in the reader's own time zone. Without JavaScript it
 * shows the date in UTC and in Spain (CET). Once the launch has passed, it says
 * «Ya disponible»: at build time if the site is built after launch, and in the
 * browser otherwise (the static site may not be rebuilt in time).
 */
import { getLocale } from '../../i18n/locale';
import { formatSpainTime, formatUtcTime } from '../../i18n/ui';

interface Props {
  /** Launch instant in UTC ("2026-11-04T23:00:00Z"). */
  at: string;
  /** Only «Launch in» and the timer (the date stays as a fallback without JS). */
  compact?: boolean;
}

const { at, compact = false } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const date = new Date(at);
const launched = date.getTime() <= Date.now();
const units = [
  { id: 'days', label: es ? 'días' : 'days' },
  { id: 'hours', label: es ? 'horas' : 'hours' },
  { id: 'minutes', label: 'min' },
  { id: 'seconds', label: es ? 'seg' : 'sec' },
];
const done = es ? 'Ya disponible' : 'Out now';
---

{
  launched ? (
    <p class:list={['countdown__done', { 'countdown__done--compact': compact }]}>{done}</p>
  ) : (
    <launch-countdown class:list={['countdown', { 'countdown--compact': compact }]} data-at={at} data-locale={es ? 'es-ES' : 'en-GB'} data-pagefind-ignore>
      <div class="countdown__live" data-live hidden>
        <p class="countdown__label">{es ? 'Lanzamiento en' : 'Launch in'}</p>
        <p class="countdown__timer" role="timer">
          {units.map((unit) => (
            <span class="countdown__unit">
              <strong data-unit={unit.id}>–</strong>
              <small>{unit.label}</small>
            </span>
          ))}
        </p>
      </div>
      <p class="countdown__when" data-static>
        <time datetime={at}>{formatUtcTime(locale, date)}</time>
        <span class="countdown__spain">{formatSpainTime(locale, date)}</span>
      </p>
      {!compact && (
        <p class="countdown__when" data-local hidden>
          <span>{es ? 'En tu hora:' : 'Your time:'}</span> <time datetime={at} data-local-time />
        </p>
      )}
      <p class="countdown__done" data-done hidden>
        {done}
      </p>
    </launch-countdown>
  )
}

<script>
  class LaunchCountdown extends HTMLElement {
    private timeout = 0;

    connectedCallback() {
      const at = Date.parse(this.dataset.at ?? '');
      if (Number.isNaN(at)) return;
      const q = <T extends HTMLElement>(selector: string) => this.querySelector<T>(selector)!;
      const live = q('[data-live]');
      const done = q('[data-done]');
      const staticWhen = q('[data-static]');
      const localWhen = this.querySelector<HTMLElement>('[data-local]');
      // Compact: the timer alone once JS runs.
      if (!localWhen) staticWhen.hidden = true;
      // The launch date in the reader's own time zone, with its name ("15:00 PST").
      if (localWhen) try {
        q('[data-local-time]').textContent = new Intl.DateTimeFormat(this.dataset.locale, {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          hour: '2-digit',
          minute: '2-digit',
          timeZoneName: 'short',
        }).format(at);
        staticWhen.hidden = true;
        localWhen.hidden = false;
      } catch {}

      const field = (id: string) => this.querySelector<HTMLElement>(`[data-unit="${id}"]`)!;
      const fields = { days: field('days'), hours: field('hours'), minutes: field('minutes'), seconds: field('seconds') };
      const pad = (n: number) => String(n).padStart(2, '0');

      const tick = () => {
        const left = at - Date.now();
        if (left <= 0) {
          live.hidden = true;
          if (localWhen) localWhen.hidden = true;
          staticWhen.hidden = true;
          done.hidden = false;
          return;
        }
        live.hidden = false;
        const total = Math.floor(left / 1000);
        fields.days.textContent = String(Math.floor(total / 86400));
        fields.hours.textContent = pad(Math.floor(total / 3600) % 24);
        fields.minutes.textContent = pad(Math.floor(total / 60) % 60);
        fields.seconds.textContent = pad(total % 60);
        // Wake up exactly when the next second ticks over.
        this.timeout = window.setTimeout(tick, left % 1000 || 1000);
      };
      tick();
    }

    disconnectedCallback() {
      clearTimeout(this.timeout);
    }
  }

  customElements.define('launch-countdown', LaunchCountdown);
</script>

<style>
  .countdown {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .countdown__live {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .countdown [hidden] {
    display: none;
  }
  .countdown__label {
    font-weight: 700;
    color: var(--text-muted);
  }
  .countdown__timer {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }
  .countdown__unit {
    display: grid;
    justify-items: center;
  }
  .countdown__unit strong {
    font-size: var(--step-2);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .countdown__unit small {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  .countdown__when {
    margin: 0;
  }
  .countdown__spain {
    display: block;
    color: var(--text-muted);
  }
  .countdown__done {
    margin: 0;
    font-weight: 700;
    color: var(--accent);
  }

  /* Compact (home hero): a small glowing panel, centred. */
  .countdown--compact {
    margin: 0;
    justify-items: center;
    text-align: center;
  }
  .countdown--compact .countdown__live {
    gap: var(--space-2);
    min-width: min(100%, 22rem);
    padding: var(--space-3) var(--space-5) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface-1) 80%, transparent);
    backdrop-filter: blur(3px);
    box-shadow: 0 0 28px color-mix(in srgb, var(--accent) 18%, transparent), var(--shadow);
  }
  .countdown--compact .countdown__label {
    font-size: 0.75rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: light-dark(var(--accent), #c9b0ff);
  }
  .countdown--compact .countdown__timer {
    gap: var(--space-5);
  }
  .countdown--compact .countdown__unit strong {
    font-size: var(--step-3);
  }
  .countdown--compact .countdown__when,
  .countdown__done--compact {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>

---
/**
 * One build, from builds.json, for the in-depth guide (`page`): talents, point
 * order, how to play it and what to bring. Every build also has its own page
 * (/builds/<use>/<slug>/, see build-routes.ts), where shared links point; the
 * summary variant links there.
 * Each use chip says whether the build is recommended, viable or not
 * recommended for that use at its level.
 */
import Icon from '../ui/Icon.astro';
import ReportButton from './ReportButton.astro';
import SpellRef from './SpellRef.astro';
import StatusBadge from './StatusBadge.astro';
import TalentOrder from './TalentOrder.astro';
import TalentGrid from './TalentGrid.astro';
import { SPEC_LABELS, USE_LABELS, tb } from '../../i18n/builds';
import { getLocale, href } from '../../i18n/locale';
import { formatDate } from '../../i18n/ui';
import { buildRole } from '../../lib/build-roles';
import { buildIcon, buildPath } from '../../lib/build-routes';
import { getBuild, getTalent, getVersion, talents } from '../../lib/data';
import { localName } from '../../lib/names';
import { distributionLabel, pointsAtLevel, spentTalents, totalPoints, wowheadBuildUrl } from '../../lib/talents';

interface Props {
  id: string;
  /** Heading level inside the page outline. */
  level?: 'h2' | 'h3';
  /** Show the talents and playstyle expanded (for the build's own guide page). */
  open?: boolean;
  /** Hide the link to the guide page (when the card is on that page). */
  hideGuideLink?: boolean;
  /** "summary": no playstyle, and a link to the build page. */
  variant?: 'full' | 'summary';
}

const { id, level = 'h3', open = false, hideGuideLink = false, variant = 'full' } = Astro.props;
const summary = variant === 'summary';
const locale = getLocale(Astro);
const build = getBuild(id);
const Heading = level;
const Sub = level === 'h2' ? 'h3' : 'h4';
const icon = buildIcon(build);
const school = build.spec;
const trees = spentTalents(build.points, talents).map((group) => group.tree);
const version = getVersion(build.gameVersion);
// Shared links point at the build's own page.
const fullUrl = buildPath(build, locale);
const shareUrl = fullUrl;
// Our own calculator reads the Wowhead code from ?t= (see TalentCalculator).
const calcCode = wowheadBuildUrl(build.points, talents).split('/mage/v2')[1] ?? '';
const calcUrl = `${href('talent-calc', locale)}?t=${calcCode}&lvl=${build.level}`;
const copyStrings = JSON.stringify({ copied: locale === 'es' ? 'Enlace copiado' : 'Link copied', failed: locale === 'es' ? 'No se pudo copiar. Copia la URL de la barra de direcciones.' : 'Could not copy. Copy the URL from the address bar instead.' });
---

<article
  class:list={['build', `school-${school}`, { 'build--summary': summary }]}
  id={build.id}
  data-build
  data-uses={build.uses.join(' ')}
  data-spec={build.spec}
  aria-labelledby={`${build.id}-title`}
>
  <header class="build__header">
    <Heading class="build__name" id={`${build.id}-title`}>
      <Icon name={icon} size={22} class="build__sigil" />
      <span>{build.name[locale]}</span>
    </Heading>
    <ul class="build__tags" data-pagefind-ignore>
      {
        build.uses.map((use) => {
          const role = buildRole(build, use);
          return (
            <li
              class:list={['chip', 'build__use', `build__use--${role}`]}
              title={tb(locale, `build.roleHint.${role}`, { use: USE_LABELS[locale][use], level: build.level })}
            >
              {USE_LABELS[locale][use]} · <span class="build__role">{tb(locale, `build.${role}`)}</span>
            </li>
          );
        })
      }
      <li class="chip">
        {build.hybridWith
          ? tb(locale, 'build.hybrid', { spec: SPEC_LABELS[locale][build.spec], other: SPEC_LABELS[locale][build.hybridWith] })
          : SPEC_LABELS[locale][build.spec]}
      </li>
      <li class="chip">
        {build.order ? tb(locale, 'build.levels', { from: build.fromLevel ?? 1, to: build.level }) : tb(locale, 'build.level', { level: build.level })} ·{' '}
        {tb(locale, 'build.totalPoints', { points: totalPoints(build.points) })}
      </li>
      {
        build.legacyTalented > 0 && (
          <li class="chip build__legacy" title={tb(locale, 'build.legacyHint', { extra: pointsAtLevel(build.level, build.legacyTalented) - pointsAtLevel(build.level) })}>
            {tb(locale, 'build.legacy', { rank: build.legacyTalented })}
          </li>
        )
      }
      <li class="chip build__points" title={tb(locale, 'build.points')}>
        <span class="visually-hidden">{tb(locale, 'build.points')}: </span>{distributionLabel(build.points, talents)}
      </li>
    </ul>
  </header>

  <div class="build__main">
    <div class="build__trees" role="group" aria-label={tb(locale, 'build.talents')}>
      {trees.map((tree) => <TalentGrid tree={tree} points={build.points} />)}
    </div>
    <div class="build__side">
      {!summary && <p class="build__summary">{build.summary[locale]}</p>}

      {
        build.keyTalents.length > 0 && (
          <p class="build__key">
            <span class="build__label">{tb(locale, 'build.keyTalents')}:</span>{' '}
            {build.keyTalents.map((key, i) => {
              const talent = getTalent(key);
              return (
                <>
                  {i > 0 && ' · '}
                  <SpellRef name={talent.name} label={localName(talent, locale)} />
                </>
              );
            })}
          </p>
        )
      }

      <div class="build__meta">
        <StatusBadge status={build.status} />
        <span class="build__version">{tb(locale, 'build.version')}: {version.label[locale]}</span>
        {
          build.updated && (
            <span class="build__checked">
              <Icon name="calendar" size={14} />
              {tb(locale, 'build.checked')}: <time datetime={build.updated}>{formatDate(locale, new Date(`${build.updated}T00:00:00Z`))}</time>
            </span>
          )
        }
        <ReportButton subject={`Build: ${build.name[locale]} (${build.id})`} />
      </div>

      <div class="build__actions" data-pagefind-ignore>
        <a class="button button--primary" href={calcUrl}>
          <Icon name="layers" size={16} />
          {tb(locale, 'build.calc')}
        </a>
        <button type="button" class="button" data-copy-link={shareUrl} data-strings={copyStrings}>
          <Icon name="link" size={16} />
          {tb(locale, 'build.copy')}
        </button>
        {
          summary ? (
            <a class="button" href={fullUrl}>
              <Icon name="book" size={16} />
              {tb(locale, 'build.full')}
            </a>
          ) : (
            build.page &&
            !hideGuideLink && (
              <a class="button" href={href(build.page, locale, build.id)}>
                <Icon name="book" size={16} />
                {tb(locale, 'build.guide')}
              </a>
            )
          )
        }
        <a class="build__wowhead" href={wowheadBuildUrl(build.points, talents)} target="_blank" rel="noopener noreferrer">
          {tb(locale, 'build.wowhead')}
          <Icon name="external" size={14} />
          <span class="visually-hidden"> ({tb(locale, 'build.wowheadHint')})</span>
        </a>
      </div>
    </div>
  </div>

  {!summary && (
  <details class="build__details" open={open}>
    <summary>{tb(locale, build.order ? 'build.detailsOrder' : 'build.details')}</summary>
    <div class="build__body">
      {
        build.order && (
          <section>
            <Sub>{tb(locale, 'build.order')}</Sub>
            <TalentOrder build={build} />
          </section>
        )
      }
      <section>
        <Sub>{tb(locale, 'build.playstyle')}</Sub>
        <ol>
          {build.playstyle.map((step) => <li>{step[locale]}</li>)}
        </ol>
      </section>
      {
        (build.strengths.length > 0 || build.weaknesses.length > 0) && (
          <div class="build__pros">
            {build.strengths.length > 0 && (
              <section>
                <Sub>{tb(locale, 'build.strengths')}</Sub>
                <ul>
                  {build.strengths.map((item) => <li>{item[locale]}</li>)}
                </ul>
              </section>
            )}
            {build.weaknesses.length > 0 && (
              <section>
                <Sub>{tb(locale, 'build.weaknesses')}</Sub>
                <ul>
                  {build.weaknesses.map((item) => <li>{item[locale]}</li>)}
                </ul>
              </section>
            )}
          </div>
        )
      }
      {
        build.items.length > 0 && (
          <section>
            <Sub>{tb(locale, 'build.items')}</Sub>
            <ul>
              {build.items.map((item) => <li>{item[locale]}</li>)}
            </ul>
          </section>
        )
      }
    </div>
  </details>
  )}
</article>

<script>
  import { copyText } from '../../scripts/clipboard';
  import { showToast } from '../../scripts/toast';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    button.addEventListener('click', async () => {
      const strings: Record<string, string> = JSON.parse(button.dataset.strings ?? '{}');
      const ok = await copyText(new URL(button.dataset.copyLink!, location.origin).href);
      showToast(ok ? strings['copied']! : strings['failed']!);
    });
  }
</script>

<style>
  .build {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-top: 4px solid var(--school);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .build:target {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--school) 45%, transparent);
  }
  .build[hidden] {
    display: none;
  }
  .build__header {
    display: grid;
    gap: var(--space-2);
  }
  .build__name {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--step-2);
  }
  :global(.build__sigil) {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--school);
  }
  .build__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .build__use {
    background: var(--school-soft);
    border-color: color-mix(in srgb, var(--school) 45%, transparent);
    color: var(--text);
    font-weight: 600;
  }
  .build__role {
    font-weight: 500;
    color: var(--text-muted);
  }
  .build__use--recommended {
    border-color: var(--school);
  }
  .build__use--recommended .build__role {
    font-weight: 700;
    color: var(--text);
  }
  .build__legacy {
    border-color: var(--baseline);
    color: var(--baseline);
    font-weight: 600;
  }
  .build__points {
    font-variant-numeric: tabular-nums;
  }
  .build__summary {
    margin: 0;
  }
  .build__key {
    margin: 0;
    font-size: var(--step--1);
  }
  .build__label {
    font-weight: 700;
    color: var(--text-muted);
  }
  .build__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .build__checked {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .build__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .build__details {
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
  }
  .build__details summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--link);
  }
  .build__body {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
  .build__body :is(h3, h4) {
    margin: 0 0 var(--space-2);
    font-size: var(--step-0);
  }
  .build__body ol,
  .build__body ul {
    margin: 0;
    padding-left: 1.25em;
  }
  .build__body li + li {
    margin-top: var(--space-1);
  }
  /* The tree first, like the game's window; the explanation and links beside it on wide screens. */
  .build__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .build__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .build__wowhead {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    align-self: center;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .build__wowhead:hover {
    color: var(--text);
  }
  .build__trees {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .build__trees > :global(.tg) {
    flex: 0 1 18.5rem;
  }
  @media (min-width: 44rem) {
    .build__main {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .build__trees {
      flex-direction: column;
    }
  }
  .build__pros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
</style>

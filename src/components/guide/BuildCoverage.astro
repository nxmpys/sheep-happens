---
/**
 * For each use, which trees already have a build and which are still pending
 * for the level cap, derived from builds.json (src/lib/build-coverage.ts). Lives
 * on the builds page, inside BuildExplorer, whose use filter hides the other
 * uses. Links point at the build cards on the same page.
 */
import Icon from '../ui/Icon.astro';
import { SPEC_LABELS, USE_LABELS, USE_PENDING, tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';
import { buildCoverage, buildRole } from '../../lib/build-coverage';
import { builds } from '../../lib/data';
import type { Build, BuildUse } from '../../lib/schemas';
import { MAX_LEVEL } from '../../lib/talents';

const locale = getLocale(Astro);
const coverage = buildCoverage(builds, MAX_LEVEL);
const pending = tb(locale, 'coverage.pending', { level: MAX_LEVEL });
const role = (build: Build, use: BuildUse) => tb(locale, `build.${buildRole(build, use)}`).toLowerCase();
---

<section class="coverage" aria-labelledby="build-coverage-title" data-pagefind-ignore>
  <h3 id="build-coverage-title" class="coverage__title">{tb(locale, 'coverage.title')}</h3>
  <p class="coverage__intro">{tb(locale, 'coverage.intro', { level: MAX_LEVEL })}</p>
  <ul class="coverage__uses">
    {
      coverage.map(({ use, cells, hybrids }) => {
        const links = (list: Build[]) =>
          list.map((build, i) => (
            <>
              {i > 0 && ', '}
              <a href={`#${build.id}`}>{build.name[locale]}</a> ({role(build, use)})
            </>
          ));
        return (
          <li class="coverage__use" data-coverage-use={use}>
            <h4 class="coverage__name">{USE_LABELS[locale][use]}</h4>
            <ul class="coverage__trees">
              {cells.map((cell) => (
                <li class:list={['coverage__cell', `school-${cell.tree}`, `is-${cell.state}`]}>
                  <Icon name={cell.state === 'ready' ? cell.tree : 'pending'} size={16} class="coverage__icon" />
                  <span>
                    <strong>{SPEC_LABELS[locale][cell.tree]}</strong>:{' '}
                    {cell.state === 'ready' ? (
                      links(cell.builds)
                    ) : (
                      <>
                        <span class="coverage__pending">{pending}</span>
                        {cell.state === 'partial' && (
                          <>
                            {' · '}
                            {tb(locale, 'coverage.partial', { level: cell.builds[0]!.level })}: {links(cell.builds)}
                          </>
                        )}
                      </>
                    )}
                  </span>
                </li>
              ))}
              {hybrids.length > 0 && (
                <li class="coverage__cell school-baseline is-ready">
                  <Icon name="frostfire" size={16} class="coverage__icon" />
                  <span>
                    <strong>{tb(locale, 'coverage.hybrid')}</strong>: {links(hybrids)}
                  </span>
                </li>
              )}
            </ul>
            {cells.some((cell) => cell.state !== 'ready') && <p class="coverage__note">{USE_PENDING[locale][use]}</p>}
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .coverage {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .coverage__title {
    margin: 0;
  }
  .coverage__intro {
    margin: 0;
    color: var(--text-muted);
  }
  .coverage__uses,
  .coverage__trees {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .coverage__uses {
    display: grid;
    gap: var(--space-3);
  }
  .coverage__use {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .coverage__use[hidden] {
    display: none;
  }
  .coverage__name {
    margin: 0;
    font-size: var(--step-0);
  }
  .coverage__trees {
    display: grid;
    gap: var(--space-1);
  }
  .coverage__cell {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--school) 45%, transparent);
    border-left-width: 4px;
    border-left-color: var(--school);
    border-radius: var(--radius);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }
  .coverage__cell.is-pending,
  .coverage__cell.is-partial {
    border-style: dashed;
    border-left-style: solid;
    color: var(--text-muted);
  }
  .coverage__cell.is-pending {
    border-color: var(--border-strong);
    border-left-color: var(--border-strong);
  }
  :global(.coverage__icon) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--school);
  }
  .is-pending :global(.coverage__icon),
  .is-partial :global(.coverage__icon) {
    color: var(--status-pending);
  }
  .coverage__cell strong {
    color: var(--text);
  }
  .coverage__pending {
    font-weight: 600;
    color: var(--status-pending);
  }
  .coverage__note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>

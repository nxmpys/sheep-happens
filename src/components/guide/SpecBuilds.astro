---
/**
 * Overview of one tree for its talent page, from specs.json: strengths and
 * weaknesses, and links to the builds of each content. It never links to a
 * concrete build, because builds change.
 */
import { USE_TITLES, tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';
import { LINKED_CONTENTS, contentPath } from '../../lib/build-routes';
import { specs } from '../../lib/data';
import type { BuildSpec } from '../../lib/schemas';

interface Props {
  spec: BuildSpec;
}

const { spec } = Astro.props;
const locale = getLocale(Astro);
const overview = specs.find((s) => s.id === spec)!;
---

<div class={`spec-builds school-${spec}`}>
  <div class="spec-builds__pros">
    <section>
      <p class="spec-builds__label">{tb(locale, 'spec.strengths')}</p>
      <ul>{overview.strengths.map((item) => <li>{item[locale]}</li>)}</ul>
    </section>
    <section>
      <p class="spec-builds__label">{tb(locale, 'spec.weaknesses')}</p>
      <ul>{overview.weaknesses.map((item) => <li>{item[locale]}</li>)}</ul>
    </section>
  </div>

  <p class="spec-builds__uses">
    <span class="spec-builds__label">Builds</span>
    {LINKED_CONTENTS.map((use) => <a href={contentPath(use, locale, { base: import.meta.env.BASE_URL })}>{USE_TITLES[locale][use]}</a>)}
  </p>
</div>

<style>
  .spec-builds {
    display: grid;
    gap: var(--space-4);
  }
  .spec-builds__pros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
  .spec-builds__label {
    margin: 0 0 var(--space-2);
    font-weight: 700;
  }
  .spec-builds__pros ul {
    margin: 0;
  }
  .spec-builds__uses {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--school);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .spec-builds__uses .spec-builds__label {
    margin: 0;
  }
  .spec-builds__uses a {
    font-weight: 600;
  }
</style>

---
/**
 * Overview of one tree for its talent page, from specs.json and builds.json:
 * strengths, weaknesses, and for each content its builds in this tree or the
 * reason there is none. A new build in builds.json shows up here by itself
 * (and data.ts then asks to remove the matching `noBuild` reason).
 */
import Icon from '../ui/Icon.astro';
import { USE_TITLES, tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';
import { buildRole } from '../../lib/build-roles';
import { buildIcon, buildPath } from '../../lib/build-routes';
import { builds, specs } from '../../lib/data';
import { BUILD_USES, type BuildSpec } from '../../lib/schemas';

interface Props {
  spec: BuildSpec;
}

const { spec } = Astro.props;
const locale = getLocale(Astro);
const overview = specs.find((s) => s.id === spec)!;
const rows = BUILD_USES.map((use) => ({
  use,
  list: builds.filter((b) => b.spec === spec && b.uses.includes(use)),
  reason: overview.noBuild[use],
}));
---

<div class={`spec-builds school-${spec}`}>
  <div class="spec-builds__pros">
    <section>
      <p class="spec-builds__label">{tb(locale, 'spec.strengths')}</p>
      <ul>{overview.strengths.map((item) => <li>{item[locale]}</li>)}</ul>
    </section>
    <section>
      <p class="spec-builds__label">{tb(locale, 'spec.weaknesses')}</p>
      <ul>{overview.weaknesses.map((item) => <li>{item[locale]}</li>)}</ul>
    </section>
  </div>

  <ul class="spec-builds__uses">
    {
      rows.map(({ use, list, reason }) => (
        <li class:list={['spec-builds__use', { 'is-empty': list.length === 0 }]}>
          <span class="spec-builds__content">{USE_TITLES[locale][use]}</span>
          {list.length > 0 ? (
            <span class="spec-builds__list">
              {list.map((build) => (
                <a href={buildPath(build, locale, { base: import.meta.env.BASE_URL })}>
                  <Icon name={buildIcon(build)} size={16} />
                  {build.name[locale]}
                  <span class="spec-builds__role">· {tb(locale, `build.${buildRole(build, use)}`)}</span>
                </a>
              ))}
            </span>
          ) : (
            <span class="spec-builds__none">
              <strong>{tb(locale, 'spec.noBuild')}.</strong> {reason?.[locale]}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .spec-builds {
    display: grid;
    gap: var(--space-4);
  }
  .spec-builds__pros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
  .spec-builds__label {
    margin: 0 0 var(--space-2);
    font-weight: 700;
  }
  .spec-builds__pros ul {
    margin: 0;
  }
  .spec-builds__uses {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .spec-builds__use {
    display: grid;
    grid-template-columns: minmax(8rem, 10rem) 1fr;
    gap: var(--space-3);
    align-items: baseline;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--school);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .spec-builds__use.is-empty {
    border-left-style: dashed;
  }
  .spec-builds__content {
    font-weight: 700;
  }
  .spec-builds__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .spec-builds__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-weight: 600;
  }
  .spec-builds__list :global(svg) {
    color: var(--school);
  }
  .spec-builds__role {
    font-weight: 400;
    color: var(--text-muted);
  }
  .spec-builds__none {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  @media (max-width: 30rem) {
    .spec-builds__use {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

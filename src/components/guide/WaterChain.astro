---
/** The causal chain of the water page: each link labelled as data or as my inference. */
import Icon from '../ui/Icon.astro';
import { getLocale } from '../../i18n/locale';
import { mageWater } from '../../lib/data';

const locale = getLocale(Astro);
const es = locale === 'es';
const labels = {
  data: es ? 'Dato' : 'Data',
  inference: es ? 'Inferencia' : 'Inference',
};
---

<ol class="chain" aria-label={es ? 'Cadena de causas, de arriba abajo' : 'Chain of causes, top to bottom'}>
  {
    mageWater.chain.map((link) => (
      <li class:list={['link', `link--${link.kind}`]}>
        <span class="link__label">
          <Icon name={link.kind === 'data' ? 'info' : 'analysis'} size={14} strokeWidth={2} />
          {labels[link.kind]}
        </span>
        <span>{link.text[locale]}</span>
      </li>
    ))
  }
</ol>

<style>
  .chain {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .link {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--link-color);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .link--data {
    --link-color: var(--status-reported);
  }
  .link--inference {
    --link-color: var(--status-analysis);
    border-style: dashed;
  }
  /* The arrow to the next link. */
  .link:not(:last-child)::after {
    content: '↓';
    position: absolute;
    left: var(--space-4);
    bottom: calc(-1 * var(--space-4) - 2px);
    line-height: 1;
    color: var(--text-subtle);
  }
  .link__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--link-color);
  }
</style>

---
/**
 * The analysis of one profession, folded: closed it shows the icon, the name, what
 * it gives and its ratings; open, the same structure for every profession
 * (summary, advantages, drawbacks, PvE and PvP, leveling and economy, best pair
 * and verdict, then the items behind it). Its heading has the id the picks and
 * the comparison table link to, and a link to it opens the card.
 */
import Icon from '../ui/Icon.astro';
import GameIcon from '../learn/GameIcon.astro';
import '../../styles/learn.css';
import RatingBadge from './RatingBadge.astro';
import SourceRefs from './SourceRefs.astro';
import StatusBadge from './StatusBadge.astro';
import { getLocale } from '../../i18n/locale';
import { EDGE_LABELS, KIND_LABELS, PRIORITY_LABELS, tp, type ProfessionUiKey } from '../../i18n/professions';
import { getProfession } from '../../lib/data';
import { ownSourceIds, sharedProfessionSources } from '../../lib/page-sources';
import { PROFESSION_ICONS, professionAnchor, wowheadItemUrl } from '../../lib/professions';

interface Props {
  id: string;
}

const { id } = Astro.props;
const locale = getLocale(Astro);
const profession = getProfession(id);
const RATING_KEYS = ['pve', 'pvp', 'leveling', 'economy', 'overall'] as const;
const partners = profession.pair?.with.map(getProfession) ?? [];
const or = locale === 'es' ? ' o ' : ' or ';
---

<details class={`profession profession--${profession.kind}`} data-profession={profession.id}>
  <summary class="profession__head">
    <GameIcon icon={PROFESSION_ICONS[profession.id]} size={52} />
    <span class="profession__title">
      <h3 id={professionAnchor(profession, locale)}>{profession.name[locale]}</h3>
      {profession.benefit && <span class="profession__benefit">{profession.benefit[locale]}</span>}
    </span>
    <ul class="profession__tags" data-pagefind-ignore>
      <li class="chip">{EDGE_LABELS[locale][profession.edge]}</li>
      {
        profession.ratings && (
          <li class="profession__rating">
            <span class="profession__rating-key" aria-hidden="true">
              {tp(locale, 'rating.overall')}
            </span>
            <RatingBadge value={profession.ratings.overall} label={tp(locale, 'rating.overall')} />
          </li>
        )
      }
      {
        profession.priority && (
          <li class="chip profession__priority">
            {tp(locale, 'detail.priority')}: {PRIORITY_LABELS[locale][profession.priority]}
          </li>
        )
      }
    </ul>
    <Icon name="chevronDown" size={18} class="profession__arrow" />
  </summary>

  <div class="profession__body">
  {
    profession.ratings && (
      <ul class="profession__tags" data-pagefind-ignore>
        <li class="chip">{KIND_LABELS[locale][profession.kind]}</li>
        {RATING_KEYS.filter((key) => key !== 'overall').map((key) => (
          <li class="profession__rating">
            <span class="profession__rating-key" aria-hidden="true">
              {tp(locale, `rating.${key}` as ProfessionUiKey)}
            </span>
            <RatingBadge value={profession.ratings![key]} label={tp(locale, `rating.${key}` as ProfessionUiKey)} />
          </li>
        ))}
      </ul>
    )
  }

  <p class="profession__summary">
    <span class="profession__label">{tp(locale, 'detail.summary')}:</span>{' '}
    {profession.summary[locale]}
  </p>

  {
    (profession.pros.length > 0 || profession.cons.length > 0) && (
      <div class="profession__columns">
        {profession.pros.length > 0 && (
          <section class="profession__pros">
            <h4>
              <Icon name="verified" size={18} />
              {tp(locale, 'detail.pros')}
            </h4>
            <ul>
              {profession.pros.map((item) => (
                <li>{item[locale]}</li>
              ))}
            </ul>
          </section>
        )}
        {profession.cons.length > 0 && (
          <section class="profession__cons">
            <h4>
              <Icon name="warning" size={18} />
              {tp(locale, 'detail.cons')}
            </h4>
            <ul>
              {profession.cons.map((item) => (
                <li>{item[locale]}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )
  }

  <section>
    <h4>{tp(locale, 'detail.pvePvp')}</h4>
    <p><span class="profession__label">{tp(locale, 'detail.pve')}:</span> {profession.pve[locale]}</p>
    <p><span class="profession__label">{tp(locale, 'detail.pvp')}:</span> {profession.pvp[locale]}</p>
  </section>

  {
    profession.levelingEconomy && (
      <section>
        <h4>{tp(locale, 'detail.levelingEconomy')}</h4>
        <p>{profession.levelingEconomy[locale]}</p>
      </section>
    )
  }

  {
    profession.pair && (
      <section>
        <h4>{tp(locale, 'detail.pair')}</h4>
        <p>
          <span class="profession__label">
            {`${profession.name[locale]} + `}
            {partners.map((partner, i) => (
              <>
                {i > 0 && or}
                <a href={`#${professionAnchor(partner, locale)}`}>{partner.name[locale]}</a>
              </>
            ))}.</span
          >{' '}
          {profession.pair.why[locale]}
        </p>
      </section>
    )
  }

  <section class="profession__verdict">
    <h4>{tp(locale, 'detail.verdict')}</h4>
    <p>{profession.verdict[locale]}</p>
  </section>

  {
    profession.items.length > 0 && (
      <section class="profession__items">
        <h4>{tp(locale, 'detail.items')}</h4>
        <ul>
          {profession.items.map((item) => (
            <li>
              <a href={wowheadItemUrl(item.wowhead)} target="_blank" rel="noopener noreferrer" lang="en">
                {item.name}
                <Icon name="external" size={13} />
                <span class="visually-hidden"> ({tp(locale, 'detail.wowhead')})</span>
              </a>{' '}
              <span class="profession__item-note">{item.note[locale]}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="profession__meta">
    <StatusBadge status={profession.status} />
    {ownSourceIds(profession.sources, sharedProfessionSources).length > 0 && (
      <SourceRefs ids={ownSourceIds(profession.sources, sharedProfessionSources)} />
    )}
  </p>
  </div>
</details>

<style>
  .profession {
    margin-top: var(--space-2);
    border: 1px solid var(--border);
    border-left: 4px solid var(--edge-color, var(--border-strong));
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .profession__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    list-style: none;
    cursor: pointer;
  }
  .profession__head::-webkit-details-marker {
    display: none;
  }
  .profession__head:hover {
    background: var(--surface-2);
  }
  .profession__title {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .profession__title h3 {
    margin: 0;
    font-size: var(--step-1);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .profession__benefit {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.35;
  }
  .profession__head :global(.profession__arrow) {
    color: var(--text-subtle);
    transition: transform 0.15s;
  }
  .profession[open] .profession__head :global(.profession__arrow) {
    transform: rotate(180deg);
  }
  .profession__body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--border);
  }
  @media (max-width: 44rem) {
    .profession__head {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .profession__head > .profession__tags {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  .profession p,
  .profession ul {
    margin: 0;
  }
  .profession section > * + * {
    margin-top: var(--space-2);
  }
  .profession h4 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: var(--step-0);
  }
  .profession__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .profession__tags li + li {
    margin-top: 0;
  }
  .profession__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .profession__priority {
    border-color: var(--accent);
    color: var(--text);
    font-weight: 600;
  }
  .profession__label {
    font-weight: 700;
  }
  .profession__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
  .profession__columns ul,
  .profession__items ul {
    padding-left: 1.25em;
  }
  .profession__columns li + li,
  .profession__items li + li {
    margin-top: var(--space-1);
  }
  .profession__pros h4 :global(svg) {
    color: var(--status-verified);
  }
  .profession__cons h4 :global(svg) {
    color: var(--warning);
  }
  .profession__verdict {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .profession__items {
    font-size: var(--step--1);
  }
  .profession__items a :global(svg) {
    margin-left: 0.15em;
    vertical-align: -0.1em;
  }
  .profession__item-note {
    color: var(--text-muted);
  }
  .profession__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .profession--crafting {
    --edge-color: var(--accent);
  }
  .profession--gathering {
    --edge-color: var(--baseline);
  }
  .profession--secondary {
    --edge-color: var(--border-strong);
  }
</style>

---
/**
 * The analysis of one profession, placed under its "### <name>" heading in the
 * MDX page (the heading stays in Markdown so it shows in the page index):
 *   ### Sastrería
 *   <ProfessionDetail id="tailoring" />
 * Same structure for every profession: summary, advantages, drawbacks, PvE and
 * PvP, leveling and economy, best pair and verdict, then the items behind it.
 */
import Icon from '../ui/Icon.astro';
import RatingBadge from './RatingBadge.astro';
import SourceRefs from './SourceRefs.astro';
import StatusBadge from './StatusBadge.astro';
import { getLocale } from '../../i18n/locale';
import { EDGE_LABELS, KIND_LABELS, PRIORITY_LABELS, tp, type ProfessionUiKey } from '../../i18n/professions';
import { getProfession } from '../../lib/data';
import { professionAnchor, wowheadItemUrl } from '../../lib/professions';

interface Props {
  id: string;
}

const { id } = Astro.props;
const locale = getLocale(Astro);
const profession = getProfession(id);
const RATING_KEYS = ['pve', 'pvp', 'leveling', 'economy', 'overall'] as const;
const partners = profession.pair?.with.map(getProfession) ?? [];
const or = locale === 'es' ? ' o ' : ' or ';
---

<div class={`profession profession--${profession.kind}`} data-profession={profession.id}>
  <ul class="profession__tags" data-pagefind-ignore>
    <li class="chip">{KIND_LABELS[locale][profession.kind]}</li>
    <li class="chip">{EDGE_LABELS[locale][profession.edge]}</li>
    {
      profession.ratings &&
        RATING_KEYS.map((key) => (
          <li class="profession__rating">
            <span class="profession__rating-key" aria-hidden="true">
              {tp(locale, `rating.${key}` as ProfessionUiKey)}
            </span>
            <RatingBadge value={profession.ratings![key]} label={tp(locale, `rating.${key}` as ProfessionUiKey)} />
          </li>
        ))
    }
    {
      profession.priority && (
        <li class="chip profession__priority">
          {tp(locale, 'detail.priority')}: {PRIORITY_LABELS[locale][profession.priority]}
        </li>
      )
    }
  </ul>

  <p class="profession__summary">
    <span class="profession__label">{tp(locale, 'detail.summary')}:</span>{' '}
    {profession.summary[locale]}
  </p>

  {
    (profession.pros.length > 0 || profession.cons.length > 0) && (
      <div class="profession__columns">
        {profession.pros.length > 0 && (
          <section class="profession__pros">
            <h4>
              <Icon name="verified" size={18} />
              {tp(locale, 'detail.pros')}
            </h4>
            <ul>
              {profession.pros.map((item) => (
                <li>{item[locale]}</li>
              ))}
            </ul>
          </section>
        )}
        {profession.cons.length > 0 && (
          <section class="profession__cons">
            <h4>
              <Icon name="warning" size={18} />
              {tp(locale, 'detail.cons')}
            </h4>
            <ul>
              {profession.cons.map((item) => (
                <li>{item[locale]}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )
  }

  <section>
    <h4>{tp(locale, 'detail.pvePvp')}</h4>
    <p><span class="profession__label">{tp(locale, 'detail.pve')}:</span> {profession.pve[locale]}</p>
    <p><span class="profession__label">{tp(locale, 'detail.pvp')}:</span> {profession.pvp[locale]}</p>
  </section>

  {
    profession.levelingEconomy && (
      <section>
        <h4>{tp(locale, 'detail.levelingEconomy')}</h4>
        <p>{profession.levelingEconomy[locale]}</p>
      </section>
    )
  }

  {
    profession.pair && (
      <section>
        <h4>{tp(locale, 'detail.pair')}</h4>
        <p>
          <span class="profession__label">
            {`${profession.name[locale]} + `}
            {partners.map((partner, i) => (
              <>
                {i > 0 && or}
                <a href={`#${professionAnchor(partner, locale)}`}>{partner.name[locale]}</a>
              </>
            ))}.</span
          >{' '}
          {profession.pair.why[locale]}
        </p>
      </section>
    )
  }

  <section class="profession__verdict">
    <h4>{tp(locale, 'detail.verdict')}</h4>
    <p>{profession.verdict[locale]}</p>
  </section>

  {
    profession.items.length > 0 && (
      <section class="profession__items">
        <h4>{tp(locale, 'detail.items')}</h4>
        <ul>
          {profession.items.map((item) => (
            <li>
              <a href={wowheadItemUrl(item.wowhead)} target="_blank" rel="noopener noreferrer" lang="en">
                {item.name}
                <Icon name="external" size={13} />
                <span class="visually-hidden"> ({tp(locale, 'detail.wowhead')})</span>
              </a>{' '}
              <span class="profession__item-note">{item.note[locale]}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="profession__meta">
    <StatusBadge status={profession.status} />
    <SourceRefs ids={profession.sources} />
  </p>
</div>

<style>
  .profession {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-left: 4px solid var(--edge-color, var(--border-strong));
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .profession p,
  .profession ul {
    margin: 0;
  }
  .profession section > * + * {
    margin-top: var(--space-2);
  }
  .profession h4 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: var(--step-0);
  }
  .profession__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .profession__tags li + li {
    margin-top: 0;
  }
  .profession__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .profession__priority {
    border-color: var(--accent);
    color: var(--text);
    font-weight: 600;
  }
  .profession__label {
    font-weight: 700;
  }
  .profession__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
  .profession__columns ul,
  .profession__items ul {
    padding-left: 1.25em;
  }
  .profession__columns li + li,
  .profession__items li + li {
    margin-top: var(--space-1);
  }
  .profession__pros h4 :global(svg) {
    color: var(--status-verified);
  }
  .profession__cons h4 :global(svg) {
    color: var(--warning);
  }
  .profession__verdict {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .profession__items {
    font-size: var(--step--1);
  }
  .profession__items a :global(svg) {
    margin-left: 0.15em;
    vertical-align: -0.1em;
  }
  .profession__item-note {
    color: var(--text-muted);
  }
  .profession__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .profession--crafting {
    --edge-color: var(--accent);
  }
  .profession--gathering {
    --edge-color: var(--baseline);
  }
  .profession--secondary {
    --edge-color: var(--border-strong);
  }
</style>

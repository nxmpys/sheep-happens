---
/**
 * «Estoy a nivel X»: pick a level (1–30) and a leveling build, and see the
 * spells you learn at that level (leveling-spells.json), the talent point of
 * the build for that level (respecting the site-wide Talented switch) and
 * what comes in the next two levels. The URL keeps the state
 * (?nivel=24&build=frost-leveling-solo, or ?level= on English pages; both are read).
 *
 * Only existing data: the builds' point order and notes, and the key spells table.
 * Without JavaScript the page shows the whole plan of the recommended build,
 * level by level, without Talented.
 */
import SpellRef from './SpellRef.astro';
import TalentedToggle from './TalentedToggle.astro';
import { getLocale, href } from '../../i18n/locale';
import { builds, getTalent, levelingSpells } from '../../lib/data';
import { levelStep, MAX_PLAN_LEVEL, MIN_LEVEL, type PlanBuild } from '../../lib/level-plan';
import { localName, localSpellName } from '../../lib/names';
import { spellIndexFor } from '../../lib/spell-index';
import { findSpell } from '../../lib/spells';
import { pointsAtLevel } from '../../lib/talents';

interface Props {
  /** Build selected when the URL names none. */
  recommended?: string;
}

const { recommended = 'frost-leveling-solo' } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const index = spellIndexFor(locale);
const ref = (english: string, label: string) => {
  const spell = findSpell(index, english);
  return { label, ...(spell ? { key: spell.key, school: spell.school === 'frostfire' ? 'fire' : spell.school } : {}) };
};
const rankLabel = (spell: string, rank: number) => (es ? `${localSpellName(spell, locale)} de rango ${rank}` : `rank ${rank} ${spell}`);

const levelingBuilds = builds.filter((b) => b.order && b.page === 'leveling');
const plans = levelingBuilds.map((b) => ({
  id: b.id,
  name: b.name[locale],
  url: href('leveling', locale, b.id),
  build: { order: b.order!, basePoints: pointsAtLevel(b.level, b.legacyTalented) } satisfies PlanBuild,
  notes: Object.fromEntries(b.orderNotes.map((n) => [n.point, n.text[locale]])),
}));
const talentIds = [...new Set(levelingBuilds.flatMap((b) => b.order!))];
const talentInfo = Object.fromEntries(
  talentIds.map((id) => {
    const talent = getTalent(id);
    return [id, { ...ref(talent.name, localName(talent, locale)), maxRank: talent.maxRank }];
  }),
);
const spellInfo = Object.fromEntries(
  [...new Set(levelingSpells.flatMap((row) => [...row.spells, ...row.ranks.map((r) => r.spell)]))].map((name) => [
    name,
    ref(name, localSpellName(name, locale)),
  ]),
);
const rankInfo = Object.fromEntries(
  levelingSpells.flatMap((row) => row.ranks.map((r) => [`${r.spell}#${r.rank}`, rankLabel(r.spell, r.rank)])),
);
const strings = es
  ? {
      levelTitle: 'A nivel {level}',
      next: 'Lo que llega después',
      spells: 'Hechizos que aprendes',
      noSpells: 'Ningún hechizo importante nuevo: visita al instructor por si hay rangos nuevos.',
      point: 'Punto de talento {point}',
      extra: 'Solo con Talented',
      noPoint: 'Sin punto de talento en este nivel.',
      beforeTalents: 'Todavía no tienes puntos de talento: el primero llega a nivel {first}.',
      afterBuild: 'La build no tiene más puntos hasta el 30.',
      full: 'Ver la build completa',
      copy: 'Copiar enlace',
      copied: 'Enlace copiado',
      copyFailed: 'No se pudo copiar. Copia la URL de la barra de direcciones.',
    }
  : {
      levelTitle: 'At level {level}',
      next: 'What comes next',
      spells: 'Spells you learn',
      noSpells: 'No key new spell: visit your trainer in case there are new ranks.',
      point: 'Talent point {point}',
      extra: 'Talented only',
      noPoint: 'No talent point at this level.',
      beforeTalents: 'No talent points yet: the first one comes at level {first}.',
      afterBuild: 'The build has no more points up to 30.',
      full: 'See the full build',
      copy: 'Copy link',
      copied: 'Link copied',
      copyFailed: 'Could not copy. Copy the URL from the address bar instead.',
    };
const payload = { plans, talents: talentInfo, spells: spellInfo, ranks: rankInfo, rows: levelingSpells, strings, param: es ? 'nivel' : 'level' };
const fallback = plans.find((p) => p.id === recommended) ?? plans[0]!;
const levels = Array.from({ length: MAX_PLAN_LEVEL - MIN_LEVEL + 1 }, (_, i) => i + MIN_LEVEL);
---

<level-view data-payload={JSON.stringify(payload)} data-default={recommended}>
  <form class="lv-controls" hidden data-controls data-pagefind-ignore>
    <label class="lv-field">
      <span>{es ? 'Tu nivel' : 'Your level'}</span>
      <span class="lv-level">
        <input type="range" min={MIN_LEVEL} max={MAX_PLAN_LEVEL} value="10" name="level" data-level-range aria-describedby="lv-level-value" />
        <input type="number" min={MIN_LEVEL} max={MAX_PLAN_LEVEL} value="10" inputmode="numeric" data-level-number aria-label={es ? 'Nivel' : 'Level'} id="lv-level-value" />
      </span>
    </label>
    <label class="lv-field">
      <span>{es ? 'Build de leveo' : 'Leveling build'}</span>
      <select name="build" data-build-select>
        {plans.map((p) => <option value={p.id} selected={p.id === recommended}>{p.name}</option>)}
      </select>
    </label>
    <TalentedToggle />
  </form>

  <div class="lv-result" hidden data-result aria-live="polite"></div>

  <div class="lv-fallback" data-fallback>
    <p class="lv-fallback__note">
      {es ? `Plan nivel a nivel de la build «${fallback.name}», sin Talented.` : `Level-by-level plan of the “${fallback.name}” build, without Talented.`}
    </p>
    <div class="table-wrap" tabindex="0" role="region" aria-label={fallback.name}>
      <table>
        <thead>
          <tr>
            <th scope="col">{es ? 'Nivel' : 'Level'}</th>
            <th scope="col">{es ? 'Hechizos' : 'Spells'}</th>
            <th scope="col">{es ? 'Punto de talento' : 'Talent point'}</th>
          </tr>
        </thead>
        <tbody>
          {
            levels.map((level) => {
              const step = levelStep(fallback.build, levelingSpells, level, false);
              if (step.spells.length === 0 && step.ranks.length === 0 && !step.point) return null;
              const talent = step.point ? talentInfo[step.point.talent]! : undefined;
              return (
                <tr id={`lv-${level}`}>
                  <th scope="row">{level}</th>
                  <td>
                    {[...step.spells.map((s) => spellInfo[s]!.label), ...step.ranks.map((r) => rankInfo[`${r.spell}#${r.rank}`]!)].join(', ')}
                  </td>
                  <td>
                    {step.point && talent && (
                      <>
                        <SpellRef name={getTalent(step.point.talent).name} label={talent.label} /> {step.point.rank}/{talent.maxRank}
                      </>
                    )}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</level-view>

<script>
  import { copyText } from '../../scripts/clipboard';
  import { showToast } from '../../scripts/toast';
  import { readTalented, TALENTED_EVENT } from '../../scripts/talented';
  import { levelPlan, parseLevel, type LevelStep, type PlanBuild, type PlanSpells } from '../../lib/level-plan';

  interface Ref {
    label: string;
    key?: string;
    school?: string;
  }
  interface Payload {
    plans: { id: string; name: string; url: string; build: PlanBuild; notes: Record<string, string> }[];
    talents: Record<string, Ref & { maxRank: number }>;
    spells: Record<string, Ref>;
    ranks: Record<string, string>;
    rows: PlanSpells[];
    strings: Record<string, string>;
    param: string;
  }

  class LevelView extends HTMLElement {
    private data!: Payload;
    private level = 10;
    private buildId = '';

    connectedCallback() {
      this.data = JSON.parse(this.dataset.payload ?? '{}');
      const params = new URLSearchParams(location.search);
      this.level = parseLevel(params.get('nivel') ?? params.get('level')) ?? 10;
      const fromUrl = params.get('build');
      this.buildId = this.data.plans.some((p) => p.id === fromUrl) ? fromUrl! : (this.dataset.default ?? this.data.plans[0]!.id);

      const form = this.querySelector<HTMLFormElement>('[data-controls]')!;
      const range = form.querySelector<HTMLInputElement>('[data-level-range]')!;
      const number = form.querySelector<HTMLInputElement>('[data-level-number]')!;
      const select = form.querySelector<HTMLSelectElement>('[data-build-select]')!;
      form.hidden = false;
      this.querySelector<HTMLElement>('[data-result]')!.hidden = false;
      this.querySelector<HTMLElement>('[data-fallback]')!.hidden = true;
      range.value = number.value = String(this.level);
      select.value = this.buildId;

      const update = (level: number | undefined) => {
        if (level === undefined) return;
        this.level = level;
        range.value = number.value = String(level);
        this.render(true);
      };
      range.addEventListener('input', () => update(parseLevel(range.value)));
      number.addEventListener('change', () => update(parseLevel(number.value)));
      select.addEventListener('change', () => {
        this.buildId = select.value;
        this.render(true);
      });
      form.addEventListener('submit', (event) => event.preventDefault());
      document.addEventListener(TALENTED_EVENT, () => this.render(false));
      this.render(false);
    }

    private el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    /** A spell or talent name with its tooltip (same markup as SpellRef.astro). */
    private spellRef(ref: Ref, text = ref.label) {
      if (!ref.key) return document.createTextNode(text);
      const span = this.el('span', `spell-ref school-${ref.school}`, text);
      span.dataset.spell = ref.key;
      span.tabIndex = 0;
      return span;
    }

    private stepBlock(step: LevelStep, plan: Payload['plans'][number], talented: boolean, main: boolean) {
      const { strings } = this.data;
      const block = this.el('section', main ? 'lv-step lv-step--main' : 'lv-step');
      const title = this.el(main ? 'h2' : 'h3', 'lv-step__title', strings['levelTitle']!.replace('{level}', String(step.level)));
      block.append(title);

      const spells = this.el('div', 'lv-step__part');
      spells.append(this.el('p', 'lv-step__label', strings['spells']));
      if (step.spells.length === 0 && step.ranks.length === 0) {
        spells.append(this.el('p', 'lv-step__empty', strings['noSpells']));
      } else {
        const list = this.el('ul', 'lv-step__list');
        for (const name of step.spells) {
          const li = this.el('li');
          li.append(this.spellRef(this.data.spells[name] ?? { label: name }));
          list.append(li);
        }
        for (const r of step.ranks) {
          const li = this.el('li');
          li.append(this.spellRef(this.data.spells[r.spell] ?? { label: r.spell }, this.data.ranks[`${r.spell}#${r.rank}`] ?? r.spell));
          list.append(li);
        }
        spells.append(list);
      }
      block.append(spells);

      const talent = this.el('div', 'lv-step__part');
      if (step.point) {
        const info = this.data.talents[step.point.talent]!;
        talent.append(this.el('p', 'lv-step__label', strings['point']!.replace('{point}', String(step.point.point))));
        const line = this.el('p', 'lv-step__talent');
        line.append(this.spellRef(info), ` ${step.point.rank}/${info.maxRank}`);
        if (step.point.extra) line.append(' ', this.el('span', 'chip lv-step__extra', strings['extra']));
        talent.append(line);
        const note = plan.notes[String(step.point.point)];
        if (note && main) talent.append(this.el('p', 'lv-step__note', note));
      } else {
        const first = talented ? 5 : 10;
        const text =
          step.level < first
            ? strings['beforeTalents']!.replace('{first}', String(first))
            : step.level - first + 1 > plan.build.order.length || (!talented && step.level - first + 1 > plan.build.basePoints)
              ? strings['afterBuild']!
              : strings['noPoint']!;
        talent.append(this.el('p', 'lv-step__empty', text));
      }
      block.append(talent);
      return block;
    }

    private render(updateUrl: boolean) {
      const plan = this.data.plans.find((p) => p.id === this.buildId) ?? this.data.plans[0]!;
      const talented = readTalented();
      const steps = levelPlan(plan.build, this.data.rows, this.level, talented);
      const result = this.querySelector<HTMLElement>('[data-result]')!;
      result.replaceChildren();
      const [main, ...next] = steps;
      if (main) result.append(this.stepBlock(main, plan, talented, true));
      if (next.length > 0) {
        const ahead = this.el('div', 'lv-next');
        ahead.append(this.el('p', 'lv-next__title', this.data.strings['next']));
        for (const step of next) ahead.append(this.stepBlock(step, plan, talented, false));
        result.append(ahead);
      }
      const actions = this.el('p', 'lv-actions');
      const full = this.el('a', 'button', this.data.strings['full']);
      full.href = plan.url;
      const copy = this.el('button', 'button', this.data.strings['copy']);
      copy.type = 'button';
      copy.addEventListener('click', async () => {
        const ok = await copyText(location.href);
        showToast(ok ? this.data.strings['copied']! : this.data.strings['copyFailed']!);
      });
      actions.append(full, copy);
      result.append(actions);
      if (updateUrl) {
        const params = new URLSearchParams(location.search);
        params.delete('nivel');
        params.delete('level');
        params.set(this.data.param, String(this.level));
        params.set('build', plan.id);
        history.replaceState(null, '', `${location.pathname}?${params}${location.hash}`);
      }
    }
  }

  customElements.define('level-view', LevelView);
</script>

<style>
  level-view {
    display: grid;
    gap: var(--space-4);
  }
  .lv-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .lv-controls[hidden],
  .lv-result[hidden],
  .lv-fallback[hidden] {
    display: none;
  }
  .lv-field {
    display: grid;
    gap: var(--space-1);
    min-width: min(100%, 14rem);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-muted);
  }
  .lv-level {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .lv-level input[type='range'] {
    flex: 1;
    min-width: 8rem;
    accent-color: var(--accent);
  }
  .lv-level input[type='number'] {
    width: 4.5rem;
    min-height: 40px;
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-1);
    color: var(--text);
    font: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .lv-field select {
    min-height: 40px;
    max-width: 100%;
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-1);
    color: var(--text);
    font: inherit;
    font-weight: 500;
  }
  .lv-result {
    display: grid;
    gap: var(--space-4);
  }
  .lv-result :global(.lv-step) {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .lv-result :global(.lv-step--main) {
    border-top: 4px solid var(--frost);
  }
  .lv-result :global(.lv-step__title) {
    margin: 0;
    font-size: var(--step-2);
  }
  .lv-result :global(.lv-next .lv-step__title) {
    font-size: var(--step-1);
  }
  .lv-result :global(.lv-step__label) {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .lv-result :global(.lv-step__list) {
    margin: var(--space-1) 0 0;
    padding-left: 1.2em;
  }
  .lv-result :global(.lv-step__talent),
  .lv-result :global(.lv-step__empty),
  .lv-result :global(.lv-step__note) {
    margin: var(--space-1) 0 0;
  }
  .lv-result :global(.lv-step__talent) {
    font-weight: 650;
  }
  .lv-result :global(.lv-step__empty),
  .lv-result :global(.lv-step__note) {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .lv-result :global(.lv-step__extra) {
    border-color: var(--baseline);
    color: var(--baseline);
  }
  .lv-result :global(.lv-next) {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .lv-result :global(.lv-next__title) {
    grid-column: 1 / -1;
    margin: 0;
    font-weight: 700;
    color: var(--text-muted);
  }
  .lv-result :global(.lv-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .lv-fallback__note {
    margin: 0 0 var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>

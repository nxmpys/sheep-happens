---
/**
 * The point order of a leveling build as a table: the level of each point, the
 * talent and rank reached, and why the key points go there. Consecutive points
 * in the same talent are grouped ("10–14 · Improved Frostbolt 5/5").
 *
 * One level column. The "I have Talented 5/5" switch (TalentedToggle, saved for
 * the whole site) swaps it to the levels with Talented and shows the extra
 * "Talented only" rows. Without JavaScript the table shows the levels without
 * Talented, which is what a first character at launch has.
 */
import BuildLink from './BuildLink.astro';
import SpellRef from './SpellRef.astro';
import TalentedToggle from './TalentedToggle.astro';
import { tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';
import { getBuild, talents } from '../../lib/data';
import { localName } from '../../lib/names';
import type { Build } from '../../lib/schemas';
import { levelForPoint, orderSteps, pointsAtLevel } from '../../lib/talents';

interface Props {
  build: Build;
}

const { build } = Astro.props;
const locale = getLocale(Astro);
const order = build.order ?? [];
const base = pointsAtLevel(build.level, build.legacyTalented);
const steps = orderSteps(order, talents, base);
// A build that already assumes Talented shows its own levels, with no switch.
const switchable = build.legacyTalented === 0;
const span = (from: number, to: number) => (from === to ? String(from) : `${from}–${to}`);
const notesFor = (from: number, to: number) => build.orderNotes.filter((n) => n.point >= from && n.point <= to);
const intro =
  order.length > base
    ? tb(locale, 'build.orderIntro', { points: base, level: build.level, talented: order.length })
    : tb(locale, 'build.orderIntroNoExtra', { points: base, level: build.level });
---

<div class="talent-order">
  <p class="talent-order__intro">{intro}</p>
  {switchable && <TalentedToggle />}
  <div class="table-wrap" tabindex="0" role="region" aria-label={tb(locale, 'build.orderCaption', { name: build.name[locale] })}>
    <table>
      <caption class="visually-hidden">{tb(locale, 'build.orderCaption', { name: build.name[locale] })}</caption>
      <thead>
        <tr>
          <th scope="col">
            {tb(locale, 'build.orderLevel')}
            {switchable && <span class="lv-talented"> ({tb(locale, 'build.orderWithTalented')})</span>}
          </th>
          <th scope="col">{tb(locale, 'build.orderTalent')}</th>
        </tr>
      </thead>
      <tbody>
        {
          steps.map((step) => {
            const extra = step.from > base;
            const label = localName(step.talent, locale);
            return (
              <>
                {extra && step.from === base + 1 && (
                  <tr class="talent-order__divider is-extra">
                    <th scope="colgroup" colspan="2">
                      {tb(locale, 'build.orderExtraHeading')}
                    </th>
                  </tr>
                )}
                <tr class:list={[`school-${step.talent.tree}`, { 'is-extra': extra }]}>
                  <th scope="row" class="talent-order__level">
                    {switchable ? (
                      <>
                        {!extra && <span class="lv-base">{span(levelForPoint(step.from), levelForPoint(step.to))}</span>}
                        <span class="lv-talented">{span(levelForPoint(step.from, 5), levelForPoint(step.to, 5))}</span>
                      </>
                    ) : (
                      span(levelForPoint(step.from, build.legacyTalented), levelForPoint(step.to, build.legacyTalented))
                    )}
                    {extra && <span class="talent-order__only">{tb(locale, 'build.orderExtra')}</span>}
                  </th>
                  <td>
                    <span class="talent-order__talent">
                      <SpellRef name={step.talent.name} label={label} />{' '}
                      <span class="talent-order__rank">
                        {step.toRank}/{step.talent.maxRank}
                      </span>
                    </span>
                    {notesFor(step.from, step.to).map((note) => (
                      <span class="talent-order__note">
                        {note.text[locale]}{' '}
                        {note.build && <BuildLink id={note.build}>{getBuild(note.build).name[locale]}</BuildLink>}
                      </span>
                    ))}
                  </td>
                </tr>
              </>
            );
          })
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .talent-order {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  .talent-order__intro {
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  th,
  td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    background: var(--surface-2);
    color: var(--text-muted);
    font-weight: 700;
    white-space: nowrap;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody tr:not(.talent-order__divider) > :first-child {
    border-left: 3px solid var(--school);
  }
  .talent-order__level {
    width: 1%;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .talent-order__talent {
    font-weight: 600;
  }
  .talent-order__rank {
    margin-left: 0.15em;
    color: var(--school);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .talent-order__note {
    display: block;
    margin-top: var(--space-1);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .talent-order__divider th {
    background: var(--baseline-soft);
    color: var(--baseline);
    font-weight: 700;
  }
  .is-extra {
    background: color-mix(in srgb, var(--baseline-soft) 45%, transparent);
  }
  .talent-order__only {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--baseline);
    white-space: normal;
  }
  /* Without the switch on: levels without Talented, no extra rows. */
  .lv-talented,
  .is-extra {
    display: none;
  }
  :global(html[data-talented]) .lv-talented {
    display: inline;
  }
  :global(html[data-talented]) .lv-base {
    display: none;
  }
  :global(html[data-talented]) .is-extra {
    display: table-row;
  }
  @media (max-width: 520px) {
    th,
    td {
      padding: var(--space-2);
    }
    thead th {
      white-space: normal;
    }
  }
</style>

---
/**
 * Best races per situation and faction (src/data/race-picks.json). The races
 * page shows the reasons; the «Elige» hub only the answer, with a link to them.
 * Column headers are the faction names, which the faction filter reads.
 */
import { FACTION_LABELS } from '../../i18n/builds';
import { getLocale, href } from '../../i18n/locale';
import { racePicks, races } from '../../lib/data';

interface Props {
  /** Without the «Why» column: for the hub page. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const factions = FACTION_LABELS[locale];
// "Cielonato (Skyborne)" the first time in the table, "Cielonato" afterwards.
const seen = new Set<string>();
const raceName = (id: string) => {
  const full = races.find((r) => r.id === id)?.name[locale] ?? id;
  const short = full.replace(/\s*\(.*\)$/, '');
  if (seen.has(id)) return short;
  seen.add(id);
  return locale === 'es' ? full : short;
};
const names = (ids: readonly string[]) => ids.map(raceName).join(' · ');
---

<div class="table-wrap" tabindex="0" role="region" aria-label={es ? 'Mejor raza por situación' : 'Best race by situation'}>
  <table>
    <thead>
      <tr>
        <th scope="col">{es ? 'Para' : 'For'}</th>
        <th scope="col">{factions.alliance}</th>
        <th scope="col">{factions.horde}</th>
        {!compact && <th scope="col">{es ? 'Por qué' : 'Why'}</th>}
      </tr>
    </thead>
    <tbody>
      {
        racePicks.map((pick) => (
          <tr>
            <th scope="row">{pick.situation[locale]}</th>
            <td>{names(pick.alliance)}</td>
            <td>{names(pick.horde)}</td>
            {!compact && <td>{pick.why[locale]}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
{
  compact && (
    <p class="race-picks__more">
      <a href={href('races', locale)}>{es ? 'Por qué, y las raciales de cada raza' : 'Why, and every race’s racials'}</a>
    </p>
  )
}

<style>
  .race-picks__more {
    margin-top: var(--space-2);
    font-size: var(--step--1);
  }
</style>

---
/**
 * "Pick a talent → read its card" explorer for one tree.
 * Progressive enhancement: without JavaScript every card is listed in order;
 * the script turns the list into an accessible tab interface and keeps the
 * selected talent in the URL hash (#change-<id>) so it can be shared.
 */
import ChangeCard from './ChangeCard.astro';
import Icon from '../ui/Icon.astro';
import { getLocale } from '../../i18n/locale';
import { t, type UiKey } from '../../i18n/ui';
import { changesForTree } from '../../lib/data';
import { localName } from '../../lib/names';

interface Props {
  tree: 'arcane' | 'fire' | 'frost';
}

const { tree } = Astro.props;
const locale = getLocale(Astro);
const talents = changesForTree(tree).filter((c) => c.category === 'talent');
const label = t(locale, 'talents.explorer', { tree: t(locale, `tree.${tree}` as UiKey) });
---

<talent-explorer class={`school-${tree}`}>
  <div class="layout">
    <div class="tabs" data-tablist hidden aria-label={label} data-pagefind-ignore>
      {
        talents.map((talent) => (
          <button type="button" class="tab" data-tab={talent.id}>
            <span class="tab__name">
              {talent.milestone && <Icon name={tree} size={14} />}
              {localName(talent, locale)}
            </span>
            <span class="tab__meta">
              {talent.kinds.map((k) => t(locale, `kind.${k}` as UiKey)).join(' · ')}
            </span>
          </button>
        ))
      }
    </div>
    <div class="panels">
      {
        talents.map((talent) => (
          <div class="panel" data-panel={talent.id}>
            <ChangeCard change={talent} level="h3" showTree={false} />
          </div>
        ))
      }
    </div>
  </div>
</talent-explorer>

<script>
  class TalentExplorer extends HTMLElement {
    private tabs: HTMLButtonElement[] = [];
    private panels: HTMLElement[] = [];

    connectedCallback() {
      const list = this.querySelector<HTMLElement>('[data-tablist]')!;
      this.tabs = [...list.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      this.panels = [...this.querySelectorAll<HTMLElement>('[data-panel]')];
      if (this.tabs.length === 0) return;

      const uid = Math.random().toString(36).slice(2, 7);
      list.hidden = false;
      list.setAttribute('role', 'tablist');
      list.setAttribute('aria-orientation', 'vertical');
      this.tabs.forEach((tab, i) => {
        const panel = this.panels[i]!;
        tab.id = `tab-${uid}-${tab.dataset.tab}`;
        panel.id = `panel-${uid}-${tab.dataset.tab}`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        tab.addEventListener('click', () => this.select(i, { focus: false, updateHash: true }));
        tab.addEventListener('keydown', (event) => this.onKey(event, i));
      });
      this.classList.add('is-enhanced');

      const fromHash = this.indexForHash(location.hash);
      this.select(fromHash ?? 0, { focus: false, updateHash: false });
      if (fromHash !== undefined) this.scrollIntoView({ block: 'start' });

      window.addEventListener('hashchange', () => {
        const index = this.indexForHash(location.hash);
        if (index !== undefined) this.select(index, { focus: false, updateHash: false });
      });
    }

    private indexForHash(hash: string): number | undefined {
      const id = decodeURIComponent(hash.replace(/^#change-/, ''));
      const index = this.tabs.findIndex((tab) => tab.dataset.tab === id);
      return index === -1 ? undefined : index;
    }

    private select(index: number, { focus, updateHash }: { focus: boolean; updateHash: boolean }) {
      this.tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        this.panels[i]!.hidden = !selected;
      });
      const tab = this.tabs[index]!;
      if (focus) tab.focus();
      if (updateHash) history.replaceState(null, '', `#change-${tab.dataset.tab}`);
    }

    private onKey(event: KeyboardEvent, index: number) {
      const last = this.tabs.length - 1;
      const next: Record<string, number> = {
        ArrowDown: index === last ? 0 : index + 1,
        ArrowRight: index === last ? 0 : index + 1,
        ArrowUp: index === 0 ? last : index - 1,
        ArrowLeft: index === 0 ? last : index - 1,
        Home: 0,
        End: last,
      };
      if (event.key in next) {
        event.preventDefault();
        this.select(next[event.key]!, { focus: true, updateHash: true });
      }
    }
  }

  customElements.define('talent-explorer', TalentExplorer);
</script>

<style>
  talent-explorer {
    display: block;
  }
  .layout {
    display: grid;
    gap: var(--space-4);
  }
  .panels {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .panel[hidden] {
    display: none;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tabs[hidden] {
    display: none;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1em;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-1);
    text-align: left;
    cursor: pointer;
  }
  .tab:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .tab[aria-selected='true'] {
    border-color: var(--school);
    background: var(--school-soft);
    box-shadow: inset 3px 0 0 var(--school);
  }
  .tab__name {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-weight: 650;
    font-size: var(--step--1);
    color: var(--text);
  }
  .tab__name :global(svg) {
    color: var(--school);
  }
  .tab__meta {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  @media (min-width: 720px) {
    .is-enhanced .layout {
      grid-template-columns: minmax(12rem, 15rem) 1fr;
      align-items: start;
    }
    .tabs {
      flex-direction: column;
      flex-wrap: nowrap;
      position: sticky;
      top: calc(var(--header-h) + var(--space-4));
      max-height: calc(100vh - var(--header-h) - var(--space-6));
      overflow-y: auto;
      padding: 2px;
    }
    .tab {
      width: 100%;
    }
  }
</style>

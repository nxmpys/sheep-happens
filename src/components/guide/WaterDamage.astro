---
/**
 * Base damage per mana, Classic against Forever. `view`: the bar chart, its
 * source table, or the worked example with one piece of spell power gear.
 */
import Table from '../ui/Table.astro';
import SpellRef from './SpellRef.astro';
import VerifyTag from './VerifyTag.astro';
import { getLocale } from '../../i18n/locale';
import { mageWater } from '../../lib/data';
import { localSpellName } from '../../lib/names';
import { breakEvenSpellPower, byLoss, damageLoss, extraMana, formatNumber, formatPercent, spellDamage, spellPowerBonus, type DamageRange } from '../../lib/water';

interface Props {
  view: 'chart' | 'table' | 'example';
}

const { view } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const spells = byLoss(mageWater.spells);
const scale = Math.max(...spells.map(damageLoss));
const rankLabel = (rank: number) => (es ? `rango ${rank}` : `rank ${rank}`);
const range = (r: DamageRange) => `${r.min === r.max ? formatNumber(r.min, locale) : `${formatNumber(r.min, locale)}–${formatNumber(r.max, locale)}`}${r.dot ? ` + ${r.dot}` : ''}`;
const pct = (value: number, digits = 0) => formatPercent(value, locale, digits);
const summary = es
  ? `Mayor pérdida: ${localSpellName(spells[0]!.name, locale)} ${rankLabel(spells[0]!.rank)}, ${pct(damageLoss(spells[0]!))}. Menor: ${localSpellName(spells.at(-1)!.name, locale)} ${rankLabel(spells.at(-1)!.rank)}, ${pct(damageLoss(spells.at(-1)!))}. Los valores de todas las barras están escritos al lado y en la tabla siguiente.`
  : `Largest loss: ${spells[0]!.name} ${rankLabel(spells[0]!.rank)}, ${pct(damageLoss(spells[0]!))}. Smallest: ${spells.at(-1)!.name} ${rankLabel(spells.at(-1)!.rank)}, ${pct(damageLoss(spells.at(-1)!))}. Every bar has its value next to it and in the table below.`;
const example = mageWater.spellPowerExample;
const fireballTop = mageWater.spells.find((s) => s.name === 'Fireball' && s.rank === 12)!;
const fireballWithDot = damageLoss({ ...fireballTop, countDot: true });
---

{
  view === 'chart' && (
    <figure class="chart">
      <figcaption class="chart__title">{es ? 'Daño base por maná que se pierde frente a Classic' : 'Base damage per mana lost against Classic'}</figcaption>
      <ul class="bars">
        {spells.map((spell) => {
          const loss = damageLoss(spell);
          return (
            <li class="bar" title={`Classic ${range(spell.classic)} → Forever ${range(spell.forever)} · ${spell.cost} ${es ? 'de maná' : 'mana'}`}>
              <span class="bar__label">
                <SpellRef name={spell.name} label={localSpellName(spell.name, locale)} /> <span class="bar__rank">{rankLabel(spell.rank)}</span>
              </span>
              <span class="bar__track" aria-hidden="true">
                <span class="bar__fill" style={`width:${(loss / scale) * 100}%`} />
              </span>
              <span class="bar__value">−{pct(loss)}</span>
            </li>
          );
        })}
      </ul>
      <p class="chart__desc">{summary}</p>
    </figure>
  )
}

{
  view === 'table' && (
    <>
      <Table>
        <caption class="visually-hidden">{es ? 'Daño de cada hechizo en Classic y en Forever, con su pérdida, el maná extra y el daño de hechizos para igualar' : 'Damage of each spell in Classic and Forever, with its loss, the extra mana and the spell damage to match'}</caption>
        <thead>
          <tr>
            <th scope="col">{es ? 'Hechizo' : 'Spell'}</th>
            <th scope="col">{es ? 'Maná' : 'Mana'}</th>
            <th scope="col">Classic</th>
            <th scope="col">Forever</th>
            <th scope="col">{es ? 'Pérdida' : 'Loss'}</th>
            <th scope="col">{es ? 'Maná extra, mismo daño' : 'Extra mana, same damage'}</th>
            <th scope="col">Coef.</th>
            <th scope="col">{es ? 'Daño de hechizos para igualar' : 'Spell damage to match'}</th>
          </tr>
        </thead>
        <tbody>
          {spells.map((spell) => {
            const loss = damageLoss(spell);
            const even = breakEvenSpellPower(spell);
            return (
              <tr>
                <th scope="row">
                  <SpellRef name={spell.name} label={localSpellName(spell.name, locale)} /> <span class="rank">{spell.rank}</span>
                </th>
                <td>{formatNumber(spell.cost, locale)}</td>
                <td class="nowrap">{range(spell.classic)}</td>
                <td class="nowrap">{range(spell.forever)}</td>
                <td class="nowrap"><strong class="delta">−{pct(loss)}</strong></td>
                <td class="nowrap">+{pct(extraMana(loss))}</td>
                <td class="nowrap">{spell.coefficient ? pct(spell.coefficient, 1) : '—'}</td>
                <td>{even === undefined ? <VerifyTag /> : formatNumber(even, locale)}</td>
              </tr>
            );
          })}
        </tbody>
      </Table>
      <p class="note">
        {es
          ? `Puntos medios de cada rango. El «+» es el daño en el tiempo; solo cuenta en Piroexplosión, donde pesa de verdad. Bola de Fuego de rango 12 con el suyo pierde un ${pct(fireballWithDot)}.`
          : `Range midpoints. The “+” is damage over time; it only counts on Pyroblast, where it really matters. Fireball rank 12 with its own loses ${pct(fireballWithDot)}.`}
      </p>
    </>
  )
}

{
  view === 'example' && (
    <Table>
      <caption class="visually-hidden">{es ? 'Cuánto de la diferencia cubre +13 al daño de hechizos en dos hechizos' : 'How much of the gap +13 spell damage covers on two spells'}</caption>
      <thead>
        <tr>
          <th scope="col">{es ? 'Hechizo' : 'Spell'}</th>
          <th scope="col">Base, Classic</th>
          <th scope="col">Base, Forever</th>
          <th scope="col">{es ? 'Diferencia' : 'Gap'}</th>
          <th scope="col">{es ? `Con +${example.spellPower} al daño de hechizos` : `With +${example.spellPower} spell damage`}</th>
          <th scope="col">{es ? 'Cubre' : 'Covers'}</th>
        </tr>
      </thead>
      <tbody>
        {example.spells.map((spell) => {
          const before = spellDamage(spell.classic);
          const after = spellDamage(spell.forever);
          const bonus = spellPowerBonus(example.spellPower, spell.coefficient!);
          return (
            <tr>
              <th scope="row">
                <SpellRef name={spell.name} label={localSpellName(spell.name, locale)} /> <span class="rank">{spell.rank}</span>
              </th>
              <td>{formatNumber(before, locale, 1)}</td>
              <td>{formatNumber(after, locale, 1)}</td>
              <td>−{formatNumber(before - after, locale, 1)}</td>
              <td>+{formatNumber(bonus, locale, 1)}</td>
              <td><strong>{pct((bonus / (before - after)) * 100)}</strong></td>
            </tr>
          );
        })}
      </tbody>
    </Table>
  )
}

<style>
  .chart {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .chart__title {
    font-weight: 700;
  }
  .chart__desc,
  .note {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .bars {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px var(--space-3);
    align-items: center;
    padding: 2px 0;
  }
  .bar:hover {
    background: var(--surface-2);
  }
  .bar__label {
    min-width: 0;
    font-size: var(--step--1);
  }
  .bar__rank {
    color: var(--text-subtle);
  }
  .bar__track {
    grid-column: 1;
    display: block;
    height: 10px;
  }
  .bar__fill {
    display: block;
    height: 100%;
    border-radius: 0 4px 4px 0;
    background: var(--accent);
  }
  .bar__value {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: var(--step--1);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  @media (min-width: 40rem) {
    .bar {
      grid-template-columns: 13rem minmax(0, 1fr) 3.5rem;
    }
    .bar__track {
      grid-column: 2;
    }
    .bar__value {
      grid-column: 3;
      grid-row: 1;
    }
  }
  .rank {
    color: var(--text-subtle);
  }
  .delta {
    color: var(--nerf);
  }
  .nowrap {
    white-space: nowrap;
  }
</style>

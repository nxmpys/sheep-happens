---
/**
 * One part of an addon's presentation, placed under its heading in the MDX page
 * (headings stay in Markdown so they show in the page index):
 *   ## Procs que avisa
 *   <AddonDetail id="mageprocs" part="procs" />
 * Parts: gallery (its published images, enlarged in a dialog on click, plus the
 * addon's structured data for search engines), procs (one line per proc), install (steps, download link and
 * commands) and limits. Data: src/data/addons.json.
 */
import Icon from '../ui/Icon.astro';
import { getLocale } from '../../i18n/locale';
import { SPEC_LABELS, ta } from '../../i18n/addons';
import { getAddon } from '../../lib/data';
import { addonJsonLd } from '../../lib/seo';

interface Props {
  id: string;
  part: 'gallery' | 'procs' | 'install' | 'limits';
}

const { id, part } = Astro.props;
const locale = getLocale(Astro);
const addon = getAddon(id);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
const site = Astro.site ?? new URL('https://sheephappens.app');
const jsonLd =
  part === 'gallery'
    ? addonJsonLd(addon, locale, {
        pageUrl: new URL(Astro.url.pathname, site).href,
        siteUrl: new URL(base, site).href,
        asset: (path) => new URL(asset(path), site).href,
      })
    : undefined;
const live = addon.listing === 'live';
---

{
  part === 'gallery' && (
    <div class="addon-gallery" role="group" aria-label={ta(locale, 'gallery.title')}>
      {addon.screenshots.map((shot, index) => (
        <figure>
          <a href={asset(shot.src)} data-lightbox-open>
            <img
              src={asset(shot.src)}
              width={shot.width}
              height={shot.height}
              alt={shot.alt[locale]}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="visually-hidden">{ta(locale, 'gallery.open')}</span>
          </a>
          <figcaption>{shot.caption[locale]}</figcaption>
        </figure>
      ))}
      <dialog class="lightbox" aria-label={ta(locale, 'gallery.title')} data-lightbox>
        <button type="button" class="icon-button lightbox__close" data-lightbox-close>
          <Icon name="close" size={22} />
          <span class="visually-hidden">{ta(locale, 'gallery.close')}</span>
        </button>
        <figure>
          <img alt="" data-lightbox-img />
          <figcaption data-lightbox-caption />
        </figure>
      </dialog>
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </div>
  )
}

{
  part === 'procs' && (
    <ul class="addon-procs" aria-label={ta(locale, 'procs.caption', { name: addon.name })}>
      {addon.procs.map((proc) => (
        <li class={`school-${proc.spec}`}>
          <Icon name={proc.spec} size={18} />
          <span>
            <span class="addon-procs__name">{proc.name[locale]}</span>
            {locale === 'es' && proc.name.es !== proc.name.en && (
              <span class="addon-procs__en" lang="en">
                {' '}({proc.name.en})
              </span>
            )}
            <span class="visually-hidden"> · {SPEC_LABELS[locale][proc.spec]}</span>
            {proc.on && <span class="chip addon-procs__on">{ta(locale, 'procs.on')}</span>}
            <span class="addon-procs__what">{proc.what[locale]}</span>
          </span>
        </li>
      ))}
    </ul>
  )
}

{
  part === 'install' && (
    <div class="addon-install">
      <ol class="addon-install__steps" aria-label={ta(locale, 'install.steps')}>
        {addon.install.map((step) => (
          <li>{step[locale]}</li>
        ))}
      </ol>
      {live && (
        <p>
          <a href={addon.url} target="_blank" rel="noopener noreferrer">
            {ta(locale, 'link.download', { name: addon.name, host: addon.host })}
            <Icon name="external" size={13} />
            <span class="visually-hidden">{ta(locale, 'newTab')}</span>
          </a>
        </p>
      )}
      {addon.commands.length > 0 && (
        <div class="table-wrap" tabindex="0" role="region" aria-label={ta(locale, 'install.commands')}>
          <table>
            <caption class="visually-hidden">{ta(locale, 'install.commands')}</caption>
            <thead>
              <tr>
                <th scope="col">{ta(locale, 'install.command')}</th>
                <th scope="col">{ta(locale, 'install.what')}</th>
              </tr>
            </thead>
            <tbody>
              {addon.commands.map((command) => (
                <tr>
                  <td>
                    <code>{command.command}</code>
                  </td>
                  <td>{command.what[locale]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )
}

{
  part === 'limits' && addon.limitations.length > 0 && (
    <ul>
      {addon.limitations.map((item) => (
        <li>{item[locale]}</li>
      ))}
    </ul>
  )
}

<script>
  // Gallery images open enlarged in a dialog on the same page. Without JS, or with
  // Ctrl/Cmd/Shift/middle click, the link still opens the image file itself.
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let opener: HTMLElement | null = null;

    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-open]')) {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const thumb = link.querySelector('img');
        image.src = link.href;
        image.alt = thumb?.alt ?? '';
        caption.textContent = link.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
        opener = link;
        dialog.showModal();
      });
    }

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    // A click outside the image (on the backdrop or the empty dialog area) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === dialog.querySelector('figure')) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: var(--space-6) var(--space-4);
    border: 0;
    background: transparent;
    color: #ecebf4;
  }
  .lightbox::backdrop {
    background: rgb(5 4 12 / 0.85);
    backdrop-filter: blur(2px);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox figure {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-3);
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .lightbox img {
    display: block;
    max-width: min(100%, 1600px);
    max-height: calc(100vh - 8rem);
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .lightbox figcaption {
    max-width: 46rem;
    text-align: center;
    font-size: var(--step--1);
  }
  .lightbox__close {
    position: fixed;
    top: var(--space-3);
    right: var(--space-3);
    background: rgb(22 20 35 / 0.9);
    color: #ecebf4;
    border-color: #6f6897;
  }
  .lightbox__close:hover {
    background: #272338;
    color: #ffffff;
  }
  .addon-gallery a {
    cursor: zoom-in;
  }

  .addon-gallery {
    display: grid;
    gap: var(--space-5);
  }
  .addon-gallery figure {
    margin: 0;
  }
  .addon-gallery a {
    display: block;
  }
  .addon-gallery img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #0e0d16;
  }
  .addon-gallery figcaption {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .addon-procs {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .addon-procs li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
  }
  .addon-procs li > :global(svg) {
    flex: none;
    margin-top: 0.25em;
    color: var(--school);
  }
  .addon-procs__name {
    font-weight: 700;
  }
  .addon-procs__en {
    color: var(--text-subtle);
    font-size: var(--step--1);
  }
  .addon-procs__on {
    margin-left: var(--space-2);
    border-color: var(--status-verified);
    color: var(--text);
    font-weight: 600;
  }
  .addon-procs__what {
    display: block;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .addon-install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .addon-install p,
  .addon-install__steps {
    margin: 0;
  }
  .addon-install__steps {
    /* Folder paths such as Interface\AddOns have no spaces to break at. */
    overflow-wrap: anywhere;
  }
  .addon-install a :global(svg) {
    margin-left: 0.15em;
    vertical-align: -0.1em;
  }
  .addon-install code {
    white-space: nowrap;
  }
</style>

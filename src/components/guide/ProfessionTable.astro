---
/**
 * Comparison of the primary professions: icon, main benefit and our
 * rating per activity. On narrow screens each row stacks (profession first,
 * the five ratings below), so nothing scrolls sideways; the explicit ARIA roles
 * keep it a table for screen readers. Data in professions.json.
 */
import RatingBadge from './RatingBadge.astro';
import GameIcon from '../learn/GameIcon.astro';
import '../../styles/learn.css';
import { getLocale } from '../../i18n/locale';
import { tp, type ProfessionUiKey } from '../../i18n/professions';
import { professions } from '../../lib/data';
import { PROFESSION_ICONS, primaryProfessions, professionAnchor } from '../../lib/professions';

const locale = getLocale(Astro);
const rows = primaryProfessions(professions);
const COLUMNS = ['pve', 'pvp', 'leveling', 'economy', 'overall'] as const;
const label = (column: (typeof COLUMNS)[number]) => tp(locale, `rating.${column}` as ProfessionUiKey);
const caption = tp(locale, 'table.caption');
---

<div class="table-wrap profession-table" tabindex="0" role="region" aria-label={caption}>
  <table role="table">
    <caption class="visually-hidden">{caption}</caption>
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">{tp(locale, 'table.profession')}</th>
        {
          COLUMNS.map((column) => (
            <th scope="col" role="columnheader">
              {label(column)}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        rows.map((profession) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              <a class="profession-table__name" href={`#${professionAnchor(profession, locale)}`}>
                <GameIcon icon={PROFESSION_ICONS[profession.id]} size={32} />
                {profession.name[locale]}
              </a>
              <span class="profession-table__line">{profession.benefit[locale]}</span>
            </th>
            {COLUMNS.map((column) => (
              <td role="cell" data-label={label(column)}>
                <RatingBadge value={profession.ratings![column]} />
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .profession-table th[scope='row'] {
    width: 55%;
    font-weight: 400;
  }
  .profession-table th[scope='row'] > span {
    display: block;
    margin-top: var(--space-1);
  }
  .profession-table__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: var(--step-0);
  }
  .profession-table__line {
    color: var(--text-muted);
  }
  /* Rating columns shrink to their badge; the profession column takes the rest. */
  .profession-table td,
  .profession-table thead th:not(:first-child) {
    width: 1%;
    white-space: nowrap;
    vertical-align: middle;
  }

  @media (max-width: 40rem) {
    .profession-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .profession-table tbody tr {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-bottom: 1px solid var(--border);
    }
    .profession-table tbody tr:last-child {
      border-bottom: 0;
    }
    .profession-table th[scope='row'] {
      width: auto;
      grid-column: 1 / -1;
      border-bottom: 0;
      background: transparent;
    }
    .profession-table td {
      display: grid;
      justify-items: center;
      align-content: start;
      gap: var(--space-1);
      width: auto;
      padding: 0 2px var(--space-3);
      border-bottom: 0;
      text-align: center;
    }
    .profession-table td::before {
      content: attr(data-label);
      font-size: 0.75rem;
      font-weight: 650;
      color: var(--text-muted);
    }
    .profession-table td :global(.rating) {
      gap: 0.25em;
      padding-inline: 0.4em;
      font-size: 0.75rem;
    }
  }
</style>

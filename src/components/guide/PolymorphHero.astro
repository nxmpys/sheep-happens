---
/**
 * Home hero: an animated arcane circle with a sheep in the middle. Clicking the
 * sheep casts Polymorph: sheep → pig → turtle → sheep, with a burst of light and
 * a per-visit counter (kept in memory only). With «reduce motion» the rings and
 * the parallax stay still and the click just swaps the form.
 *
 * Easter eggs by number of casts: 10 a rare form (penguin), 25 a rain of sheep,
 * 50 the legendary golden sheep (rare-elite frame) and 100 diminishing returns:
 * the sheep is immune for 18 s, as in the game; then the counter goes back to 0
 * and the eggs come round again.
 */
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** Page title for Pagefind, now that the h1 is the site name. */
  pageTitle: string;
}

const { locale, pageTitle } = Astro.props;
const forms = ['sheep', 'pig', 'turtle', 'penguin', 'golden'] as const;
const formLabels = Object.fromEntries(forms.map((form) => [form, t(locale, `hero.form.${form}`)])) as Record<
  (typeof forms)[number],
  string
>;
const eggs = {
  rare: t(locale, 'hero.egg.rare'),
  rareTag: t(locale, 'hero.egg.rareTag'),
  rain: t(locale, 'hero.egg.rain'),
  golden: t(locale, 'hero.egg.golden'),
  immune: t(locale, 'hero.egg.immune', { s: '{s}' }),
  immuneHit: t(locale, 'hero.egg.immuneHit'),
};
const runes = ['ᚠ', 'ᚱ', 'ᛉ', 'ᛟ', 'ᚨ', 'ᛞ', 'ᛗ', 'ᚲ'];
// Runes on the outer ring, clockwise from the top, between r=76 and r=91.
const runePositions = runes.map((rune, i) => {
  const angle = (i * Math.PI) / 4;
  return { rune, x: (100 + 84 * Math.sin(angle)).toFixed(1), y: (100 - 84 * Math.cos(angle)).toFixed(1) };
});
---

<section
  class="polymorph"
  aria-labelledby="hero-title"
  data-polymorph
  data-pagefind-meta={`title:${pageTitle}`}
  data-labels={JSON.stringify(formLabels)}
  data-eggs={JSON.stringify(eggs)}
  data-form-template={t(locale, 'hero.form', { form: '{form}' })}
>
  <div class="polymorph__stage">
    <div class="polymorph__circle" data-parallax="circle" aria-hidden="true">
      <span class="polymorph__glow"></span>
      <svg class="polymorph__ring polymorph__ring--outer" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <circle cx="100" cy="100" r="96" fill="none" stroke="#8b6cff" stroke-width=".8" />
        <circle cx="100" cy="100" r="91" fill="none" stroke="#c9b0ff" stroke-width=".6" stroke-dasharray="1 3" />
        <g class="polymorph__runes" fill="#c9b0ff">
          {
            runePositions.map(({ rune, x, y }, i) => (
              <text x={x} y={y} style={`animation-delay: ${(-i * 0.375).toFixed(3)}s`}>
                {rune}
              </text>
            ))
          }
        </g>
      </svg>
      <svg class="polymorph__ring polymorph__ring--middle" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <g fill="none" stroke="#8b6cff" stroke-width=".8" stroke-linejoin="round">
          <circle cx="100" cy="100" r="76" />
          <polygon points="100,24 166,138 34,138" stroke="#c9b0ff" />
          <polygon points="100,176 34,62 166,62" stroke="#c9b0ff" />
        </g>
      </svg>
      <svg class="polymorph__ring polymorph__ring--inner" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <circle cx="100" cy="100" r="52" fill="none" stroke="#c9b0ff" stroke-width=".8" stroke-dasharray="6 4" />
        <g fill="#f2d48a">
          <circle cx="100" cy="48" r="2.4" />
          <circle cx="152" cy="100" r="2.4" />
          <circle cx="100" cy="152" r="2.4" />
          <circle cx="48" cy="100" r="2.4" />
        </g>
      </svg>
    </div>

    <div class="polymorph__critter" data-parallax="sheep">
      <div class="polymorph__float">
        <button type="button" class="polymorph__button" aria-label={t(locale, 'hero.cast')} data-cast>
          <svg class="polymorph__form" data-form="sheep" data-shown viewBox="0 0 230 170" role="img" aria-label={formLabels.sheep}>
            <ellipse cx="115" cy="160" rx="70" ry="7" fill="#000" opacity=".4" />
            <g fill="#2b2350"><rect x="80" y="118" width="10" height="34" rx="4" /><rect x="104" y="122" width="10" height="32" rx="4" /><rect x="132" y="122" width="10" height="32" rx="4" /><rect x="154" y="118" width="10" height="34" rx="4" /></g>
            <g fill="#f6f3ff"><circle cx="78" cy="88" r="24" /><circle cx="104" cy="72" r="27" /><circle cx="134" cy="74" r="26" /><circle cx="156" cy="92" r="22" /><circle cx="98" cy="104" r="22" /><circle cx="132" cy="106" r="22" /></g>
            <ellipse cx="178" cy="92" rx="19" ry="16" fill="#2b2350" />
            <ellipse cx="166" cy="80" rx="8" ry="4" fill="#2b2350" transform="rotate(-30 166 80)" />
            <circle cx="183" cy="88" r="3.2" fill="#f6f3ff" /><circle cx="184" cy="88" r="1.6" fill="#120e2a" />
          </svg>
          <svg class="polymorph__form" data-form="pig" viewBox="0 0 230 170" role="img" aria-label={formLabels.pig}>
            <ellipse cx="115" cy="160" rx="70" ry="7" fill="#000" opacity=".4" />
            <g fill="#d98aa0"><rect x="76" y="118" width="12" height="34" rx="4" /><rect x="150" y="118" width="12" height="34" rx="4" /></g>
            <ellipse cx="116" cy="98" rx="66" ry="44" fill="#f4a9bd" />
            <circle cx="178" cy="88" r="26" fill="#f4a9bd" />
            <ellipse cx="198" cy="94" rx="11" ry="9" fill="#e48aa2" />
            <circle cx="195" cy="94" r="2" fill="#7a3346" /><circle cx="202" cy="94" r="2" fill="#7a3346" />
            <circle cx="180" cy="78" r="3" fill="#2b1530" />
            <path d="M166 62 l-6 -14 l14 6 z" fill="#e48aa2" />
            <path d="M50 92 q-14 -4 -8 -14 q6 -8 10 2" stroke="#e48aa2" stroke-width="4" fill="none" stroke-linecap="round" />
          </svg>
          <svg class="polymorph__form" data-form="turtle" viewBox="0 0 230 170" role="img" aria-label={formLabels.turtle}>
            <ellipse cx="116" cy="160" rx="74" ry="7" fill="#000" opacity=".4" />
            <g fill="#7fb85a">
              <rect x="88" y="112" width="20" height="34" rx="10" />
              <rect x="128" y="112" width="20" height="34" rx="10" />
              <path d="M44 112 l-16 4 l14 8 z" />
              <rect x="176" y="98" width="24" height="20" rx="10" />
            </g>
            <path d="M40 118 C40 44 188 44 188 118 Z" fill="#3e8a57" />
            <g fill="#5fb072">
              <path d="M114 66 l20 12 v22 l-20 12 l-20 -12 v-22 z" />
              <path d="M86 78 v26 l-14 10 h-24 q2 -24 22 -38 z" />
              <path d="M142 78 v26 l14 10 h24 q-2 -24 -22 -38 z" />
            </g>
            <rect x="34" y="110" width="160" height="14" rx="7" fill="#2e6b43" />
            <g fill="#a8d672">
              <rect x="54" y="116" width="24" height="38" rx="12" />
              <rect x="150" y="116" width="24" height="38" rx="12" />
              <circle cx="200" cy="92" r="21" />
            </g>
            <circle cx="205" cy="86" r="7" fill="#f6f3ff" />
            <circle cx="206.5" cy="86.5" r="4.3" fill="#14210f" />
            <circle cx="208" cy="84.6" r="1.6" fill="#f6f3ff" />
            <ellipse cx="212" cy="98" rx="4.5" ry="2.6" fill="#f08a8a" opacity=".55" />
            <path d="M201 101 q8 6 16 -1" stroke="#2e6b43" stroke-width="2.4" fill="none" stroke-linecap="round" />
          </svg>
          <svg class="polymorph__form" data-form="penguin" viewBox="0 0 230 170" role="img" aria-label={formLabels.penguin}>
            <ellipse cx="118" cy="160" rx="56" ry="7" fill="#000" opacity=".4" />
            <g fill="#f2a93b">
              <ellipse cx="104" cy="154" rx="14" ry="6" />
              <ellipse cx="134" cy="154" rx="14" ry="6" />
            </g>
            <ellipse cx="78" cy="104" rx="11" ry="28" fill="#232845" transform="rotate(18 78 104)" />
            <ellipse cx="118" cy="98" rx="44" ry="56" fill="#2b3157" />
            <ellipse cx="126" cy="108" rx="30" ry="42" fill="#f6f3ff" />
            <circle cx="134" cy="66" r="7" fill="#f6f3ff" />
            <circle cx="136" cy="66.5" r="4" fill="#120e2a" />
            <circle cx="137.4" cy="64.8" r="1.4" fill="#f6f3ff" />
            <path d="M150 72 l20 6 l-20 7 z" fill="#f2a93b" />
            <ellipse cx="146" cy="88" rx="5" ry="3" fill="#f4a9bd" opacity=".7" />
            <ellipse cx="152" cy="108" rx="9" ry="24" fill="#232845" transform="rotate(-14 152 108)" />
          </svg>
          <svg class="polymorph__form polymorph__form--golden" data-form="golden" viewBox="0 0 230 170" role="img" aria-label={formLabels.golden}>
            <defs>
              <linearGradient id="golden-wool" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#fff1b8" />
                <stop offset="1" stop-color="#e0a82e" />
              </linearGradient>
              <linearGradient id="elite-silver" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f1f3f8" />
                <stop offset="1" stop-color="#9aa1b1" />
              </linearGradient>
            </defs>
            <!-- Rare-elite dragon frame: silver wings behind the sheep -->
            <g fill="url(#elite-silver)" stroke="#6c7282" stroke-width="1.5" stroke-linejoin="round">
              <path d="M58 70 L14 36 L30 66 L4 66 L28 86 L8 100 L36 100 L22 122 L56 104 Z" />
              <path d="M178 66 L216 30 L204 62 L228 60 L208 82 L226 96 L198 98 L212 120 L180 100 Z" />
            </g>
            <ellipse cx="115" cy="160" rx="70" ry="7" fill="#000" opacity=".4" />
            <g fill="#4a3410"><rect x="80" y="118" width="10" height="34" rx="4" /><rect x="104" y="122" width="10" height="32" rx="4" /><rect x="132" y="122" width="10" height="32" rx="4" /><rect x="154" y="118" width="10" height="34" rx="4" /></g>
            <g fill="url(#golden-wool)"><circle cx="78" cy="88" r="24" /><circle cx="104" cy="72" r="27" /><circle cx="134" cy="74" r="26" /><circle cx="156" cy="92" r="22" /><circle cx="98" cy="104" r="22" /><circle cx="132" cy="106" r="22" /></g>
            <ellipse cx="178" cy="92" rx="19" ry="16" fill="#4a3410" />
            <ellipse cx="166" cy="80" rx="8" ry="4" fill="#4a3410" transform="rotate(-30 166 80)" />
            <circle cx="183" cy="88" r="3.2" fill="#fff1b8" /><circle cx="184" cy="88" r="1.6" fill="#120e2a" />
            <g class="polymorph__sparkles" fill="#fff6c8">
              <path d="M70 40 l3 9 l9 3 l-9 3 l-3 9 l-3 -9 l-9 -3 l9 -3 z" />
              <path d="M150 34 l2 6 l6 2 l-6 2 l-2 6 l-2 -6 l-6 -2 l6 -2 z" />
              <path d="M190 124 l2.5 7 l7 2.5 l-7 2.5 l-2.5 7 l-2.5 -7 l-7 -2.5 l7 -2.5 z" />
            </g>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <p class="polymorph__label" aria-live="polite" data-label>{t(locale, 'hero.form', { form: formLabels.sheep })}</p>
  <h1 id="hero-title" class="polymorph__title">Sheep Happens</h1>
  <p class="polymorph__count" data-count-text={t(locale, 'hero.count', { count: '{count}' })} data-count>
    {t(locale, 'hero.count', { count: 0 })}
  </p>
  <p class="polymorph__note" aria-live="polite" data-note></p>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-polymorph]');
  const button = hero?.querySelector<HTMLButtonElement>('[data-cast]');
  if (hero && button) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const form = (id: string) => button.querySelector<SVGSVGElement>(`[data-form="${id}"]`)!;
    const cycle = ['sheep', 'pig', 'turtle'].map(form);
    const labels = JSON.parse(hero.dataset.labels ?? '{}') as Record<string, string>;
    const eggs = JSON.parse(hero.dataset.eggs ?? '{}') as Record<string, string>;
    const label = hero.querySelector<HTMLElement>('[data-label]');
    const count = hero.querySelector<HTMLElement>('[data-count]');
    const note = hero.querySelector<HTMLElement>('[data-note]');
    const IMMUNE_SECONDS = 18;
    let shown = cycle[0]!;
    let current = 0;
    let casts = 0;
    let immuneUntil = 0;
    let immuneTimer = 0;

    const setNote = (text: string) => {
      if (note) note.textContent = text;
    };
    const setCount = (value: number) => {
      casts = value;
      if (count) count.textContent = (count.dataset.countText ?? '').replace('{count}', String(value));
    };

    // Floating combat text over the sheep, as in the game.
    const floatText = (text: string) => {
      const hit = document.createElement('span');
      hit.className = 'polymorph__hit';
      hit.setAttribute('aria-hidden', 'true');
      hit.textContent = text;
      button.append(hit);
      setTimeout(() => hit.remove(), 1000);
    };

    // 25 casts: sheep fall across the page for a few seconds.
    const rain = () => {
      const sky = document.createElement('div');
      sky.className = 'polymorph-rain';
      sky.setAttribute('aria-hidden', 'true');
      for (let i = 0; i < 26; i++) {
        const drop = cycle[0]!.cloneNode(true) as SVGSVGElement;
        for (const name of ['role', 'aria-label', 'data-form', 'data-shown']) drop.removeAttribute(name);
        drop.firstElementChild?.remove(); // no ground shadow in mid-air
        drop.setAttribute('class', 'polymorph-rain__sheep');
        drop.style.left = `${Math.random() * 96}%`;
        drop.style.width = `${40 + Math.random() * 40}px`;
        drop.style.animationDuration = `${2.6 + Math.random() * 2}s`;
        drop.style.animationDelay = `${Math.random() * 1.6}s`;
        drop.style.setProperty('--spin', `${Math.round(Math.random() * 720 - 360)}deg`);
        sky.append(drop);
      }
      document.body.append(sky);
      setTimeout(() => sky.remove(), 6500);
    };

    // 100 casts: diminishing returns, immune for 18 s (the note counts down);
    // then the counter starts again from 0.
    const startImmunity = () => {
      immuneUntil = Date.now() + IMMUNE_SECONDS * 1000;
      const tick = () => {
        const left = Math.ceil((immuneUntil - Date.now()) / 1000);
        if (left <= 0) {
          setNote('');
          setCount(0);
          return;
        }
        setNote((eggs.immune ?? '').replace('{s}', String(left)));
        immuneTimer = window.setTimeout(tick, 1000);
      };
      clearTimeout(immuneTimer);
      tick();
    };

    button.addEventListener('click', () => {
      if (Date.now() < immuneUntil) return floatText(eggs.immuneHit ?? '');
      casts += 1;
      shown.removeAttribute('data-shown');
      let name: string;
      if (casts === 10) {
        shown = form('penguin');
        name = `${labels.penguin} (${eggs.rareTag})`;
        setNote(eggs.rare ?? '');
      } else if (casts === 50) {
        shown = form('golden');
        name = labels.golden ?? '';
        setNote(eggs.golden ?? '');
      } else {
        // The usual cycle; the rare forms do not move it on.
        current = (current + 1) % cycle.length;
        shown = cycle[current]!;
        name = labels[shown.dataset.form!] ?? '';
        setNote(casts === 25 ? (eggs.rain ?? '') : '');
      }
      shown.setAttribute('data-shown', '');
      if (label) label.textContent = (hero.dataset.formTemplate ?? '').replace('{form}', name);
      setCount(casts);
      if (casts === 100) startImmunity();
      if (calm.matches) return;
      if (casts === 25) rain();
      // Restart the pop on the new form and launch a fresh ring of light.
      const next = shown;
      next.classList.remove('is-popping');
      void next.getBoundingClientRect();
      next.classList.add('is-popping');
      const burst = document.createElement('span');
      burst.className = 'polymorph__burst';
      burst.setAttribute('aria-hidden', 'true');
      button.append(burst);
      burst.addEventListener('animationend', () => burst.remove());
    });

    // Parallax: the circle drifts away from the pointer, the sheep towards it (mouse only).
    const circle = hero.querySelector<HTMLElement>('[data-parallax="circle"]');
    const critter = hero.querySelector<HTMLElement>('[data-parallax="sheep"]');
    let frame = 0;
    let dx = 0;
    let dy = 0;
    const apply = () => {
      frame = 0;
      circle?.style.setProperty('translate', `${(-dx * 14).toFixed(1)}px ${(-dy * 14).toFixed(1)}px`);
      critter?.style.setProperty('translate', `${(dx * 22).toFixed(1)}px ${(dy * 22).toFixed(1)}px`);
    };
    hero.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || calm.matches) return;
      const box = hero.getBoundingClientRect();
      dx = Math.max(-1, Math.min(1, ((event.clientX - box.left) / box.width) * 2 - 1));
      dy = Math.max(-1, Math.min(1, ((event.clientY - box.top) / box.height) * 2 - 1));
      frame ||= requestAnimationFrame(apply);
    });
    hero.addEventListener('pointerleave', () => {
      dx = 0;
      dy = 0;
      frame ||= requestAnimationFrame(apply);
    });
  }
</script>

<style>
  .polymorph {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: var(--space-4) var(--space-7);
  }
  .polymorph__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(300px, 40vw, 500px);
    aspect-ratio: 1;
  }
  .polymorph__stage > * {
    grid-area: 1 / 1;
  }
  .polymorph__circle,
  .polymorph__critter {
    transition: translate 0.25s ease-out;
  }
  .polymorph__circle {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .polymorph__glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(160, 120, 255, 0.3), transparent 70%);
    filter: blur(10px);
  }
  .polymorph__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: polymorph-spin 50s linear infinite;
  }
  .polymorph__ring--middle {
    animation-duration: 34s;
    animation-direction: reverse;
  }
  .polymorph__ring--inner {
    animation-duration: 22s;
  }
  .polymorph__runes text {
    font-family: serif;
    font-size: 7px;
    text-anchor: middle;
    dominant-baseline: central;
    animation: polymorph-rune 3s ease-in-out infinite alternate;
  }
  .polymorph__float {
    animation: polymorph-float 5s ease-in-out infinite;
  }
  .polymorph__button {
    position: relative;
    display: grid;
    place-items: center;
    width: 190px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .polymorph__button:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 6px;
  }
  /* Only the current form is shown (and exposed to assistive technology). */
  .polymorph__form:not([data-shown]) {
    display: none;
  }
  .polymorph__form {
    width: 100%;
    height: auto;
    aspect-ratio: 230 / 170;
    overflow: visible;
  }
  .polymorph__form.is-popping {
    animation: polymorph-pop 0.55s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  /* Elements created by the script carry no scope attribute: :global. */
  :global(.polymorph__burst) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120px;
    height: 120px;
    margin: -60px 0 0 -60px;
    border: 3px solid #f2d48a;
    border-radius: 50%;
    box-shadow: 0 0 18px 4px rgba(139, 108, 255, 0.75), inset 0 0 12px 2px rgba(139, 108, 255, 0.5);
    pointer-events: none;
    animation: polymorph-burst 0.7s ease-out forwards;
  }
  :global(.polymorph__hit) {
    position: absolute;
    top: -6px;
    left: 50%;
    margin-left: -60px;
    width: 120px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 1px;
    text-align: center;
    color: #ffd100;
    text-shadow: 0 2px 0 #000, 0 0 6px rgba(0, 0, 0, 0.8);
    pointer-events: none;
    animation: polymorph-hit 1s ease-out forwards;
  }
  :global(.polymorph-rain) {
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    pointer-events: none;
  }
  :global(.polymorph-rain__sheep) {
    position: absolute;
    top: -120px;
    height: auto;
    aspect-ratio: 230 / 170;
    /* A thin outline so the white wool reads on the light theme too. */
    filter: drop-shadow(0 0 1.5px #2b2350) drop-shadow(0 4px 6px rgba(0, 0, 0, 0.25));
    animation: polymorph-fall linear forwards;
  }
  .polymorph__sparkles path {
    transform-box: fill-box;
    transform-origin: center;
    animation: polymorph-twinkle 1.4s ease-in-out infinite alternate;
  }
  .polymorph__sparkles path:nth-child(2) {
    animation-delay: -0.5s;
  }
  .polymorph__sparkles path:nth-child(3) {
    animation-delay: -1s;
  }
  /* Easter-egg message, in the gap under the counter (no layout shift). */
  .polymorph__note {
    position: absolute;
    bottom: var(--space-3);
    left: 0;
    right: 0;
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: light-dark(#8a5300, #f2d48a);
  }
  .polymorph__label {
    margin: var(--space-2) 0 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    /* The requested colours are for the dark theme; the light theme keeps the contrast. */
    color: light-dark(var(--accent), #c9b0ff);
  }
  .polymorph__title {
    margin: var(--space-2) 0 0;
    max-width: none;
    font-family: 'Cinzel Decorative', var(--font-display);
    font-size: clamp(38px, 6.5vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    color: light-dark(var(--text), #f6f3ff);
  }
  .polymorph__count {

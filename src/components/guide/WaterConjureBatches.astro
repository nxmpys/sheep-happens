---
/**
 * What one cast yields when you have just learned a rank, against the rank
 * before it. Levels with a new rank and the five levels after, up to rank 4:
 * from rank 5 on the bottle count still needs checking in the game.
 */
import Table from '../ui/Table.astro';
import { getLocale } from '../../i18n/locale';
import { mageWater } from '../../lib/data';
import { conjureYield, formatNumber, rankAtLevel } from '../../lib/water';

const locale = getLocale(Astro);
const es = locale === 'es';
const levels = [20, 25, 30];
const rows = levels.flatMap((level) => {
  const top = rankAtLevel(mageWater.waterRanks, level)!;
  const previous = mageWater.waterRanks.find((rank) => rank.rank === top.rank - 1)!;
  return [top, previous].map((rank, index) => ({ level, rank, first: index === 0, ...conjureYield(rank, level) }));
});
---

<Table>
  <caption class="visually-hidden">
    {es ? 'Lo que da un lanzamiento de Conjurar agua a varios niveles, con el rango más alto y con el anterior' : 'What one Conjure Water cast yields at several levels, with the top rank and the one before it'}
  </caption>
  <thead>
    <tr>
      <th scope="col">{es ? 'Nivel' : 'Level'}</th>
      <th scope="col">{es ? 'Rango' : 'Rank'}</th>
      <th scope="col">{es ? 'Botellas' : 'Bottles'}</th>
      <th scope="col">{es ? 'Maná total del lote' : 'Total mana in the batch'}</th>
      <th scope="col">{es ? 'Maná por segundo bebiendo' : 'Mana per second drinking'}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          {row.first ? <th scope="row" rowspan="2">{row.level}</th> : null}
          <td>{row.rank.rank}</td>
          <td>{row.bottles}</td>
          <td>{formatNumber(row.totalMana, locale)}</td>
          <td>{formatNumber(row.manaPerSecond, locale, 1)}</td>
        </tr>
      ))
    }
  </tbody>
</Table>

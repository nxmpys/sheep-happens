---
/**
 * "I have Talented 5/5" switch. Every copy on the site drives the same saved
 * preference (src/scripts/talented.ts). Hidden without JavaScript: the tables
 * then show the levels without Talented.
 */
import { tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';

const locale = getLocale(Astro);
---

<label class="talented-toggle" data-talented-switch hidden data-pagefind-ignore>
  <input type="checkbox" role="switch" data-talented-toggle />
  <span class="talented-toggle__track" aria-hidden="true"></span>
  <span class="talented-toggle__text">
    {tb(locale, 'build.talentedToggle')}
    <small>{tb(locale, 'build.talentedHint')}</small>
  </span>
</label>

<script>
  import { initTalented } from '../../scripts/talented';
  initTalented();
</script>

<style>
  .talented-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 650;
  }
  .talented-toggle[hidden] {
    display: none;
  }
  .talented-toggle input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .talented-toggle__track {
    position: relative;
    flex-shrink: 0;
    width: 2.5rem;
    height: 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    transition: background 0.15s;
  }
  .talented-toggle__track::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.4rem - 6px);
    height: calc(1.4rem - 6px);
    border-radius: 50%;
    background: var(--text-muted);
    transition: transform 0.15s;
  }
  .talented-toggle input:checked + .talented-toggle__track {
    border-color: var(--baseline);
    background: var(--baseline-soft);
  }
  .talented-toggle input:checked + .talented-toggle__track::after {
    transform: translateX(1.1rem);
    background: var(--baseline);
  }
  .talented-toggle input:focus-visible + .talented-toggle__track {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .talented-toggle__text {
    display: grid;
  }
  .talented-toggle small {
    font-weight: 500;
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .talented-toggle__track,
    .talented-toggle__track::after {
      transition: none;
    }
  }
</style>

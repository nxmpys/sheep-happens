---
/** Cloth gear before and after: what each piece drops in Intellect and what it gets in exchange. */
import Table from '../ui/Table.astro';
import { getLocale } from '../../i18n/locale';
import { mageWater } from '../../lib/data';
import { formatNumber, intTrade } from '../../lib/water';

const locale = getLocale(Astro);
const es = locale === 'es';
type Stats = (typeof mageWater.gear)[number]['classic'];
const signed = (value: number) => `${value > 0 ? '+' : '−'}${Math.abs(value)}`;
const stats = (s: Stats) =>
  [
    s.int && `${signed(s.int)} Int`,
    s.sta && `${signed(s.sta)} ${es ? 'Agu' : 'Sta'}`,
    s.spellPower && `${signed(s.spellPower)} ${es ? 'daño de hechizos' : 'spell damage'}`,
    s.mp5 && `${signed(s.mp5)} mp5`,
  ]
    .filter(Boolean)
    .join(' · ');
---

<Table>
  <caption class="visually-hidden">
    {es ? 'Objetos de tela en Classic y en Forever, con el Intelecto que pierden y lo que tarda su mp5 en devolver ese maná' : 'Cloth items in Classic and Forever, with the Intellect they lose and how long their mp5 takes to return that mana'}
  </caption>
  <thead>
    <tr>
      <th scope="col">{es ? 'Objeto' : 'Item'}</th>
      <th scope="col">Classic</th>
      <th scope="col">Forever</th>
      <th scope="col">{es ? 'Intelecto' : 'Intellect'}</th>
      <th scope="col">{es ? 'Maná de reserva' : 'Mana pool'}</th>
      <th scope="col">{es ? 'El mp5 lo devuelve en' : 'mp5 returns it in'}</th>
    </tr>
  </thead>
  <tbody>
    {
      mageWater.gear.map((item) => {
        const trade = intTrade(item.classic.int, item.forever.int, item.forever.mp5);
        return (
          <tr>
            <th scope="row">
              {item.name[locale]}
              {es && <span class="english">{item.name.en}</span>}
            </th>
            <td>{stats(item.classic)}</td>
            <td>{stats(item.forever)}</td>
            <td><strong class="delta">{signed(item.forever.int - item.classic.int)}</strong></td>
            <td class="nowrap">−{formatNumber(trade.manaLost, locale)}</td>
            <td class="nowrap">{trade.paybackSeconds === undefined ? (es ? 'sin mp5' : 'no mp5') : `${formatNumber(trade.paybackSeconds, locale)} s`}</td>
          </tr>
        );
      })
    }
  </tbody>
</Table>
<ul class="notes">
  {mageWater.gear.flatMap((item) => (item.note ? [<li>{item.name[locale]}: {item.note[locale]}</li>] : []))}
</ul>

<style>
  .english {
    display: block;
    font-weight: 400;
    color: var(--text-subtle);
  }
  .delta {
    color: var(--nerf);
  }
  .nowrap {
    white-space: nowrap;
  }
  .notes {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>

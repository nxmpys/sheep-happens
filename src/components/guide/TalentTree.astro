---
/**
 * The talents of a build in one tree: only those with points, grouped by row
 * (top to bottom, left to right), with their rank. The full tree, empty talents
 * included, is one click away in the Wowhead calculator linked from the card.
 */
import Icon from '../ui/Icon.astro';
import SpellRef from './SpellRef.astro';
import { tb } from '../../i18n/builds';
import { getLocale } from '../../i18n/locale';
import { t, type UiKey } from '../../i18n/ui';
import { milestones, talents } from '../../lib/data';
import { localName } from '../../lib/names';
import type { SpecTree } from '../../lib/schemas';
import { treeTalents, type Points } from '../../lib/talents';

interface Props {
  tree: SpecTree;
  points: Points;
}

const { tree, points } = Astro.props;
const locale = getLocale(Astro);
const spentList = treeTalents(talents, tree).filter((talent) => (points[talent.id] ?? 0) > 0);
const spent = spentList.reduce((sum, talent) => sum + points[talent.id]!, 0);
const rows = [...new Set(spentList.map((talent) => talent.row))].map((row) => ({
  row,
  talents: spentList.filter((talent) => talent.row === row),
}));
// Only confirmed milestones get the marker (milestones.json), not every 1-point talent.
const milestoneNames = new Set(milestones.filter((m) => m.tree === tree && m.status !== 'pending' && m.name).map((m) => m.name));
const treeLabel = t(locale, `tree.${tree}` as UiKey);
---

<figure class={`talent-tree school-${tree}`}>
  <figcaption class="talent-tree__title">
    <Icon name={tree} size={18} />
    {treeLabel} <span class="talent-tree__spent">{spent}</span>
  </figcaption>
  <ol class="talent-tree__rows">
    {
      rows.map(({ row, talents: rowTalents }) => (
        <li class="talent-row">
          <span class="talent-row__label">{tb(locale, 'build.row', { row })}</span>
          <ul class="talent-row__list">
            {rowTalents.map((talent) => {
              const rank = points[talent.id]!;
              const label = localName(talent, locale);
              const milestone = milestoneNames.has(talent.name);
              return (
                <li class:list={['talent', { 'talent--full': rank === talent.maxRank, 'talent--milestone': milestone }]}>
                  <span class="talent__name">
                    {milestone && (
                      <span class="talent__star" aria-hidden="true">
                        ★
                      </span>
                    )}
                    <SpellRef name={talent.name} label={label} />
                  </span>
                  <span class="talent__rank">
                    {rank}/{talent.maxRank}
                  </span>
                  {milestone && <span class="visually-hidden">, {tb(locale, 'build.milestone')}</span>}
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .talent-tree {
    margin: 0;
    min-width: 0;
  }
  .talent-tree__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-weight: 700;
    color: var(--school);
  }
  .talent-tree__spent {
    margin-left: auto;
    padding: 0 0.55em;
    border-radius: 999px;
    background: var(--school-soft);
    font-variant-numeric: tabular-nums;
  }
  .talent-tree__rows {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .talent-row {
    display: grid;
    grid-template-columns: 3.75rem 1fr;
    align-items: start;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-3);
  }
  .talent-row + .talent-row {
    margin-top: 0;
    border-top: 1px solid var(--border);
  }
  .talent-row__label {
    padding-top: 0.3em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .talent-row__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .talent {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin: 0;
    padding: 0.2em 0.6em;
    border: 1px solid color-mix(in srgb, var(--school) 55%, transparent);
    border-radius: var(--radius-sm);
    background: var(--school-soft);
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .talent + .talent {
    margin-top: 0;
  }
  .talent__star {
    color: var(--baseline);
  }
  .talent__rank {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--school);
  }
  .talent--milestone {
    box-shadow: inset 0 0 0 1px var(--baseline);
  }
</style>

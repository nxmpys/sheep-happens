---
/**
 * "Play first" note at the top of the Learn page. A thin
 * arcane light runs round the border, and a quest-giver "!" bobs over the top
 * edge, so the eye goes to the note. With «reduce motion» the light and the
 * "!" stay still. The Polymorph sheep that used to stand there is kept in
 * PolymorphSheep.astro, and its sleepy z's in SleepingZzz.astro.
 */
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="play-first">
  <span class="play-first__quest" aria-hidden="true">
    <svg viewBox="0 0 22 44">
      <defs>
        <linearGradient id="play-first-gold" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff6a8" />
          <stop offset="0.45" stop-color="#ffd21f" />
          <stop offset="1" stop-color="#e08a00" />
        </linearGradient>
      </defs>
      <g fill="url(#play-first-gold)" stroke="#2a1600" stroke-width="2" stroke-linejoin="round">
        <path d="M3 4 Q11 -1 19 4 L14.5 29 Q11 31 7.5 29 Z" />
        <circle cx="11" cy="37.5" r="5" />
      </g>
      <path d="M6.5 6 Q9 4.2 11.5 4.4 L9 22 Z" fill="#fffbe0" opacity="0.7" />
    </svg>
  </span>
  <div class="play-first__body">
    <p class="play-first__title">{t(locale, 'playFirst.title')}</p>
    <p>{t(locale, 'playFirst.body')}</p>
  </div>
</aside>

<style>
  @property --play-angle {
    syntax: '<angle>';
    inherits: true;
    initial-value: 0deg;
  }

  /* A card like the rest of the site, with a faint arcane wash under the "!". */
  .play-first {
    position: relative;
    isolation: isolate;
    margin-top: 40px;
    margin-bottom: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(240px circle at calc(100% - 3rem) 0, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      var(--surface-1);
  }
  /* The travelling light: a 1px ring masked out of a conic gradient, as in .arcane-glow. */
  .play-first::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 1;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--play-angle),
      transparent 0 70%,
      color-mix(in srgb, var(--accent) 80%, transparent) 85%,
      var(--link-hover) 90%,
      color-mix(in srgb, var(--accent) 80%, transparent) 95%,
      transparent
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* The quest-giver "!": WoW's gold mark with a dark rim, half inside the top edge. */
  .play-first__quest {
    position: absolute;
    z-index: 2;
    right: calc(3rem - 11px);
    bottom: calc(100% - 16px);
    width: 22px;
    height: 44px;
    pointer-events: none;
    filter: drop-shadow(0 0 6px rgb(255 200 40 / 0.65)) drop-shadow(0 2px 2px rgb(0 0 0 / 0.6));
  }
  .play-first__quest svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .play-first__body {
    min-width: 0;
  }
  .play-first__body > * + * {
    margin-top: var(--space-2);
  }
  .play-first__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }

  @media (max-width: 480px) {
    .play-first {
      margin-top: 34px;
    }
    .play-first__quest {
      right: calc(2rem - 9px);
      width: 18px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .play-first::before {
      animation: play-first-orbit 5s linear infinite;
    }
    .play-first__quest {
      animation: play-first-bob 1.6s ease-in-out infinite;
    }
  }

  @keyframes play-first-orbit {
    to {
      --play-angle: 360deg;
    }
  }
  /* The lazy hover of a quest mark over an NPC's head. */
  @keyframes play-first-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
</style>

---
import SourceRefs from './SourceRefs.astro';
import StatusBadge from './StatusBadge.astro';
import { getLocale } from '../../i18n/locale';
import { getFact } from '../../lib/data';

interface Props {
  ids: readonly string[];
}

const { ids } = Astro.props;
const locale = getLocale(Astro);
const list = ids.map(getFact);
---

<dl class="facts">
  {
    list.map((fact) => (
      <div class="fact">
        <dt>{fact.label[locale]}</dt>
        <dd>
          <span class="fact__value">{fact.value[locale]}</span>
          <span class="fact__meta">
            <StatusBadge status={fact.status} />
            <SourceRefs ids={fact.sources} />
          </span>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    overflow: hidden;
  }
  .fact {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
  }
  .fact + .fact {
    border-top: 1px solid var(--border);
  }
  dt {
    font-weight: 700;
    color: var(--text-muted);
    font-size: var(--step--1);
    padding-top: 0.15em;
  }
  dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .fact__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: center;
  }
  @media (max-width: 560px) {
    .fact {
      grid-template-columns: 1fr;
    }
  }
</style>

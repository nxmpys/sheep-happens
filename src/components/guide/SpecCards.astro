---
import Icon from '../ui/Icon.astro';
import StatusBadge from './StatusBadge.astro';
import { getLocale, href } from '../../i18n/locale';
import { NAV_LABELS, t } from '../../i18n/ui';
import { changesForTree, milestonesForTree } from '../../lib/data';
import { localName } from '../../lib/names';

interface Props {
  /** The home page's version: tall picture panels that widen under the pointer. */
  panels?: boolean;
}

const { panels = false } = Astro.props;
const locale = getLocale(Astro);
const es = locale === 'es';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/** Paraphrased from Blizzard's deep dive (see sources). */
const identity = {
  arcane: {
    es: 'Potencia al resto de tu arsenal: prepara y refuerza el siguiente hechizo.',
    en: 'Amplifies the rest of your toolkit: set up and empower the next cast.',
  },
  fire: {
    es: 'Premia los críticos y el buen momento para lanzar.',
    en: 'Rewards critical strikes and good timing.',
  },
  frost: {
    es: 'Control por capas, ahora con nuevas interacciones con el resto de la clase.',
    en: 'Layered control, now with new links to the rest of the class.',
  },
} as const;

const specs = (['arcane', 'fire', 'frost'] as const).map((tree) => ({
  tree,
  pageId: `talents-${tree}` as const,
  newTalents: changesForTree(tree).filter((c) => c.kinds.includes('new')).map((c) => localName(c, locale)),
  milestones: milestonesForTree(tree),
}));
---

<ul class:list={['specs', { 'specs--panels': panels }]}>
  {
    specs.map((spec) => (
      <li class={`spec has-glow school-${spec.tree}`}>
        {panels && <img class="spec__picture" src={`${base}home/tree-${spec.tree}.webp`} alt="" width="1200" height="500" loading="lazy" decoding="async" />}
        <span class="arcane-glow" aria-hidden="true"></span>
        <a class="spec__link" href={href(spec.pageId, locale)}>
          <span class="spec__icon">
            <Icon name={spec.tree} size={30} strokeWidth={1.5} />
          </span>
          <span class="spec__name">{NAV_LABELS[locale][spec.pageId]}</span>
        </a>
        <p class="spec__identity">
          {identity[spec.tree][locale]} <StatusBadge status="verified" compact />
        </p>
        <p class="spec__label">{es ? 'Nuevo en Forever' : 'New in Forever'}</p>
        <ul class="spec__tags">
          {spec.newTalents.map((name) => (
            <li class="chip">{name}</li>
          ))}
        </ul>
        <p class="spec__label">{es ? 'Talentos decisivos (11 · 16 · 21 · 31)' : 'Milestones (11 · 16 · 21 · 31)'}</p>
        <p class="spec__milestones">
          {spec.milestones.map((m) => (m.name ? localName({ name: m.name }, locale) : t(locale, 'milestones.unknown').toLowerCase())).join(' → ')}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .specs {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (max-width: 52rem) {
    .specs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .spec {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--school-soft), var(--surface-1) 55%);
  }
  .spec + .spec {
    margin-top: 0;
  }
  .spec:hover {
    border-color: var(--school);
  }
  .spec__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    text-decoration: none;
  }
  /* The whole card is clickable through the main link. */
  .spec__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .spec__link:focus-visible {
    outline: none;
  }
  .spec:has(.spec__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .spec__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--school) 50%, transparent);
    color: var(--school);
    background: var(--surface-1);
  }
  .spec__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .spec__identity {
    color: var(--text-muted);
    position: relative;
    z-index: 1;
  }
  .spec__label {
    margin-top: var(--space-2);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--school);
  }
  .spec__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .spec__tags li {
    margin: 0;
  }
  .spec__milestones {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* ---- Home page: picture panels, always dark over their picture ---- */
  .specs--panels {
    color-scheme: dark;
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
    min-height: min(40rem, 86svh);
  }
  .specs--panels .spec {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    background: #05070f;
    color: #f4f5fb;
    transition:
      flex-grow 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.2s;
  }
  /* The text lets clicks through to the link that covers the card; tooltips keep working. */
  .specs--panels .spec > :not(.spec__picture, .arcane-glow, .spec__link) {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .specs--panels .spec :global(.status),
  .specs--panels .spec :global(.spell-ref) {
    pointer-events: auto;
  }
  .spec__picture {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Over the picture, under the words: the text sits on near-solid dark. */
  .specs--panels .spec::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, #05070f 40%, rgb(5 7 15 / 0.8) 58%, rgb(5 7 15 / 0.05) 84%);
    pointer-events: none;
  }
  /* The picture above, and the three names on one line whatever the text below them. */
  .specs--panels .spec__link {
    margin-top: clamp(10rem, 30svh, 17rem);
  }
  .specs--panels .spec__link,
  .specs--panels .spec__name {
    color: #fff;
  }
  .specs--panels .spec__name {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.4rem);
  }
  .specs--panels .spec__icon {
    background: rgb(5 7 15 / 0.7);
  }
  .specs--panels .spec__identity,
  .specs--panels .spec__milestones {
    color: rgb(244 245 251 / 0.8);
  }
  @media (hover: hover) and (min-width: 821px) {
    .specs--panels .spec:hover,
    .specs--panels .spec:focus-within {
      flex-grow: 1.45;
    }
    .specs--panels .spec:hover .spec__picture {
      transform: scale(1.05);
    }
  }
  @media (max-width: 820px) {
    .specs--panels {
      flex-direction: column;
      min-height: 0;
    }
    .specs--panels .spec {
      flex: none;
      min-height: 30rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .specs--panels .spec,
    .spec__picture {
      transition: none;
    }
  }
</style>

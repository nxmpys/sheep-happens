---
/**
 * Actions of a build page, in the same format as the build card: open it in
 * our calculator, copy the link to the build page, the in-depth guide if there
 * is one, and a small «View on Wowhead» link.
 */
import Icon from '../ui/Icon.astro';
import { tb } from '../../i18n/builds';
import { getLocale, href } from '../../i18n/locale';
import { buildPath } from '../../lib/build-routes';
import { talents } from '../../lib/data';
import type { Build } from '../../lib/schemas';
import { wowheadBuildUrl } from '../../lib/talents';

interface Props {
  build: Build;
}

const { build } = Astro.props;
const locale = getLocale(Astro);
// Our own calculator reads the Wowhead code from ?t= (see TalentCalculator).
const calcCode = wowheadBuildUrl(build.points, talents).split('/mage/v2')[1] ?? '';
const calcUrl = `${href('talent-calc', locale)}?t=${calcCode}&lvl=${build.level}${build.order ? `&b=${build.id}` : ''}`;
const shareUrl = buildPath(build, locale, { base: import.meta.env.BASE_URL });
const copyStrings = JSON.stringify({ copied: locale === 'es' ? 'Enlace copiado' : 'Link copied', failed: locale === 'es' ? 'No se pudo copiar. Copia la URL de la barra de direcciones.' : 'Could not copy. Copy the URL from the address bar instead.' });
---

<div class="build-actions" data-pagefind-ignore>
  <a class="button button--primary" href={calcUrl}>
    <Icon name="layers" size={16} />
    {tb(locale, 'build.calc')}
  </a>
  <button type="button" class="button" data-build-copy={shareUrl} data-strings={copyStrings}>
    <Icon name="link" size={16} />
    {tb(locale, 'build.copy')}
  </button>
  {
    build.page && (
      <a class="button" href={href(build.page, locale)}>
        <Icon name="book" size={16} />
        {tb(locale, 'build.guide')}
      </a>
    )
  }
  <a class="build-actions__wowhead" href={wowheadBuildUrl(build.points, talents)} target="_blank" rel="noopener noreferrer">
    {tb(locale, 'build.wowhead')}
    <Icon name="external" size={14} />
    <span class="visually-hidden"> ({tb(locale, 'build.wowheadHint')})</span>
  </a>
</div>

<script>
  import { copyText } from '../../scripts/clipboard';
  import { showToast } from '../../scripts/toast';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-build-copy]')) {
    button.addEventListener('click', async () => {
      const strings: Record<string, string> = JSON.parse(button.dataset.strings ?? '{}');
      const ok = await copyText(new URL(button.dataset.buildCopy!, location.origin).href);
      showToast(ok ? strings['copied']! : strings['failed']!);
    });
  }
</script>

<style>
  .build-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }
  .build-actions__wowhead {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>

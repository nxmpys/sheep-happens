---
/** Task-oriented entry points for the home page. */
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import StatusBadge from './StatusBadge.astro';
import { getLocale, href } from '../../i18n/locale';
import type { PageId } from '../../i18n/routes';
import type { Status } from '../../lib/schemas';

const locale = getLocale(Astro);

interface Question {
  page: PageId;
  hash?: string;
  icon: IconName;
  q: { es: string; en: string };
  a: { es: string; en: string };
  status?: Status;
}

// In the order a new player needs them: how to start, race, tree, leveling
// (and the level view), what to press, builds, changes, professions, gear.
const questions: Question[] = [
  {
    page: 'guide',
    icon: 'book',
    q: { es: '¿Cómo empiezo a jugar Mago?', en: 'How do I start playing Mage?' },
    a: { es: 'Fundamentos, herramientas por función y qué cambia respecto a Classic.', en: 'Basics, tools by purpose, and what differs from Classic.' },
  },
  {
    page: 'races',
    icon: 'users',
    q: { es: '¿Qué raza elijo?', en: 'Which race should I pick?' },
    a: { es: 'La mejor raza según juegues leveo, mazmorras o JcJ, y por qué.', en: 'The best race for leveling, dungeons or PvP, and why.' },
  },
  {
    page: 'talents',
    icon: 'arcane',
    q: { es: '¿Qué rama elijo?', en: 'Which tree should I pick?' },
    a: { es: 'Identidad de Arcano, Fuego y Escarcha, hitos y talentos nuevos.', en: 'Arcane, Fire and Frost identity, milestones and new talents.' },
  },
  {
    page: 'leveling',
    icon: 'map',
    q: { es: '¿Con qué build subo de nivel?', en: 'Which build should I level with?' },
    a: { es: 'Cómo jugar cada tramo de nivel, los errores frecuentes y lo que cambia Forever al subir.', en: 'How to play each level stretch, common mistakes and what Forever changes for leveling.' },
    status: 'analysis',
  },
  {
    page: 'combat',
    icon: 'fire',
    q: { es: '¿Qué pulso y cuándo?', en: 'What do I press, and when?' },
    a: { es: 'Prioridades condicionales por rama, basadas en mecánicas oficiales.', en: 'Conditional priorities per tree, based on official mechanics.' },
    status: 'analysis',
  },
  {
    page: 'builds',
    icon: 'layers',
    q: { es: '¿Qué build uso?', en: 'Which build should I use?' },
    a: { es: 'Builds por uso y rama, con calculadora y explicación. Ya hay de leveo del 1 al 60, listas para copiar.', en: 'Builds by use and tree, with a calculator link and an explanation. Leveling builds from 1 to 60 are up, ready to copy.' },
    status: 'analysis',
  },
  {
    page: 'changes',
    icon: 'filter',
    q: { es: '¿Qué cambia en Forever?', en: 'What changes in Forever?' },
    a: { es: 'Más de 40 cambios oficiales, filtrables por rama y tipo.', en: '40+ official changes, filterable by tree and type.' },
  },
  {
    page: 'professions',
    icon: 'hammer',
    q: { es: '¿Qué profesiones elijo?', en: 'Which professions should I pick?' },
    a: { es: 'Las dos mejores según tu objetivo (JcE, JcJ, leveo u oro) y qué aporta cada una al Mago.', en: 'The best two for your goal (PvE, PvP, leveling or gold) and what each one gives a Mage.' },
    status: 'analysis',
  },
  {
    page: 'class-quests',
    icon: 'reward',
    q: { es: '¿Qué misiones de clase merecen la pena?', en: 'Which class quests are worth it?' },
    a: { es: 'Las siete cadenas de Mago del 10 al 60, sus recompensas y cuándo hacerlas.', en: 'The seven Mage chains from 10 to 60, their rewards and when to do them.' },
  },
  {
    page: 'library',
    icon: 'library',
    q: { es: '¿Dónde están los libros de la biblioteca?', en: 'Where are the library books?' },
    a: { es: 'Los 38 libros por zona, los premios de 10, 20 y 25 libros y un contador de los que llevas.', en: 'All 38 books by zone, the 10, 20 and 25 book rewards and a tracker of the ones you have.' },
  },
  {
    page: 'pvp',
    icon: 'swords',
    q: { es: '¿Cómo funciona el JcJ?', en: 'How does PvP work?' },
    a: { es: 'Honor, los 14 rangos, el equipo JcJ del Mago y el equipo de Islas Lanza Negra.', en: 'Honor, the 14 ranks, the Mage PvP gear and the Darkspear Islands gear.' },
  },
  {
    page: 'gear',
    icon: 'frost',
    q: { es: '¿Qué equipo busco mientras subo?', en: 'Which gear should I chase while leveling?' },
    a: { es: 'Las piezas clave nivel a nivel: misiones de clase, biblioteca e Islas Lanza Negra. Y el equipo de JcE y JcJ.', en: 'The key pieces level by level: class quests, the library and Darkspear Islands. Plus PvE and PvP gear.' },
  },
];
---

<ul class="questions">
  {
    questions.map((item) => (
      <li class="question has-glow">
        <span class="arcane-glow" aria-hidden="true"></span>
        <span class="question__icon">
          <Icon name={item.icon} size={22} />
        </span>
        <a class="question__link" href={href(item.page, locale, item.hash)}>
          {item.q[locale]}
        </a>
        <p class="question__answer">{item.a[locale]}</p>
        {item.status && <StatusBadge status={item.status} />}
        <Icon name="arrowRight" size={18} class="question__arrow" />
      </li>
    ))
  }
</ul>

<style>
  .questions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-3);
  }
  .question {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr auto;
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    align-items: start;
    margin: 0;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .question:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .question:has(.question__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .question__icon {
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--accent);
  }
  .question__link {
    font-weight: 700;
    font-size: var(--step-0);
    color: var(--text);
    text-decoration: none;
  }
  .question__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .question__link:focus-visible {
    outline: none;
  }
  .question__answer {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .question :global(.status) {
    justify-self: start;
    margin-top: var(--space-1);
  }
  .question :global(.question__arrow) {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    color: var(--text-subtle);
  }
</style>

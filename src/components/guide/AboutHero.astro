<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const me of document.querySelectorAll<HTMLElement>('[data-me]')) {
    const { bleat: bleatText, blink: blinkText } = JSON.parse(me.dataset.me ?? '{}');
    const head = me.querySelector<HTMLButtonElement>('[data-head]')!;
    const body = me.querySelector<HTMLElement>('[data-body]')!;
    const bleat = me.querySelector<HTMLElement>('[data-bleat]')!;
    const eyes = [...me.querySelectorAll<SVGGraphicsElement>('[data-eye]')];
    const boil = me.querySelector('[data-boil]');

    // Cartoon line boil: a new noise seed a few times a second.
    if (boil && !reduced) {
      let seed = 1;
      window.setInterval(() => {
        if (document.hidden) return;
        seed = (seed % 3) + 1;
        boil.setAttribute('seed', String(seed));
      }, 140);
    }

    // Spring physics: the head chases the pointer while held and its spot otherwise.
    let x = 0;
    let y = 0;
    let vx = 0;
    let vy = 0;
    let tx = 0;
    let ty = 0;
    let angle = 0;
    let held = false;
    let moved = false;
    let grabX = 0;
    let grabY = 0;
    let running = false;
    let switching = false;
    let trailTick = 0;

    /** Arcane motes left behind while he is dragged around. */
    const trail = () => {
      const box = head.getBoundingClientRect();
      const origin = me.getBoundingClientRect();
      const mote = document.createElement('span');
      mote.className = 'me__trail';
      mote.style.left = `${box.left - origin.left + box.width / 2 + (Math.random() - 0.5) * 60}px`;
      mote.style.top = `${box.top - origin.top + box.height / 2 + (Math.random() - 0.5) * 60}px`;
      me.append(mote);
      window.setTimeout(() => mote.remove(), 700);
    };

    const frame = () => {
      const k = held ? 0.22 : 0.075;
      const damping = held ? 0.72 : 0.86;
      vx = (vx + (tx - x) * k) * damping;
      vy = (vy + (ty - y) * k) * damping;
      x += vx;
      y += vy;
      // Lean into the movement, like something on a string.
      angle += (Math.max(-28, Math.min(28, vx * 1.6)) - angle) * 0.2;
      const stretch = Math.min(0.12, Math.hypot(vx, vy) / 120);
      head.style.transform = `translate(${x}px, ${y}px) rotate(${angle}deg) scale(${1 - stretch}, ${1 + stretch})`;
      if (held && Math.hypot(vx, vy) > 3 && (trailTick = (trailTick + 1) % 3) === 0) trail();
      const still = Math.abs(vx) + Math.abs(vy) + Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(angle) < 0.08;
      if (held || !still) requestAnimationFrame(frame);
      else running = false;
    };
    const run = () => {
      if (running || reduced) return;
      running = true;
      requestAnimationFrame(frame);
    };

    // The glowing eyes look at the pointer.
    me.addEventListener('pointermove', (event) => {
      for (const eye of eyes) {
        const box = eye.getBoundingClientRect();
        const dx = event.clientX - (box.left + box.width / 2);
        const dy = event.clientY - (box.top + box.height / 2);
        const length = Math.hypot(dx, dy) || 1;
        eye.style.transform = `translate(${(dx / length) * 5}px, ${(dy / length) * 4}px)`;
      }
    });

    const say = (text: string) => {
      bleat.textContent = text;
      bleat.classList.remove('is-on');
      void bleat.offsetWidth;
      bleat.classList.add('is-on');
    };

    const burst = () => {
      if (reduced) return;
      const colors = ['#ffffff', '#ffd100', '#ff9ef5', '#9fe0ff'];
      for (let i = 0; i < 18; i++) {
        const spark = document.createElement('span');
        spark.className = i % 3 ? 'me__spark' : 'me__spark me__spark--star';
        const a = (i / 18) * Math.PI * 2 + Math.random() * 0.3;
        const d = 100 + Math.random() * 90;
        spark.style.setProperty('--dx', `${Math.cos(a) * d}px`);
        spark.style.setProperty('--dy', `${Math.sin(a) * d}px`);
        spark.style.setProperty('--c', colors[i % colors.length]!);
        body.append(spark);
        window.setTimeout(() => spark.remove(), 900);
      }
      const puff = document.createElement('span');
      puff.className = 'me__puff';
      body.append(puff);
      window.setTimeout(() => puff.remove(), 700);
      vy -= 16;
      run();
    };

    // The toggle: Human in Dalaran or Forsaken in Lordaeron.
    const toggle = me.querySelector<HTMLButtonElement>('[data-toggle]')!;
    toggle.addEventListener('click', () => {
      const undead = me.dataset.scene !== 'forsaken';
      me.dataset.scene = undead ? 'forsaken' : 'human';
      toggle.setAttribute('aria-pressed', String(undead));
    });

    let sheepTimer: number | undefined;
    const polymorph = () => {
      const isSheep = me.classList.toggle('is-sheep');
      burst();
      window.clearTimeout(sheepTimer);
      if (isSheep) {
        say(bleatText);
        sheepTimer = window.setTimeout(() => {
          me.classList.remove('is-sheep');
          burst();
        }, 6000);
      }
    };

    /** Where the head's centre is, inside the scene. */
    const headCentre = () => {
      const box = head.getBoundingClientRect();
      const origin = me.getBoundingClientRect();
      return { cx: box.left - origin.left + box.width / 2, cy: box.top - origin.top + box.height / 2 };
    };
    /** A short-lived effect element at a point of the scene. */
    const effect = (className: string, cx: number, cy: number, ms: number) => {
      const el = document.createElement('span');
      el.className = className;
      el.style.left = `${cx}px`;
      el.style.top = `${cy}px`;
      me.append(el);
      window.setTimeout(() => el.remove(), ms);
      return el;
    };

    /**
     * Blink, like the spell: he flashes out where he was let go, a streak of
     * arcane light shoots to his usual spot and he flashes back in there.
     */
    const blink = () => {
      if (switching) return;
      switching = true;
      say(blinkText);
      if (reduced) {
        switching = false;
        return;
      }
      const from = headCentre();
      effect('me__flash', from.cx, from.cy, 500);
      me.classList.add('is-blinking');
      window.setTimeout(() => {
        me.classList.remove('is-blinking');
        x = 0;
        y = 0;
        vx = 0;
        vy = 0;
        tx = 0;
        ty = 0;
        angle = 0;
        head.style.transform = '';
        const to = headCentre();
        const streak = effect('me__streak', from.cx, from.cy, 450);
        streak.style.width = `${Math.hypot(to.cx - from.cx, to.cy - from.cy)}px`;
        streak.style.setProperty('--a', `${Math.atan2(to.cy - from.cy, to.cx - from.cx)}rad`);
        effect('me__flash', to.cx, to.cy, 500);
        me.classList.add('is-arriving');
        window.setTimeout(() => {
          me.classList.remove('is-arriving');
          switching = false;
        }, 300);
      }, 140);
    };

    head.addEventListener('pointerdown', (event) => {
      if (reduced || event.button !== 0 || switching) return;
      held = true;
      moved = false;
      grabX = event.clientX - x;
      grabY = event.clientY - y;
      tx = x;
      ty = y;
      head.setPointerCapture(event.pointerId);
      me.classList.add('is-held');
      run();
    });
    head.addEventListener('pointermove', (event) => {
      if (!held) return;
      tx = event.clientX - grabX;
      ty = event.clientY - grabY;
      if (Math.hypot(tx, ty) > 8) moved = true;
    });
    const release = () => {
      if (!held) return;
      held = false;
      me.classList.remove('is-held');
      const far = Math.hypot(tx, ty) > Math.min(180, me.clientWidth / 4);
      tx = 0;
      ty = 0;
      run();
      if (moved && far) blink();
    };
    head.addEventListener('pointerup', release);
    head.addEventListener('pointercancel', release);
    // A drag also fires click on release: only a real click (or Enter) casts Polymorph.
    head.addEventListener('click', () => {
      if (moved) {
        moved = false;
        return;
      }
      polymorph();
    });
  }
</script>

<style>
  .me {
    --ink: #140f22;

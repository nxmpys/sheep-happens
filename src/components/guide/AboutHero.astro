    clip-path: circle(150% at 92% 8%);
  }
  /* A few loose Plague bubbles rising from the glow and fading out. */
  .me__scene--forsaken::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 14% 92%, rgb(170 240 80 / 0.6) 0 4px, transparent 5px),
      radial-gradient(circle at 31% 80%, rgb(170 240 80 / 0.45) 0 3px, transparent 4px),
      radial-gradient(circle at 68% 88%, rgb(170 240 80 / 0.5) 0 5px, transparent 6px),
      radial-gradient(circle at 83% 76%, rgb(170 240 80 / 0.4) 0 3px, transparent 4px),

        <g data-eye><circle class="iris" cx="116" cy="113.5" r="4"></circle><circle fill="#fff" cx="117.3" cy="112.2" r="1.2"></circle></g>
        <path class="lid" d="M73 114q11-9 22 0m10 0q11-9 22 0"></path>

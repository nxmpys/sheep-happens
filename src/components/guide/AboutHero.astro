---
/**
 * Top of the about page, in the spirit of adrienlamy.fr: a hand-drawn author on
 * one bold colour, where every gesture is a Mage spell. His eyes follow the
 * pointer and light up with Arcane Intellect on hover. Click: Polymorph, he
 * becomes a sheep for a while. Drag: he leaves an arcane trail, and letting go
 * far away casts Blink. A toggle swaps the Human in Dalaran for what he plays
 * in Forever: a Forsaken in the ruins of Lordaeron, as Warcraft III ends. The
 * lines "boil" like a cartoon by switching the seed of a small displacement
 * filter.
 */
import '@fontsource/permanent-marker';
import { getLocale } from '../../i18n/locale';

const es = getLocale(Astro) === 'es';
const strings = es
  ? {
      who: '¿Quién soy?',
      drag: 'Arrástrame lejos',
      click: 'Clic',
      kind: 'En Forever…',
      undead: 'No-muerto',
      horde: 'Horda · EU-PvP',
      dalaran: 'Dalaran',
      lordaeron: 'Ruinas de Lordaeron',
      human: 'Humano',
      toggle: 'Ver mi personaje en Forever, no-muerto',
      bleat: '¡Beee!',
      blink: '¡Traslación!',
      label: 'Nxmpys: haz clic para lanzarle Polimorfia o arrástralo lejos para lanzar Traslación',
    }
  : {
      who: 'Who am I?',
      drag: 'Drag me far',
      click: 'Click',
      kind: 'In Forever…',
      undead: 'Undead',
      horde: 'Horde · EU-PvP',
      dalaran: 'Dalaran',
      lordaeron: 'Ruins of Lordaeron',
      human: 'Human',
      toggle: 'Show my character in Forever, Undead',
      bleat: 'Baaa!',
      blink: 'Blink!',
      label: 'Nxmpys: click to cast Polymorph on him or drag him far to cast Blink',
    };
---


---
/**
 * Top of the about page, in the spirit of adrienlamy.fr: a hand-drawn author on
 * one bold colour, where every gesture is a Mage spell. His eyes follow the
 * pointer and light up with Arcane Intellect on hover. Click: Polymorph, he
 * becomes a sheep for a while. Drag: he leaves an arcane trail, and letting go
 * far away casts Blink to the other scene, where he is what he
 * plays in Forever: a Forsaken, the Undead that Humans become. The lines
 * "boil" like a cartoon by switching the seed of a small displacement filter.
 */
import '@fontsource/permanent-marker';
import { getLocale } from '../../i18n/locale';

const es = getLocale(Astro) === 'es';
const strings = es
  ? {
      who: '¿Quién soy?',
      me: 'Yo',
      drag: 'Arrástrame lejos',
      click: 'Clic',
      kind: 'En Forever…',
      undead: 'No-muerto',
      still: 'Sigo siendo yo',
      horde: 'Horda · EU-PvP',
      back: 'Traslación de vuelta',
      bleat: '¡Beee!',
      blink: '¡Traslación!',
      label: 'Nxmpys: haz clic para lanzarle Polimorfia o arrástralo lejos para lanzar Traslación',
    }
  : {
      who: 'Who am I?',
      me: 'Me',
      drag: 'Drag me far',
      click: 'Click',
      kind: 'In Forever…',
      undead: 'Undead',
      still: 'Still me',
      horde: 'Horde · EU-PvP',
      back: 'Blink back',
      bleat: 'Baaa!',
      blink: 'Blink!',
      label: 'Nxmpys: click to cast Polymorph on him or drag him far to cast Blink',
    };
---

<section class="me" data-no-spell-links aria-label={strings.who} data-me={JSON.stringify({ bleat: strings.bleat, blink: strings.blink })} data-scene="human">
  <svg class="me__defs" width="0" height="0" aria-hidden="true">
    <filter id="me-boil">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1" data-boil />
      <feDisplacementMap in="SourceGraphic" scale="3" />
    </filter>
  </svg>

  <!-- Scene 1: the author as a Human, on Alliance blue. -->
  <div class="me__scene me__scene--human">
    <p class="me__who">{strings.who}</p>
    <p class="me__name" aria-hidden="true">Nxmpys</p>
    <p class="note note--me" aria-hidden="true">
      {strings.me}
      <svg viewBox="0 0 60 24" width="54" height="22"><path d="M2 14c12-6 28-8 50-2m-9-8 10 8-11 6"></path></svg>
    </p>
    <p class="note note--drag" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="44" height="44">
        <circle cx="16" cy="12" r="5"></circle><path d="M16 17v13m0-9 10-4m-10 13-6 10m6-10 7 9M30 8c6 2 10 6 12 12m-3-1 3 2 2-4"></path>
      </svg>
      {strings.drag}
    </p>
    <p class="note note--click" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="44" height="44">
        <path d="M24 4v8m-14 6h8m20 0h-8M12 8l6 6m18-6-6 6M22 22l5 16 4-7 7 7 3-3-7-7 7-4z"></path>
      </svg>
      {strings.click}
    </p>
  </div>

  <!-- Scene 2: the same author as a Forsaken, on the Horde's night. -->
  <div class="me__scene me__scene--forsaken" aria-hidden="true">
    <p class="me__kind">{strings.kind}</p>
    <p class="me__name me__name--light">{strings.undead}</p>
    <p class="note note--still">
      {strings.still}
      <svg viewBox="0 0 60 24" width="54" height="22"><path d="M2 14c12-6 28-8 50-2m-9-8 10 8-11 6"></path></svg>
    </p>
    <p class="note note--horde">{strings.horde}</p>
    <p class="note note--back">{strings.back}</p>
  </div>

  <button class="me__head" type="button" aria-label={strings.label} data-head>
    <span class="me__body" data-body>
      <!-- The author as a clean flat portrait, head from a photo: hair swept back with a fallen lock, faded sides, an Italian beard and a trimmed moustache. -->
      <svg class="art art--human portrait" viewBox="0 0 200 400" aria-hidden="true">
        <!-- Full body in the Arcanist Regalia, the Mage Tier 1 set from Molten Core: violet robe with gold trim, domed mantle with gems, belt and crown. -->
        <rect class="skin" x="92" y="108" width="16" height="22" rx="4"></rect>
        <path class="robe" d="M66 138q-22 52-32 124 14 10 32 4 4-56 14-106zm68 0q22 52 32 124-14 10-32 4-4-56-14-106z"></path>
        <path class="gold-line" d="M34 262q14 10 32 4m100-4q-14 10-32 4"></path>
        <ellipse class="skin" cx="50" cy="276" rx="9" ry="11"></ellipse>
        <ellipse class="skin" cx="150" cy="276" rx="9" ry="11"></ellipse>
        <ellipse class="boot" cx="84" cy="390" rx="14" ry="7"></ellipse>
        <ellipse class="boot" cx="116" cy="390" rx="14" ry="7"></ellipse>
        <path class="robe" d="M70 128q30-8 60 0l20 122 18 136q-68 10-136 0l18-136z"></path>

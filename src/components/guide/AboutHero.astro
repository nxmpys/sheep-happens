        </g>
        <path class="gold" d="M66 46q34-14 68 0l-2 6q-32-12-64 0z"></path>
        <path class="gem" d="M100 30l5 8-5 8-5-8z"></path>
      </svg>

      <!-- Polymorph: the same author, as a sheep. -->
      <svg class="art art--sheep" viewBox="0 -110 200 400" aria-hidden="true">
        <g class="ink">
          <path class="fill-ink" d="M70 172v30m20-28v30m24-30v30m20-32v30"></path>
          <path class="fill-paper" d="M44 122c-10-22 8-46 30-42 6-20 36-24 48-8 20-10 44 6 40 28 20 8 18 38-2 44 2 22-24 34-42 22-14 14-40 12-48-6-22 2-36-22-26-38z"></path>
          <ellipse class="fill-ink" cx="100" cy="116" rx="26" ry="32"></ellipse>
          <ellipse class="fill-ink" cx="68" cy="100" rx="16" ry="7" transform="rotate(-20 68 100)"></ellipse>
          <ellipse class="fill-ink" cx="132" cy="100" rx="16" ry="7" transform="rotate(20 132 100)"></ellipse>
          <circle class="fill-paper" cx="89" cy="110" r="7"></circle>
          <circle class="fill-paper" cx="111" cy="110" r="7"></circle>
          <circle class="fill-ink" cx="90" cy="111" r="3"></circle>
          <circle class="fill-ink" cx="112" cy="111" r="3"></circle>
          <path class="stroke-paper" d="M92 134q4 4 8 0 4 4 8 0"></path>
        </g>
      </svg>

      <!-- The same portrait as a Forsaken: the very same face in bone, no beard, two holes for a nose, dark sockets with glowing eyes, bare teeth, cheekbones, jaw line and a cracked forehead. -->
      <svg class="art art--forsaken portrait portrait--undead" viewBox="0 0 200 400" aria-hidden="true">
        <!-- Full body in the Arcanist Regalia, the Mage Tier 1 set from Molten Core: violet robe with gold trim, domed mantle with gems, belt and crown. -->
        <rect class="skin" x="92" y="108" width="16" height="22" rx="4"></rect>
        <path class="robe" d="M66 138q-22 52-32 124 14 10 32 4 4-56 14-106zm68 0q22 52 32 124-14 10-32 4-4-56-14-106z"></path>
        <path class="gold-line" d="M34 262q14 10 32 4m100-4q-14 10-32 4"></path>
        <ellipse class="skin" cx="50" cy="276" rx="9" ry="11"></ellipse>
        <ellipse class="skin" cx="150" cy="276" rx="9" ry="11"></ellipse>
        <ellipse class="boot" cx="84" cy="390" rx="14" ry="7"></ellipse>
        <ellipse class="boot" cx="116" cy="390" rx="14" ry="7"></ellipse>
        <path class="robe" d="M70 128q30-8 60 0l20 122 18 136q-68 10-136 0l18-136z"></path>
        <path class="robe-panel" d="M90 140h20l14 248q-24 4-48 0z"></path>
        <path class="gold-line" d="M90 140l-14 248m34-248 14 248M32 386q68 10 136 0"></path>
        <path class="gold" d="M93 296l7-10 7 10-7 10zm2 44 5-8 5 8-5 8z"></path>
        <path class="gold" d="M53 236q47 12 94 0l1 14q-48 12-96 0z"></path>
        <circle class="gem" cx="100" cy="249" r="6"></circle>
        <path class="gold-line" d="M76 126l24 32 24-32"></path>
        <path class="robe-panel" d="M42 152q-2-36 38-38 14 6 12 22-26-4-50 16zm116 0q2-36-38-38-14 6-12 22 26-4 50 16z"></path>
        <path class="gold-line" d="M42 152q-2-36 38-38 14 6 12 22-26-4-50 16l-10-12m126 12q2-36-38-38-14 6-12 22 26-4 50 16l10-12"></path>
        <circle class="gem" cx="66" cy="128" r="4.5"></circle>
        <circle class="gem" cx="134" cy="128" r="4.5"></circle>
        <g transform="translate(38 2) scale(0.62)">
        <ellipse class="skin" cx="56" cy="122" rx="8" ry="13"></ellipse>
        <ellipse class="skin" cx="144" cy="122" rx="8" ry="13"></ellipse>
        <path class="skin" d="M56 102c0-28 20-46 44-46s44 18 44 46c0 28-4 46-14 60-10 14-20 22-30 22s-20-8-30-22c-10-14-14-32-14-60z"></path>
        <path class="skin-shade" d="M138 108c0 30-6 50-20 64 14-6 22-22 24-42 1-8 0-16-4-22z"></path>
        <path class="hair-fill fade" d="M56 110c-2-16 2-28 8-34l4 30zm88 0c2-16-2-28-8-34l-4 30z"></path>
        <path class="hair-fill" d="M57 92c-6-34 14-60 48-62 30-2 50 16 48 50-2 6-4 10-8 12-2-8-8-14-16-16-12-6-30-8-46-4-12 4-20 10-26 20z"></path>
        <path class="hair-fill" d="M68 50c12-22 46-32 74-18 6 4 10 8 12 14-12-8-30-10-46-6-16 4-28 8-40 10z"></path>
        <path class="hair-fill" d="M116 64c16 2 28 14 28 32-4-8-10-14-18-16 2 8 0 14-4 18-1-12-2-24-6-34z"></path>
        <path class="hair-shine" d="M74 56c18-14 44-18 66-10M66 74c18-12 42-16 66-12"></path>
        <path class="hair-fill" d="M70 100c8-6 18-7 26-3l-1 4c-8-3-17-2-24 3z"></path>
        <path class="hair-fill" d="M130 100c-8-6-18-7-26-3l1 4c8-3 17-2 24 3z"></path>
        <path class="skin-shade" d="M69 115q15-14 30 0-15 12-30 0zm32 0q15-14 30 0-15 12-30 0z"></path>
        <path class="socket" d="M73 114q11-8 22 0-11 6-22 0z"></path>
        <path class="socket" d="M105 114q11-8 22 0-11 6-22 0z"></path>
        <circle class="glow" cx="84" cy="113.5" r="3.6" data-eye></circle>
        <circle class="glow" cx="116" cy="113.5" r="3.6" data-eye></circle>
        <path class="lid" d="M73 114q11-9 22 0m10 0q11-9 22 0"></path>
        <ellipse class="socket" cx="96" cy="138" rx="2.6" ry="4" transform="rotate(18 96 138)"></ellipse>
        <ellipse class="socket" cx="104" cy="138" rx="2.6" ry="4" transform="rotate(-18 104 138)"></ellipse>
        <path class="socket" d="M82 149q18 5 36 0v12q-18 6-36 0z"></path>
        <path class="teeth" d="M83 150q17 4 34 0v4.5q-17 4-34 0zm0 6q17 4 34 0v3.5q-17 4.5-34 0z"></path>
        <path class="teeth-gaps" d="M89 150v11m6-10v11m5-11v11m5-11v11m6-10v10"></path>
        <path class="cheekbone" d="M64 126q8 12 22 14m50-14q-8 12-22 14M70 148q6 18 18 28m42-28q-6 18-18 28M108 80l-3 6 4 5-3 7"></path>
        </g>
        <path class="gold" d="M66 46q34-14 68 0l-2 6q-32-12-64 0z"></path>
        <path class="gem" d="M100 30l5 8-5 8-5-8z"></path>
      </svg>

      <span class="me__bleat" data-bleat aria-hidden="true"></span>
    </span>
  </button>

</section>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const me of document.querySelectorAll<HTMLElement>('[data-me]')) {
    const { bleat: bleatText, blink: blinkText } = JSON.parse(me.dataset.me ?? '{}');
    const head = me.querySelector<HTMLButtonElement>('[data-head]')!;
    const body = me.querySelector<HTMLElement>('[data-body]')!;
    const bleat = me.querySelector<HTMLElement>('[data-bleat]')!;
    const eyes = [...me.querySelectorAll<SVGGraphicsElement>('[data-eye]')];
    const boil = me.querySelector('[data-boil]');

    // Cartoon line boil: a new noise seed a few times a second.
    if (boil && !reduced) {
      let seed = 1;
      window.setInterval(() => {
        if (document.hidden) return;
        seed = (seed % 3) + 1;
        boil.setAttribute('seed', String(seed));
      }, 140);
    }

    // Spring physics: the head chases the pointer while held and its spot otherwise.
    let x = 0;
    let y = 0;
    let vx = 0;
    let vy = 0;
    let tx = 0;
    let ty = 0;
    let angle = 0;
    let held = false;
    let moved = false;
    let grabX = 0;
    let grabY = 0;
    let running = false;
    let switching = false;
    let trailTick = 0;

    /** Arcane motes left behind while he is dragged around. */
    const trail = () => {
      const box = head.getBoundingClientRect();
      const origin = me.getBoundingClientRect();
      const mote = document.createElement('span');
      mote.className = 'me__trail';
      mote.style.left = `${box.left - origin.left + box.width / 2 + (Math.random() - 0.5) * 60}px`;
      mote.style.top = `${box.top - origin.top + box.height / 2 + (Math.random() - 0.5) * 60}px`;
      me.append(mote);
      window.setTimeout(() => mote.remove(), 700);
    };

    const frame = () => {
      const k = held ? 0.22 : 0.075;
      const damping = held ? 0.72 : 0.86;
      vx = (vx + (tx - x) * k) * damping;
      vy = (vy + (ty - y) * k) * damping;
      x += vx;
      y += vy;
      // Lean into the movement, like something on a string.
      angle += (Math.max(-28, Math.min(28, vx * 1.6)) - angle) * 0.2;
      const stretch = Math.min(0.12, Math.hypot(vx, vy) / 120);
      head.style.transform = `translate(${x}px, ${y}px) rotate(${angle}deg) scale(${1 - stretch}, ${1 + stretch})`;
      if (held && Math.hypot(vx, vy) > 3 && (trailTick = (trailTick + 1) % 3) === 0) trail();
      const still = Math.abs(vx) + Math.abs(vy) + Math.abs(tx - x) + Math.abs(ty - y) + Math.abs(angle) < 0.08;
      if (held || !still) requestAnimationFrame(frame);
      else running = false;
    };
    const run = () => {
      if (running || reduced) return;
      running = true;
      requestAnimationFrame(frame);
    };

    // The glowing eyes look at the pointer.
    me.addEventListener('pointermove', (event) => {
      for (const eye of eyes) {
        const box = eye.getBoundingClientRect();
        const dx = event.clientX - (box.left + box.width / 2);
        const dy = event.clientY - (box.top + box.height / 2);
        const length = Math.hypot(dx, dy) || 1;
        eye.style.transform = `translate(${(dx / length) * 5}px, ${(dy / length) * 4}px)`;
      }
    });

    const say = (text: string) => {
      bleat.textContent = text;
      bleat.classList.remove('is-on');
      void bleat.offsetWidth;
      bleat.classList.add('is-on');
    };

    const burst = () => {
      if (reduced) return;
      const colors = ['#ffffff', '#ffd100', '#ff9ef5', '#9fe0ff'];
      for (let i = 0; i < 18; i++) {
        const spark = document.createElement('span');
        spark.className = i % 3 ? 'me__spark' : 'me__spark me__spark--star';
        const a = (i / 18) * Math.PI * 2 + Math.random() * 0.3;
        const d = 100 + Math.random() * 90;
        spark.style.setProperty('--dx', `${Math.cos(a) * d}px`);
        spark.style.setProperty('--dy', `${Math.sin(a) * d}px`);
        spark.style.setProperty('--c', colors[i % colors.length]!);
        body.append(spark);
        window.setTimeout(() => spark.remove(), 900);
      }
      const puff = document.createElement('span');
      puff.className = 'me__puff';
      body.append(puff);
      window.setTimeout(() => puff.remove(), 700);
      vy -= 16;
      run();
    };

    let sheepTimer: number | undefined;
    const polymorph = () => {
      const isSheep = me.classList.toggle('is-sheep');
      burst();
      window.clearTimeout(sheepTimer);
      if (isSheep) {
        say(bleatText);
        sheepTimer = window.setTimeout(() => {
          me.classList.remove('is-sheep');
          burst();
        }, 6000);
      }
    };

    /** Where the head's centre is, inside the scene. */
    const headCentre = () => {
      const box = head.getBoundingClientRect();
      const origin = me.getBoundingClientRect();
      return { cx: box.left - origin.left + box.width / 2, cy: box.top - origin.top + box.height / 2 };
    };
    /** A short-lived effect element at a point of the scene. */
    const effect = (className: string, cx: number, cy: number, ms: number) => {
      const el = document.createElement('span');
      el.className = className;
      el.style.left = `${cx}px`;
      el.style.top = `${cy}px`;
      me.append(el);
      window.setTimeout(() => el.remove(), ms);
      return el;
    };

    /**
     * Blink, like the spell: he flashes out where he was let go, a streak of
     * arcane light shoots to his usual spot and he flashes back in there, while
     * the background fades to the other scene.
     */
    const switchScene = () => {
      if (switching) return;
      switching = true;
      const next = me.dataset.scene === 'human' ? 'forsaken' : 'human';
      say(blinkText);
      if (reduced) {
        me.dataset.scene = next;
        switching = false;
        return;
      }
      const from = headCentre();
      effect('me__flash', from.cx, from.cy, 500);
      me.classList.add('is-blinking');
      window.setTimeout(() => {
        me.dataset.scene = next;
        me.classList.remove('is-sheep', 'is-blinking');
        x = 0;
        y = 0;
        vx = 0;
        vy = 0;
        tx = 0;
        ty = 0;
        angle = 0;
        head.style.transform = '';
        const to = headCentre();
        const streak = effect('me__streak', from.cx, from.cy, 450);
        streak.style.width = `${Math.hypot(to.cx - from.cx, to.cy - from.cy)}px`;
        streak.style.setProperty('--a', `${Math.atan2(to.cy - from.cy, to.cx - from.cx)}rad`);
        effect('me__flash', to.cx, to.cy, 500);
        me.classList.add('is-arriving');
        window.setTimeout(() => {
          me.classList.remove('is-arriving');
          switching = false;
        }, 300);
      }, 140);
    };

    head.addEventListener('pointerdown', (event) => {
      if (reduced || event.button !== 0 || switching) return;
      held = true;
      moved = false;
      grabX = event.clientX - x;
      grabY = event.clientY - y;
      tx = x;
      ty = y;
      head.setPointerCapture(event.pointerId);
      me.classList.add('is-held');
      run();
    });
    head.addEventListener('pointermove', (event) => {
      if (!held) return;
      tx = event.clientX - grabX;
      ty = event.clientY - grabY;
      if (Math.hypot(tx, ty) > 8) moved = true;
    });
    const release = () => {
      if (!held) return;
      held = false;
      me.classList.remove('is-held');
      const far = Math.hypot(tx, ty) > Math.min(180, me.clientWidth / 4);
      tx = 0;
      ty = 0;
      run();
      if (moved && far) switchScene();
    };
    head.addEventListener('pointerup', release);
    head.addEventListener('pointercancel', release);
    // A drag also fires click on release: only a real click (or Enter) casts Polymorph.
    head.addEventListener('click', () => {
      if (moved) {
        moved = false;
        return;
      }
      polymorph();
    });
  }
</script>


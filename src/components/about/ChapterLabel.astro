---
/** «CHAPTER I — MISTS OF PANDARIA»: a small rune stroke that draws itself, then the words. */
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<p class="chapter" data-reveal>
  <svg class="chapter__rune" viewBox="0 0 120 14" aria-hidden="true">
    <path d="M2 7H40L46 2L52 12L58 2L64 12L70 7H118" pathLength="1"></path>
  </svg>
  <span>{text}</span>
</p>

<style>
  .chapter {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chapter, #e5c97f);
  }
  .chapter__rune {
    flex: none;
    width: 4.5rem;
    height: 12px;
  }
  .chapter__rune path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.6, 0, 0.2, 1) 0.15s;
  }
  :global(.story.is-live) .chapter:not(.is-in) .chapter__rune path {
    stroke-dashoffset: 1;
  }
</style>

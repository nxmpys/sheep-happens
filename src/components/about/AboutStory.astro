---
/**
 * The about page as a story told by scrolling, in four scenes: Pandaria
 * (StoryHero), the Warlock years, the Demon Hunter era and the turn to
 * Classic Mage. Native scroll only: reveals, the pinned
 * pictures and the chapter marks come from IntersectionObserver in
 * about-story.ts, the rest is CSS. Everything is readable with JavaScript off
 * or reduced motion; the pictures then simply stay on their first state.
 *
 * The band is always dark (color-scheme: dark), whatever the site theme, and
 * its ambient light changes colour with the chapter (Pandaria gold, fel
 * green, Classic blue) and, in the pinned chapters, with each picture's frame.
 *
 * Type: Fraunces (soft axis) for titles and Nunito for the text, looser and
 * friendlier than the guide's Spectral/Inter; the story swaps the site's
 * font tokens for them, so every child picks them up.
 */
import '@fontsource/permanent-marker';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/nunito/wght.css';
import ChapterLabel from './ChapterLabel.astro';
import StoryArt from './StoryArt.astro';
import StoryFrame from './StoryFrame.astro';
import StoryHero from './StoryHero.astro';
import StoryProgress from './StoryProgress.astro';
import StoryTimeline from './StoryTimeline.astro';
import { STORY_COPY } from './story-copy';
import { FRAME_COLORS, STORY_IMAGES, type StoryArtName } from './story-images';
import { getLocale } from '../../i18n/locale';

const locale = getLocale(Astro);
const copy = STORY_COPY[locale];
const chapterIds = ['story-start', 'chapter-1', 'chapter-2', 'chapter-3'];
// One picture per step of the pinned scenes, in step order.
const hunterLayers: StoryArtName[] = ['hunter', 'bfa', 'shadowlands', 'dragonflight'];
const classicLayers: StoryArtName[] = ['mage', 'tbc', 'forever'];
/** Captions wear their picture's frame colour. */
const captionColor = (name: StoryArtName) => `color: ${FRAME_COLORS[STORY_IMAGES[name].frame].a}`;
/** The ambient light behind a step: its picture's frame glow (about-story.ts applies it). */
const glowOf = (name: StoryArtName) => FRAME_COLORS[STORY_IMAGES[name].frame].glow;
---

<div class="story" data-story data-chapter="0" data-no-spell-links aria-label={copy.label}>
  <div class="story__glow" aria-hidden="true"></div>
  <StoryProgress labels={copy.progress} ids={chapterIds} label={copy.chapters} />

  <StoryHero locale={locale} copy={copy.hero} />

  {/* Chapter I: the Warlock, PvP, then two expansions away. */}
  <section class="scene scene--pandaria" id="chapter-1" data-chapter="1" aria-labelledby="chapter-1-title">
    <div class="story__inner split">
      <figure class="split__art" data-reveal data-mask>
        <StoryArt name="warlock" locale={locale} />
        <StoryFrame variant={STORY_IMAGES.warlock.frame} />
      </figure>
      <div class="split__copy">
        <ChapterLabel text={copy.pandaria.chapter} />
        <h2 class="scene__title" id="chapter-1-title" data-reveal>{copy.pandaria.title}</h2>
        {
          copy.pandaria.body.map((text, i) => (
            <p class:list={['scene__text', i === 1 && 'scene__text--beat']} data-reveal>
              {text}
            </p>
          ))
        }
      </div>
    </div>
    <div class="story__inner timeline-row">
      <StoryTimeline items={copy.pandaria.timeline} label={copy.pandaria.chapter} />
      <p class="marker marker--gold" data-reveal aria-hidden="true">{copy.pandaria.note}</p>
    </div>
  </section>

  {/* Chapter II: the Demon Hunter, Mythic+, Shadowlands and the calmer expansions. On wide screens the picture stays pinned while the text moves on. */}
  <section class="scene scene--hunter" id="chapter-2" data-chapter="2" aria-labelledby="chapter-2-title">
    <header class="story__inner scene__head">
      <ChapterLabel text={copy.hunter.chapter} />
      <h2 class="scene__title" id="chapter-2-title" data-reveal>{copy.hunter.title}</h2>
    </header>
    <div class="story__inner scrolly" data-scrolly>
      <div class="scrolly__stage" data-stage data-active="0" aria-hidden="true">
        {
          hunterLayers.map((name, i) => (
            <div class="layer" data-layer={i}>
              <StoryArt name={name} locale={locale} />
              <StoryFrame variant={STORY_IMAGES[name].frame} />
            </div>
          ))
        }
        <ol class="stage__captions">
          {copy.hunter.steps.map((step, i) => <li data-caption={i} style={captionColor(hunterLayers[i]!)}>{step.caption}</li>)}
        </ol>
      </div>
      <ol class="scrolly__steps">
        {
          copy.hunter.steps.map((step, i) => (
            <li class="step" data-step={i} data-glow={glowOf(hunterLayers[i]!)}>
              {/* Phones show each step's picture right above its text instead of the pinned stage. */}
              <figure class="step__media" data-reveal>
                <StoryArt name={hunterLayers[i]!} locale={locale} />
                <StoryFrame variant={STORY_IMAGES[hunterLayers[i]!].frame} />
                <figcaption class="step__caption" style={captionColor(hunterLayers[i]!)}>{step.caption}</figcaption>
              </figure>
              <div class="step__box">
                <p>{step.text}</p>
                {step.note && <p class="marker marker--fel">{step.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Chapter III: the Mage in Classic and TBC, then Forever. */}
  <section class="scene scene--classic" id="chapter-3" data-chapter="3" aria-labelledby="chapter-3-title">
    <header class="story__inner scene__head">
      <ChapterLabel text={copy.classic.chapter} />
      <h2 class="scene__title" id="chapter-3-title" data-reveal>{copy.classic.title}</h2>
    </header>
    <div class="story__inner scrolly scrolly--wide" data-scrolly>
      <div class="scrolly__stage" data-stage data-active="0" aria-hidden="true">
        {
          classicLayers.map((name, i) => (
            <div class="layer" data-layer={i}>
              <StoryArt name={name} locale={locale} />
              <StoryFrame variant={STORY_IMAGES[name].frame} />
            </div>
          ))
        }
        <ol class="stage__captions">
          {copy.classic.steps.map((step, i) => <li data-caption={i} style={captionColor(classicLayers[i]!)}>{step.caption}</li>)}
        </ol>
      </div>
      <ol class="scrolly__steps">
        {
          copy.classic.steps.map((step, i) => (
            <li class="step" data-step={i} data-glow={glowOf(classicLayers[i]!)}>
              {/* Phones show each step's picture right above its text instead of the pinned stage. */}
              <figure class="step__media" data-reveal>
                <StoryArt name={classicLayers[i]!} locale={locale} />
                <StoryFrame variant={STORY_IMAGES[classicLayers[i]!].frame} />
                <figcaption class="step__caption" style={captionColor(classicLayers[i]!)}>{step.caption}</figcaption>
              </figure>
              <div class="step__box">
                <p>{step.text}</p>
                {step.punch && <p class="step__punch">{step.punch}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</div>

<script>
  import '../../scripts/about-story';
</script>

<style>
  /* Full width out of the page column; the body clips the overflow so no sideways scroll. */
  :global(body:has(.story)) {
    overflow-x: clip;
  }
  .story {
    --glow-0: #f3b865;
    --glow-1: #f0a24a;
    --glow-2: #7cff3a;
    --glow-3: #8fc3e8;
    --font-display: 'Fraunces Variable', 'Spectral', Georgia, serif;
    --font-body: 'Nunito Variable', 'Inter Variable', system-ui, sans-serif;
    color-scheme: dark;
    position: relative;
    font-family: var(--font-body);
    font-variation-settings: 'SOFT' 100;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--space-5));
    background: #0e0d16;
    color: #ecebf4;
    overflow-x: clip;
    --focus: #ffd56a;
  }
  .story :global(:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .story :global(.story__inner) {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  /* Room for the chapter rail on the right. */
  @media (min-width: 1000px) {
    .story :global(.story__inner) {
      padding-inline: max(var(--gutter), 6rem);
    }
  }
  /* The ambient light: one pinned layer whose colour follows the chapter. */
  .story__glow {
    position: sticky;
    top: 0;
    height: 100svh;
    margin-bottom: -100svh;
    pointer-events: none;
    color: var(--glow-0);
    background:
      radial-gradient(55% 45% at 85% 20%, color-mix(in srgb, currentColor 14%, transparent), transparent 70%),
      radial-gradient(50% 40% at 10% 90%, color-mix(in srgb, currentColor 10%, transparent), transparent 70%);
    transition: color 1.6s ease;
  }
  .story[data-chapter='1'] {
    --glow: var(--glow-1);
  }
  .story[data-chapter='1'] .story__glow {
    color: var(--glow-1);
  }
  .story[data-chapter='2'] .story__glow {
    color: var(--glow-2);
  }
  .story[data-chapter='3'] .story__glow {
    color: var(--glow-3);
  }
  .story[data-chapter='0'] {
    --glow: var(--glow-0);
  }
  .story[data-chapter='2'] {
    --glow: #9dff6a;
  }
  .story[data-chapter='3'] {
    --glow: #9fd0f0;
  }

  /* ---- Reveals: only once the script runs with motion allowed (.is-live) ---- */
  .story :global([data-reveal]) {
    transition:
      opacity 0.8s ease var(--d, 0s),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s),
      clip-path 1.1s cubic-bezier(0.6, 0, 0.2, 1) var(--d, 0s);
  }
  .story:global(.is-live) :global([data-reveal]:not(.is-in)) {
    opacity: 0;
    transform: translateY(28px);
  }
  .story:global(.is-live) :global([data-mask]:not(.is-in)) {
    opacity: 1;
    transform: none;
    clip-path: inset(100% 0 0 0);
  }

  /* ---- Scenes ---- */
  .scene {
    position: relative;
    padding-block: clamp(5rem, 14vh, 9rem);
  }
  .scene--hunter {
    --chapter: #9dff6a;
  }
  .scene--classic {
    --chapter: #9fd0f0;
  }
  .scene__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .scene__title {
    max-width: 20ch;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #fff8ec;
  }
  .scene__title::before {
    content: none !important;
  }
  .scene__text {
    max-width: 36rem;
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.7;
    color: #d9d6e8;
  }
  .scene__text--beat {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    font-style: italic;
    color: #fff8ec;
  }
  .marker {
    margin: 0;
    font-family: 'Permanent Marker', var(--font-display);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    transform: rotate(-2deg);
  }
  .marker--gold {
    color: #e5c97f;
  }
  .marker--fel {
    margin-top: var(--space-3);
    color: #b8ff7e;
  }

  /* Chapter I: picture and text side by side, then the timeline across. */
  .split {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .split__art {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }
  .split__copy {
    display: grid;
    gap: var(--space-4);
  }
  .timeline-row {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(3rem, 8vh, 5rem);
  }
  .timeline-row .marker {
    justify-self: end;
  }
  @media (min-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
    .split__art {
      aspect-ratio: 5 / 4;
    }
  }

  /* ---- Pinned picture with text steps (chapters II and III) ---- */
  /*
   * Phones: no pinning. Each step is its own landscape picture with the text
   * under it. Wide screens (below) pin one stage beside the text instead.
   */
  .scrolly {
    display: grid;
  }
  .scrolly__stage {
    display: none;
    position: sticky;
    align-self: start;
    overflow: hidden;
    border-radius: var(--radius-lg);
    /* Its own compositing layer: playing video inside a pinned box no longer shivers while scrolling. */
    isolation: isolate;
    transform: translateZ(0);
  }
  .scrolly__steps {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    margin: 0 !important;
  }
  .step__media {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.5);
  }
  .step__caption {
    position: absolute;
    z-index: 6;
    top: var(--space-3);
    left: 50%;
    max-width: calc(100% - 6rem);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: rgb(14 13 22 / 0.75);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    width: max-content;
    line-height: 1.35;
    text-align: center;
    color: var(--chapter);
    transform: translateX(-50%);
  }
  .step__box {
    display: grid;
    gap: var(--space-3);
    max-width: 30rem;
    transition: opacity 0.4s ease;
  }
  .step__box p {
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.65;
  }
  .step__box .marker {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
  }
  .step__punch {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem) !important;
    font-style: italic;
    line-height: 1.25 !important;
    color: #fff8ec;
  }
  .layer {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    transition:
      opacity 0.8s ease,
      clip-path 1.2s cubic-bezier(0.6, 0, 0.2, 1),
      transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .stage__captions {
    position: absolute;
    z-index: 6;
    left: clamp(3.25rem, 5vw + 1rem, 5rem);
    top: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage__captions li {
    position: absolute;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: rgb(14 13 22 / 0.7);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--chapter);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  [data-active='0'] [data-caption='0'],
  [data-active='1'] [data-caption='1'],
  [data-active='2'] [data-caption='2'],
  [data-active='3'] [data-caption='3'] {
    opacity: 1;
    transform: none;
  }

  /* Each step shows its own layer: a crossfade with a slight settle. */
  .layer {
    opacity: 0;
    transform: scale(1.04);
  }
  [data-active='0'] [data-layer='0'],
  [data-active='1'] [data-layer='1'],
  [data-active='2'] [data-layer='2'],
  [data-active='3'] [data-layer='3'] {
    opacity: 1;
    transform: none;
  }
  /* Wide screens only: on a phone the picture just crossfades. */
  @media (min-width: 900px) {
    /*
     * The change of picture carries the chapter's class, briefly (under a second):
     * II wipes on a slant with a fel-green glaive edge, III comes into focus out of
     * an arcane shimmer (blurred and glowing, then sharp) under a violet glow. The
     * new picture sits on top and the old one
     * only collapses once it is covered, so nothing flashes black in either direction.
     */
    .scene--hunter .layer,
    .scene--classic .layer {
      z-index: 1;
      opacity: 1;
      transform: none;
      transition: clip-path 0s 1s;
    }
    .scene--hunter .layer {
      clip-path: polygon(0 0, 0 0, -30% 100%, -30% 100%);
    }
    .scene--classic .layer {
      opacity: 0;
      filter: blur(12px) brightness(1.5) saturate(1.3);
      transition:
        opacity 0s 1s,
        filter 0s 1s;
    }
    .scene--hunter [data-active='0'] [data-layer='0'],
    .scene--hunter [data-active='1'] [data-layer='1'],
    .scene--hunter [data-active='2'] [data-layer='2'],
    .scene--hunter [data-active='3'] [data-layer='3'] {
      z-index: 2;
      clip-path: polygon(0 0, 130% 0, 100% 100%, -30% 100%);
      transition: clip-path 0.9s cubic-bezier(0.65, 0, 0.25, 1);
    }
    .scene--classic [data-active='0'] [data-layer='0'],
    .scene--classic [data-active='1'] [data-layer='1'],
    .scene--classic [data-active='2'] [data-layer='2'] {
      z-index: 2;
      opacity: 1;
      filter: none;
      transition:
        opacity 0.7s ease,
        filter 1s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    /* The effect over the change: drawn only while the stage has .is-shifting (about-story.ts). */
    .scene--hunter .scrolly__stage::after,
    .scene--classic .scrolly__stage::after {
      content: '';
      position: absolute;
      z-index: 3;
      pointer-events: none;
      opacity: 0;
    }
    .scene--hunter .scrolly__stage::after {
      inset: -10% auto -10% 0;
      width: 12%;
      background: linear-gradient(90deg, transparent, rgb(124 255 58 / 0.5) 40%, rgb(226 255 190 / 0.85) 55%, transparent);
      filter: blur(2px);
      mix-blend-mode: screen;
      transform: translateX(-150%) skewX(-14deg);
    }
    .scene--hunter .scrolly__stage:global(.is-shifting)::after {
      animation: fel-slash 0.9s cubic-bezier(0.65, 0, 0.25, 1);
    }
    .scene--classic .scrolly__stage::after {
      inset: 0;
      background: radial-gradient(70% 60% at 50% 50%, rgb(207 166 255 / 0.45), rgb(120 80 220 / 0.15) 60%, transparent 80%);
      mix-blend-mode: screen;
    }
    .scene--classic .scrolly__stage:global(.is-shifting)::after {
      animation: arcane-glow 1s ease-out;
    }
    @keyframes fel-slash {
      0% {
        opacity: 1;
        transform: translateX(-150%) skewX(-14deg);
      }
      85% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        transform: translateX(950%) skewX(-14deg);
      }
    }
    @keyframes arcane-glow {
      0% {
        opacity: 0;
      }
      30% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
  }

  @media (min-width: 900px) {
    .story .scrolly {
      max-width: 110rem;
      grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
    /* Pinned in the middle of the screen, never taller than a landscape frame wants. */
    .scrolly__stage {
      display: block;
      --stage-h: min(calc(100svh - var(--header-h) - 4rem), 760px);
      grid-area: 1 / 2;
      top: calc(var(--header-h) + (100svh - var(--header-h) - var(--stage-h)) / 2);
      height: var(--stage-h);
      aspect-ratio: auto;
      box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
    }
    .scrolly__steps {
      grid-area: 1 / 1;
      padding-block: 10svh 20svh;
    }
    .scrolly__steps {
      display: block;
    }
    .step {
      min-height: 85svh;
    }
    .step__media {
      display: none;
    }
    /* Only the step beside the picture reads at full strength. */
    .story:global(.is-live) .step:not(:global(.is-active)) .step__box {
      opacity: 0.4;
    }
    .story .scrolly--wide {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
    }
    .scrolly--wide .scrolly__stage {
      grid-area: 1 / 1;
    }

    .scrolly--wide .scrolly__steps {
      grid-area: 1 / 2;
    }
  }
</style>

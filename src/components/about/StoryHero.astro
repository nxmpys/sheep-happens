---
/**
 * Scene 1 of the about story: Pandaria at sunrise, the title in its dark sky.
 * As it scrolls away the title fades and lifts while the landscape layers
 * drift at their own speeds (`--p`, set by about-story.ts); the opening
 * paragraphs come in over the fog below.
 */
import StoryArt from './StoryArt.astro';
import type { Locale } from '../../i18n/routes';
import type { StoryCopy } from './story-copy';

interface Props {
  locale: Locale;
  copy: StoryCopy['hero'];
}

const { locale, copy } = Astro.props;
---

<div class="opening" id="story-start" data-chapter="0">
  <section class="hero" data-hero aria-labelledby="story-title">
    <div class="hero__art">
      <StoryArt name="pandaria" locale={locale} eager />
    </div>
    <div class="hero__copy">
      <p class="hero__kicker">{copy.kicker}</p>
      <h2 class="hero__title" id="story-title">{copy.title}</h2>
      <p class="hero__lead">{copy.lead}</p>
    </div>
    <a class="hero__scroll" href="#story-intro">
      <span>{copy.scroll}</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6"></path></svg>
    </a>
  </section>

  <div class="intro story__inner" id="story-intro">
    {
      copy.body.map((text, i) => (
        <p class:list={['intro__line', i === 1 && 'intro__line--aside']} data-reveal style={`--d: ${i * 0.08}s`}>
          {text}
        </p>
      ))
    }
  </div>
</div>

<style>
  .hero {
    --p: 0;
    position: relative;
    display: grid;
    align-content: center;
    min-height: max(540px, calc(100svh - var(--header-h)));
    overflow: hidden;
  }
  .hero__art {
    position: absolute;
    inset: 0;
  }
  /* A shade on the left and a fade at the bottom keep the title readable on any picture. */
  .hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(14 13 22 / 0.78), rgb(14 13 22 / 0.35) 45%, transparent 70%),
      linear-gradient(180deg, transparent 60%, #0e0d16);
  }
  /* On phones the title spans the whole picture: darken all of it a little. */
  @media (max-width: 700px) {
    .hero__art::after {
      background:
        linear-gradient(rgb(14 13 22 / 0.45), rgb(14 13 22 / 0.45)),
        linear-gradient(180deg, transparent 60%, #0e0d16);
    }
  }
  .hero__art :global(img.art) {
    transform: translate3d(0, calc(var(--p) * 140px), 0) scale(1.06);
  }
  .hero__art :global([data-depth]) {
    transform: translate3d(0, calc(var(--p) * var(--depth) * 420px), 0);
  }
  .hero__copy {
    position: relative;
    width: min(100% - 2 * var(--gutter), var(--page-max) - 2 * var(--gutter));
    margin: 0 auto;
    padding-bottom: 18vh;
    transform: translate3d(0, calc(var(--p) * -90px), 0);
    opacity: calc(1 - var(--p) * 1.8);
  }
  /* The rune stroke over the title (motion.css) in Pandaria gold, not the site's violet. */
  .hero__title::before {
    background: #e5c97f;
  }
  .hero__kicker {
    margin: 0 0 var(--space-3);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e5c97f;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 2rem + 7vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #fff8ec;
    text-shadow: 0 4px 30px rgb(10 6 20 / 0.5);
  }
  .hero__lead {
    max-width: 26ch;
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.9rem);
    font-style: italic;
    line-height: 1.3;
    color: #f4e6d4;
    text-shadow: 0 2px 16px rgb(10 6 20 / 0.6);
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    min-width: 44px;
    padding: var(--space-2);
    transform: translateX(-50%);
    color: #f4e6d4;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: calc(0.85 - var(--p) * 3);
  }
  .hero__scroll svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll svg {
      animation: nudge 2.4s ease-in-out infinite;
    }
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }
  .intro {
    display: grid;
    gap: var(--space-5);
    max-width: calc(40rem + 2 * var(--gutter));
    padding-block: var(--space-7) clamp(5rem, 14vh, 9rem);
  }
  .intro__line {
    margin: 0;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    line-height: 1.6;
    color: #ecebf4;
  }
  .intro__line--aside {
    font-family: 'Permanent Marker', var(--font-display);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    color: #e5c97f;
    transform: rotate(-1.5deg);
  }
</style>

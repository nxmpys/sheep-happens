---
/**
 * A decorative frame laid over one story picture, in the style of what the
 * picture shows (story-images.ts picks it): Pandaria gold and jade, fel
 * thorns, loa bone and spirit blue, Shadowlands silver and embers, dragon
 * scales, Mage fire, arcane runes (violet, or fel green for TBC) or classic
 * WoW gold. Four drawn corners plus
 * inset border lines and a glow; it never catches the pointer.
 */
import { FRAME_COLORS, type FrameStyle } from './story-images';

interface Props {
  variant: FrameStyle;
}

const { variant } = Astro.props;
const corners = ['tl', 'tr', 'br', 'bl'];
const colors = FRAME_COLORS[variant];
---

<span class="frame" style={`--frame-a: ${colors.a}; --frame-b: ${colors.b}; --frame-glow: ${colors.glow}`} aria-hidden="true">
  {
    corners.map((corner) => (
      <svg class:list={['frame__corner', `frame__corner--${corner}`]} viewBox="0 0 64 64">
        {variant === 'pandaria' && (
          <>
            <path class="frame__line" d="M6 58V18Q6 6 18 6H58" />
            <path class="frame__line frame__line--soft" d="M12 58V22Q12 12 22 12H58" />
            <path class="frame__line" d="M20 30q0-10 10-10q8 0 8 8q0 6-6 6q-4 0-4-4" />
            <path class="frame__fill" d="M44 6l4-4 4 4-4 4zM6 44l-4 4 4 4 4-4z" />
          </>
        )}
        {variant === 'fel' && (
          <>
            <path class="frame__line" d="M5 60V5H60" />
            <path class="frame__fill" d="M5 5L34 11L15 15L11 34Z" />
            <path class="frame__fill" d="M40 5l7 9 3-9zM5 40l9 7-9 3z" />
          </>
        )}
        {variant === 'loa' && (
          <>
            <path class="frame__line" d="M6 58V20Q6 6 20 6H58" />
            <path class="frame__fill" d="M9 9Q32 10 38 34Q28 20 11 19Z" />
            <circle class="frame__fill frame__fill--soft" cx="46" cy="6" r="3" />
            <circle class="frame__fill frame__fill--soft" cx="6" cy="46" r="3" />
          </>
        )}
        {variant === 'shadow' && (
          <>
            <path class="frame__line" d="M6 58V6H58" />
            <path class="frame__line frame__line--soft" d="M12 58V12H58" />
            <path class="frame__fill" d="M6 6h22l-7 7h-8v8l-7 7z" />
            <path class="frame__fill frame__fill--soft" d="M40 3l3 3-3 3-3-3zM3 40l3-3 3 3-3 3z" />
          </>
        )}
        {variant === 'dragon' && (
          <>
            <path class="frame__line" d="M6 58V18Q6 6 18 6H58" />
            <path class="frame__line frame__line--soft" d="M10 34a8 8 0 0 1 16 0M18 24a8 8 0 0 1 16 0M26 14a8 8 0 0 1 16 0" />
            <path class="frame__fill" d="M8 8l14 3-6 5-5 6z" />
          </>
        )}
        {variant === 'fire' && (
          <>
            <path class="frame__line" d="M6 58V14Q6 6 14 6H58" />
            <path class="frame__fill" d="M8 8C24 9 30 20 22 34C20 24 15 23 9 28C12 20 10 14 8 8Z" />
            <path class="frame__fill frame__fill--soft" d="M30 8c8 1 11 6 8 12c-1-4-4-5-7-3c2-3 1-6-1-9zM8 30c1 8 6 11 12 8c-4-1-5-4-3-7c-3 2-6 1-9-1z" />
          </>
        )}
        {(variant === 'arcane' || variant === 'felrune') && (
          <>
            <path class="frame__line" d="M30 6H60M6 30V60" />
            <path class="frame__line frame__line--soft" d="M30 11H60M11 30V60" />
            <circle class="frame__line" cx="17" cy="17" r="11" />
            <circle class="frame__line frame__line--soft" cx="17" cy="17" r="7" stroke-dasharray="2 3" />
            <path class="frame__fill" d="M17 10l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
          </>
        )}
        {variant === 'classic' && (
          <>
            <path class="frame__line" d="M6 58V6H58" />
            <path class="frame__line frame__line--soft" d="M12 58V12H58" />
            <path class="frame__fill" d="M6 6h12l-12 12zM30 6l4 4-4 4-4-4zM6 30l4 4-4 4-4-4z" />
            <circle class="frame__fill frame__fill--soft" cx="19" cy="19" r="3.5" />
          </>
        )}
      </svg>
    ))
  }
</span>

<style>
  .frame {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--frame-a) 85%, transparent),
      inset 0 0 0 6px rgb(14 13 22 / 0.3),
      inset 0 0 0 7px color-mix(in srgb, var(--frame-b) 55%, transparent),
      inset 0 0 28px color-mix(in srgb, var(--frame-glow) 30%, transparent);
  }
  .frame__corner {
    position: absolute;
    width: clamp(36px, 5vw, 64px);
    height: auto;
    max-width: none;
    overflow: visible;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--frame-glow) 70%, transparent));
  }
  .frame__corner--tl {
    top: 6px;
    left: 6px;
  }
  .frame__corner--tr {
    top: 6px;
    right: 6px;
    transform: scaleX(-1);
  }
  .frame__corner--br {
    right: 6px;
    bottom: 6px;
    transform: scale(-1);
  }
  .frame__corner--bl {
    bottom: 6px;
    left: 6px;
    transform: scaleY(-1);
  }
  .frame__line {
    fill: none;
    stroke: var(--frame-a);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .frame__line--soft {
    stroke: var(--frame-b);
    stroke-width: 1.5;
  }
  .frame__fill {
    fill: var(--frame-a);
  }
  .frame__fill--soft {
    fill: var(--frame-b);
  }
</style>

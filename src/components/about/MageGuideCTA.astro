---
/**
 * The end of the story: a closed grimoire. Pointing at it lifts the cover a
 * little; clicking, tapping or pressing Enter opens it on a page with three
 * ways into the guide and a margin note. The main button to the guide sits
 * under the book and never needs the book opened. Without JavaScript the book
 * is simply open.
 */
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/locale';
import type { Locale } from '../../i18n/routes';
import type { StoryCopy } from './story-copy';

interface Props {
  locale: Locale;
  copy: StoryCopy['guide'];
}

const { locale, copy } = Astro.props;
const entries = [
  { ...copy.pages[0]!, icon: 'arcane', url: href('learn', locale) },
  { ...copy.pages[1]!, icon: 'frost', url: href('changes', locale) },
  { ...copy.pages[2]!, icon: 'fire', url: href('builds', locale) },
] as const;
---

<div class="grimoire" data-grimoire data-open="true" data-reveal>
  <div class="grimoire__stage">
    <div class="grimoire__book">
      <div class="grimoire__page" id="grimoire-page" data-grimoire-page>
        <ul>
          {
            entries.map((entry) => (
              <li>
                <a href={entry.url} class={`grimoire__entry school-${entry.icon}`}>
                  <Icon name={entry.icon} size={22} />
                  <span>
                    <strong>{entry.title}</strong>
                    <span>{entry.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <button class="grimoire__cover" type="button" aria-expanded="true" aria-controls="grimoire-page" data-grimoire-toggle data-labels={JSON.stringify({ open: copy.open, close: copy.close })}>
        <span class="grimoire__front" aria-hidden="true">
          <!-- A Mage's tome: leather over boards, a spine, thin gilt corners and a Kirin Tor-style eye in a rune circle. -->
          <svg viewBox="0 0 300 400" class="grimoire__art">
            <defs>
              <linearGradient id="tome-spine" x1="0" x2="1">
                <stop offset="0" stop-color="#140a1f" />
                <stop offset="0.6" stop-color="#2a1640" />
                <stop offset="1" stop-color="#1a0e28" />
              </linearGradient>
              <radialGradient id="tome-iris">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="0.35" stop-color="#e2ccff" />
                <stop offset="0.7" stop-color="#a46bff" />
                <stop offset="1" stop-color="#4a2196" />
              </radialGradient>
              <radialGradient id="tome-glow">
                <stop offset="0" stop-color="#b98bff" stop-opacity="0.55" />
                <stop offset="1" stop-color="#b98bff" stop-opacity="0" />
              </radialGradient>
            </defs>
            <rect width="30" height="400" fill="url(#tome-spine)" />
            <path class="grimoire__line grimoire__line--thin" d="M30 0V400" />
            <path class="grimoire__line" d="M262 22H282V42M282 358V378H262M70 378H50V358M50 42V22H70" />
            <rect class="grimoire__line grimoire__line--thin" x="58" y="30" width="216" height="340" rx="3" />
            <circle cx="166" cy="200" r="80" fill="url(#tome-glow)" class="grimoire__pulse" />
            <circle class="grimoire__line" cx="166" cy="200" r="54" />
            <circle class="grimoire__line grimoire__line--thin" cx="166" cy="200" r="46" stroke-dasharray="2 6" />
            <path class="grimoire__eye" d="M128 200Q166 170 204 200Q166 230 128 200Z" />
            <circle cx="166" cy="200" r="12" fill="url(#tome-iris)" class="grimoire__pulse" />
            <circle cx="166" cy="200" r="3.5" fill="#1a0f2b" />
          </svg>
        </span>
        <span class="grimoire__back" aria-hidden="true">
          <span class="grimoire__margin">{copy.margin}</span>
        </span>
        <span class="visually-hidden" data-grimoire-label>{copy.close}</span>
      </button>
    </div>
  </div>
  <a class="button button--primary grimoire__cta" href={href('guide', locale)}>
    {copy.cta}
    <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  for (const book of document.querySelectorAll<HTMLElement>('[data-grimoire]')) {
    const toggle = book.querySelector<HTMLButtonElement>('[data-grimoire-toggle]')!;
    const page = book.querySelector<HTMLElement>('[data-grimoire-page]')!;
    const label = book.querySelector<HTMLElement>('[data-grimoire-label]')!;
    const labels: { open: string; close: string } = JSON.parse(toggle.dataset.labels ?? '{}');
    const set = (open: boolean) => {
      book.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? labels.close : labels.open;
      // Links under the closed cover can't be reached by keyboard or screen readers.
      page.inert = !open;
    };
    set(false);
    toggle.addEventListener('click', () => set(book.dataset.open !== 'true'));
  }
</script>

<style>
  .grimoire {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }
  .grimoire__stage {
    --page-w: min(300px, 78vw);
    width: calc(var(--page-w) * 2);
    max-width: 100%;
    perspective: 1600px;
  }
  .grimoire__book {
    position: relative;
    width: var(--page-w);
    aspect-ratio: 3 / 4;
    margin-left: auto;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.2, 1);
  }
  /* Closed, the book sits centred; open, it slides right so both pages fit. */
  .grimoire[data-open='false'] .grimoire__book {
    transform: translateX(-50%);
  }
  .grimoire__page,
  .grimoire__cover {
    position: absolute;
    inset: 0;
    border-radius: 4px 12px 12px 4px;
  }
  .grimoire__page {
    display: grid;
    align-content: center;
    padding: var(--space-5) var(--space-4);
    background:
      repeating-linear-gradient(180deg, transparent 0 27px, rgb(120 84 40 / 0.14) 27px 28px),
      radial-gradient(120% 90% at 30% 20%, #f6ead0, #e4cfa4);
    box-shadow:
      inset 12px 0 18px -10px rgb(70 40 10 / 0.45),
      0 18px 40px rgb(0 0 0 / 0.45);
    color: #2b1d10;
  }
  .grimoire__page ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grimoire__page li {
    margin: 0 !important;
  }
  .grimoire__entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    line-height: 1.35;
  }
  .grimoire__entry > span {
    display: grid;
  }
  .grimoire__entry strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: #2b1d10;
  }
  .grimoire__entry span span {
    font-size: var(--step--1);
    color: #5a4128;
  }
  .grimoire__entry :global(.icon) {
    margin-top: 4px;
  }
  .school-arcane :global(.icon) {
    color: #7a3fd1;
  }
  .school-frost :global(.icon) {
    color: #00629b;
  }
  .school-fire :global(.icon) {
    color: #ad4700;
  }
  .grimoire__entry:hover,
  .grimoire__entry:focus-visible {
    background: rgb(120 84 40 / 0.14);
  }
  .grimoire__entry:focus-visible {
    outline: 3px solid #b25d00;
    outline-offset: 2px;
  }
  /* The cover turns on its spine; its back becomes the left page. */
  .grimoire__cover {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: left center;
    transform: rotateY(-178deg);
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .grimoire[data-open='false'] .grimoire__cover {
    transform: rotateY(0);
  }
  @media (hover: hover) {
    .grimoire[data-open='false'] .grimoire__cover:hover {
      transform: rotateY(-24deg);
    }
  }
  .grimoire__cover:focus-visible {
    outline: 3px solid #ffd56a;
    outline-offset: 4px;
  }
  .grimoire__front,
  .grimoire__back {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    backface-visibility: hidden;
  }
  /* Leather cover; the stepped shadows to the right and below are the page block and the back board. */
  .grimoire__front {
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 58% 42%, #4d2b6b, #2c1743 58%, #170c24),
      #2c1743;
    box-shadow:
      3px 3px 0 #f1e6ca,
      5px 5px 0 #d8c7a0,
      7px 7px 0 #bba97e,
      9px 9px 0 #1f1030,
      0 24px 44px rgb(0 0 0 / 0.55);
  }
  .grimoire__art {
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .grimoire__line {
    fill: none;
    stroke: #d6b25e;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .grimoire__line--thin {
    stroke-width: 1.2;
    stroke-opacity: 0.7;
  }
  .grimoire__eye {
    fill: #1a0f2b;
    stroke: #e5c97f;
    stroke-width: 2;
  }
  @media (prefers-reduced-motion: no-preference) {
    .grimoire__pulse {
      animation: tome-pulse 3.6s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
  }
  @keyframes tome-pulse {
    50% {
      opacity: 0.7;
      transform: scale(0.94);
    }
  }
  .grimoire__back {
    transform: rotateY(180deg);
    align-items: end;
    padding: var(--space-5);
    background: radial-gradient(120% 90% at 70% 20%, #f6ead0, #e0c99c);
    box-shadow: inset -12px 0 18px -10px rgb(70 40 10 / 0.45);
  }
  .grimoire__margin {
    font-family: 'Permanent Marker', var(--font-display);
    font-size: var(--step-1);
    color: #7a3fd1;
    transform: rotate(-6deg);
  }
  .grimoire__cta {
    gap: var(--space-2);
    padding-inline: var(--space-5);
    font-size: var(--step-0);
  }
  /* Narrow screens: no room for two pages, the cover swings open edge-on. */
  @media (max-width: 640px) {
    .grimoire__stage {
      width: var(--page-w);
    }
    .grimoire[data-open='false'] .grimoire__book {
      transform: none;
    }
    .grimoire__cover {
      transform: rotateY(-100deg);
    }
  }
</style>

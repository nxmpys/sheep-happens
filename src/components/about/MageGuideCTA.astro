---
/**
 * The end of the story: a closed grimoire. Pointing at it lifts the cover a
 * little; clicking, tapping or pressing Enter opens it on a page with three
 * ways into the guide and a margin note. The main button to the guide sits
 * under the book and never needs the book opened. Without JavaScript the book
 * is simply open.
 */
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/locale';
import type { Locale } from '../../i18n/routes';
import type { StoryCopy } from './story-copy';

interface Props {
  locale: Locale;
  copy: StoryCopy['guide'];
}

const { locale, copy } = Astro.props;
const entries = [
  { ...copy.pages[0]!, icon: 'arcane', url: href('learn', locale) },
  { ...copy.pages[1]!, icon: 'frost', url: href('changes', locale) },
  { ...copy.pages[2]!, icon: 'fire', url: href('builds', locale) },
] as const;
---

<div class="grimoire" data-grimoire data-open="true" data-reveal>
  <div class="grimoire__stage">
    <div class="grimoire__book">
      <div class="grimoire__page" id="grimoire-page" data-grimoire-page>
        <ul>
          {
            entries.map((entry) => (
              <li>
                <a href={entry.url} class={`grimoire__entry school-${entry.icon}`}>
                  <Icon name={entry.icon} size={22} />
                  <span>
                    <strong>{entry.title}</strong>
                    <span>{entry.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <button class="grimoire__cover" type="button" aria-expanded="true" aria-controls="grimoire-page" data-grimoire-toggle data-labels={JSON.stringify({ open: copy.open, close: copy.close })}>
        <span class="grimoire__front" aria-hidden="true">
          <svg viewBox="0 0 100 100" class="grimoire__sigil">
            <circle cx="50" cy="50" r="34"></circle>
            <circle cx="50" cy="50" r="27" stroke-dasharray="2 5"></circle>
            <path d="M50 22L56 44L78 46L60 58L66 80L50 66L34 80L40 58L22 46L44 44Z"></path>
          </svg>
        </span>
        <span class="grimoire__back" aria-hidden="true">
          <span class="grimoire__margin">{copy.margin}</span>
        </span>
        <span class="visually-hidden" data-grimoire-label>{copy.close}</span>
      </button>
    </div>
  </div>
  <a class="button button--primary grimoire__cta" href={href('guide', locale)}>
    {copy.cta}
    <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  for (const book of document.querySelectorAll<HTMLElement>('[data-grimoire]')) {
    const toggle = book.querySelector<HTMLButtonElement>('[data-grimoire-toggle]')!;
    const page = book.querySelector<HTMLElement>('[data-grimoire-page]')!;
    const label = book.querySelector<HTMLElement>('[data-grimoire-label]')!;
    const labels: { open: string; close: string } = JSON.parse(toggle.dataset.labels ?? '{}');
    const set = (open: boolean) => {
      book.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? labels.close : labels.open;
      // Links under the closed cover can't be reached by keyboard or screen readers.
      page.inert = !open;
    };
    set(false);
    toggle.addEventListener('click', () => set(book.dataset.open !== 'true'));
  }
</script>

<style>
  .grimoire {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }
  .grimoire__stage {
    --page-w: min(300px, 78vw);
    width: calc(var(--page-w) * 2);
    max-width: 100%;
    perspective: 1600px;
  }
  .grimoire__book {
    position: relative;
    width: var(--page-w);
    aspect-ratio: 3 / 4;
    margin-left: auto;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.2, 1);
  }
  /* Closed, the book sits centred; open, it slides right so both pages fit. */
  .grimoire[data-open='false'] .grimoire__book {
    transform: translateX(-50%);
  }
  .grimoire__page,
  .grimoire__cover {
    position: absolute;
    inset: 0;
    border-radius: 4px 12px 12px 4px;
  }
  .grimoire__page {
    display: grid;
    align-content: center;
    padding: var(--space-5) var(--space-4);
    background:
      repeating-linear-gradient(180deg, transparent 0 27px, rgb(120 84 40 / 0.14) 27px 28px),
      radial-gradient(120% 90% at 30% 20%, #f6ead0, #e4cfa4);
    box-shadow:
      inset 12px 0 18px -10px rgb(70 40 10 / 0.45),
      0 18px 40px rgb(0 0 0 / 0.45);
    color: #2b1d10;
  }
  .grimoire__page ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grimoire__page li {
    margin: 0 !important;
  }
  .grimoire__entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    line-height: 1.35;
  }
  .grimoire__entry > span {
    display: grid;
  }
  .grimoire__entry strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: #2b1d10;
  }
  .grimoire__entry span span {
    font-size: var(--step--1);
    color: #5a4128;
  }
  .grimoire__entry :global(.icon) {
    margin-top: 4px;
  }
  .school-arcane :global(.icon) {
    color: #7a3fd1;
  }
  .school-frost :global(.icon) {
    color: #00629b;
  }
  .school-fire :global(.icon) {
    color: #ad4700;
  }
  .grimoire__entry:hover,
  .grimoire__entry:focus-visible {
    background: rgb(120 84 40 / 0.14);
  }
  .grimoire__entry:focus-visible {
    outline: 3px solid #b25d00;
    outline-offset: 2px;
  }
  /* The cover turns on its spine; its back becomes the left page. */
  .grimoire__cover {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: left center;
    transform: rotateY(-178deg);
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .grimoire[data-open='false'] .grimoire__cover {
    transform: rotateY(0);
  }
  @media (hover: hover) {
    .grimoire[data-open='false'] .grimoire__cover:hover {
      transform: rotateY(-24deg);
    }
  }
  .grimoire__cover:focus-visible {
    outline: 3px solid #ffd56a;
    outline-offset: 4px;
  }
  .grimoire__front,
  .grimoire__back {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    backface-visibility: hidden;
  }
  .grimoire__front {
    background:
      radial-gradient(80% 60% at 50% 40%, rgb(169 139 255 / 0.25), transparent 70%),
      linear-gradient(135deg, #3b2350, #1c1029);
    border: 2px solid #c9a24f;
    box-shadow:
      inset 0 0 0 8px #241634,
      inset 0 0 0 10px rgb(201 162 79 / 0.6),
      0 20px 40px rgb(0 0 0 / 0.5);
  }
  .grimoire__sigil {
    width: 52%;
    fill: none;
    stroke: #e5c97f;
    stroke-width: 2;
  }
  .grimoire__sigil path {
    fill: rgb(229 201 127 / 0.2);
  }
  .grimoire__back {
    transform: rotateY(180deg);
    align-items: end;
    padding: var(--space-5);
    background: radial-gradient(120% 90% at 70% 20%, #f6ead0, #e0c99c);
    box-shadow: inset -12px 0 18px -10px rgb(70 40 10 / 0.45);
  }
  .grimoire__margin {
    font-family: 'Permanent Marker', var(--font-display);
    font-size: var(--step-1);
    color: #7a3fd1;
    transform: rotate(-6deg);
  }
  .grimoire__cta {
    gap: var(--space-2);
    padding-inline: var(--space-5);
    font-size: var(--step-0);
  }
  /* Narrow screens: no room for two pages, the cover swings open edge-on. */
  @media (max-width: 640px) {
    .grimoire__stage {
      width: var(--page-w);
    }
    .grimoire[data-open='false'] .grimoire__book {
      transform: none;
    }
    .grimoire__cover {
      transform: rotateY(-100deg);
    }
  }
</style>

---
/**
 * The end of the story: a closed grimoire. Pointing at it lifts the cover a
 * little; clicking, tapping or pressing Enter opens it on a page with three
 * ways into the guide and a margin note. The main button to the guide sits
 * under the book and never needs the book opened. Without JavaScript the book
 * is simply open.
 */
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/locale';
import type { Locale } from '../../i18n/routes';
import type { StoryCopy } from './story-copy';

interface Props {
  locale: Locale;
  copy: StoryCopy['guide'];
}

const { locale, copy } = Astro.props;
const entries = [
  { ...copy.pages[0]!, icon: 'arcane', url: href('learn', locale) },
  { ...copy.pages[1]!, icon: 'frost', url: href('changes', locale) },
  { ...copy.pages[2]!, icon: 'fire', url: href('builds', locale) },
] as const;
---

<div class="grimoire" data-grimoire data-open="true" data-reveal>
  <div class="grimoire__stage">
    <div class="grimoire__book">
      <div class="grimoire__page" id="grimoire-page" data-grimoire-page>
        <ul>
          {
            entries.map((entry) => (
              <li>
                <a href={entry.url} class={`grimoire__entry school-${entry.icon}`}>
                  <Icon name={entry.icon} size={22} />
                  <span>
                    <strong>{entry.title}</strong>
                    <span>{entry.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <button class="grimoire__cover" type="button" aria-expanded="true" aria-controls="grimoire-page" data-grimoire-toggle data-labels={JSON.stringify({ open: copy.open, close: copy.close })}>
        <span class="grimoire__front" aria-hidden="true">
          <!-- A Mage's tome: leather over boards, a spine, thin gilt corners and the Kirin Tor emblem. -->
          <svg viewBox="0 0 300 400" class="grimoire__art">
            <defs>
              <linearGradient id="tome-spine" x1="0" x2="1">
                <stop offset="0" stop-color="#140a1f" />
                <stop offset="0.6" stop-color="#2a1640" />
                <stop offset="1" stop-color="#1a0e28" />
              </linearGradient>
              <radialGradient id="tome-glow">
                <stop offset="0" stop-color="#b98bff" stop-opacity="0.55" />
                <stop offset="1" stop-color="#b98bff" stop-opacity="0" />
              </radialGradient>
            </defs>
            <rect width="30" height="400" fill="url(#tome-spine)" />
            <path class="grimoire__line grimoire__line--thin" d="M30 0V400" />
            <path class="grimoire__line" d="M262 22H282V42M282 358V378H262M70 378H50V358M50 42V22H70" />
            <rect class="grimoire__line grimoire__line--thin" x="58" y="30" width="216" height="340" rx="3" />
            <circle cx="166" cy="200" r="80" fill="url(#tome-glow)" class="grimoire__pulse" />
            <!-- The Kirin Tor emblem, traced from the reference artwork (273×433), scaled onto the cover. -->
            <g class="grimoire__crest" transform="translate(103.3 105.4) scale(0.46)">
              <path fill-rule="evenodd" d="M157.5 186.8L114.5 187.5L113.0 304.5L112.2 306.8L103.8 311.2L102.8 329.0L110.2 330.2L114.2 332.5L118.0 336.2L120.8 343.0L120.8 348.2L118.8 353.5L115.0 358.0L110.2 360.8L106.0 361.8L101.2 361.8L100.8 363.0L102.2 368.2L136.0 433.0L138.8 429.2L167.8 373.0L171.8 363.0L171.2 361.8L166.5 361.8L159.5 359.5L154.5 354.8L151.8 348.8L152.0 341.5L155.5 335.0L161.5 330.5L169.8 329.0L168.8 311.5L161.2 307.5L159.5 305.8L158.8 228.2ZM54.2 173.0L52.8 173.0L35.0 222.0L33.8 223.5L24.8 228.2L22.0 240.5L22.5 241.5L26.8 241.8L31.8 244.2L34.8 247.5L36.5 252.2L36.0 257.0L34.8 259.5L30.8 263.5L24.0 265.5L19.2 265.0L21.0 287.8L23.2 303.0L26.0 314.5L29.0 322.2L30.0 321.5L30.8 313.8L33.8 301.5L37.5 292.2L41.8 284.8L45.8 279.2L52.5 272.2L59.5 267.0L68.8 262.0L85.8 183.0L84.0 182.0ZM218.8 172.8L187.2 182.5L186.8 184.0L203.8 262.0L213.8 267.5L220.2 272.5L227.5 280.2L232.0 286.8L239.0 302.2L241.8 314.2L242.2 321.2L243.5 322.2L245.5 318.0L249.8 299.8L253.2 265.5L252.2 264.8L245.2 265.0L240.8 262.8L236.8 257.8L236.0 252.2L236.8 249.0L240.2 244.5L243.5 242.5L249.8 241.5L250.5 240.8L247.8 228.2L238.8 223.5L237.2 221.5L219.8 173.0ZM0.0 111.2L0.5 112.5L22.8 126.5L43.5 136.2L62.8 143.2L63.2 144.2L56.8 161.2L57.0 163.5L87.5 172.8L88.2 172.0L91.8 154.2L93.2 150.5L114.2 153.2L115.0 154.0L115.2 176.8L157.5 176.8L157.5 154.0L158.2 153.2L179.2 150.8L180.0 151.5L184.5 172.5L215.5 163.5L215.8 161.5L209.2 144.5L209.8 143.0L226.0 137.5L243.8 129.5L257.2 122.2L272.5 112.0L260.5 87.8L259.5 87.8L236.2 101.8L210.2 114.5L195.2 120.5L181.2 125.0L160.8 129.2L160.8 128.0L164.8 125.2L171.2 118.0L175.8 109.8L178.8 98.8L178.8 88.0L176.8 79.5L172.5 70.5L166.8 63.2L159.0 57.0L155.8 55.8L155.8 54.5L157.0 54.5L172.2 61.8L186.5 71.5L203.5 87.5L215.0 101.5L255.5 78.0L240.5 49.0L219.5 65.5L217.0 66.8L200.2 52.0L193.2 47.0L181.0 40.0L162.8 33.0L144.0 29.8L127.2 29.8L109.5 33.0L96.5 37.8L86.0 43.0L75.8 49.5L63.8 58.8L55.2 66.8L32.5 49.2L31.5 49.2L17.0 77.8L18.8 79.5L57.8 101.5L69.8 86.8L79.0 77.5L88.5 69.5L104.5 59.5L113.0 55.5L117.2 54.5L117.0 55.5L113.5 57.0L106.5 62.5L99.5 71.2L95.0 81.8L93.5 90.5L94.2 102.0L97.0 110.5L102.0 119.0L107.2 124.8L111.8 128.2L112.0 129.2L93.8 125.8L76.5 120.2L64.5 115.5L35.2 101.2L13.0 87.8L12.0 87.8ZM135.0 74.8L141.8 75.5L148.5 79.5L153.0 85.5L154.5 92.0L154.0 98.0L150.8 104.5L145.2 109.2L138.5 111.5L130.8 110.8L125.8 108.2L120.8 103.0L118.0 96.5L118.0 90.0L119.8 85.0L122.0 81.5L128.0 76.8ZM55.0 33.2L55.5 53.5L64.2 45.8L75.8 37.8L91.0 29.5L99.5 26.0L115.0 21.5L129.2 19.5L143.2 19.5L151.8 20.5L166.2 23.8L184.2 30.8L199.8 39.8L209.8 47.0L216.5 53.2L217.5 53.0L217.2 33.0L210.0 26.8L195.5 16.8L179.8 8.8L166.2 4.0L149.8 0.8L141.2 0.0L122.5 0.8L114.5 2.0L99.8 6.0L88.2 10.8L76.5 17.0L63.8 25.8Z" />
            </g>
          </svg>
        </span>
        <span class="grimoire__back" aria-hidden="true">
          <span class="grimoire__margin">{copy.margin}</span>
        </span>
        <span class="visually-hidden" data-grimoire-label>{copy.close}</span>
      </button>
    </div>
  </div>
  <a class="button button--primary grimoire__cta" href={href('learn', locale)}>
    {copy.cta}
    <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  for (const book of document.querySelectorAll<HTMLElement>('[data-grimoire]')) {
    const toggle = book.querySelector<HTMLButtonElement>('[data-grimoire-toggle]')!;
    const page = book.querySelector<HTMLElement>('[data-grimoire-page]')!;
    const label = book.querySelector<HTMLElement>('[data-grimoire-label]')!;
    const labels: { open: string; close: string } = JSON.parse(toggle.dataset.labels ?? '{}');
    const set = (open: boolean) => {
      book.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? labels.close : labels.open;
      // Links under the closed cover can't be reached by keyboard or screen readers.
      page.inert = !open;
    };
    set(false);
    toggle.addEventListener('click', () => set(book.dataset.open !== 'true'));
  }
</script>

<style>
  .grimoire {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }
  .grimoire__stage {
    --page-w: min(300px, 78vw);
    width: calc(var(--page-w) * 2);
    max-width: 100%;
    perspective: 1600px;
  }
  .grimoire__book {
    position: relative;
    width: var(--page-w);
    aspect-ratio: 3 / 4;
    margin-left: auto;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.2, 1);
  }
  /* Closed, the book sits centred; open, it slides right so both pages fit. */
  .grimoire[data-open='false'] .grimoire__book {
    transform: translateX(-50%);
  }
  .grimoire__page,
  .grimoire__cover {
    position: absolute;
    inset: 0;
    border-radius: 4px 12px 12px 4px;
  }
  .grimoire__page {
    display: grid;
    align-content: center;
    padding: var(--space-5) var(--space-4);
    background:
      repeating-linear-gradient(180deg, transparent 0 27px, rgb(120 84 40 / 0.14) 27px 28px),
      radial-gradient(120% 90% at 30% 20%, #f6ead0, #e4cfa4);
    box-shadow:
      inset 12px 0 18px -10px rgb(70 40 10 / 0.45),
      0 18px 40px rgb(0 0 0 / 0.45);
    color: #2b1d10;
  }
  .grimoire__page ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grimoire__page li {
    margin: 0 !important;
  }
  .grimoire__entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    line-height: 1.35;
  }
  .grimoire__entry > span {
    display: grid;
  }
  .grimoire__entry strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: #2b1d10;
  }
  .grimoire__entry span span {
    font-size: var(--step--1);
    color: #5a4128;
  }
  .grimoire__entry :global(.icon) {
    margin-top: 4px;
  }
  .school-arcane :global(.icon) {
    color: #7a3fd1;
  }
  .school-frost :global(.icon) {
    color: #00629b;
  }
  .school-fire :global(.icon) {
    color: #ad4700;
  }
  .grimoire__entry:hover,
  .grimoire__entry:focus-visible {
    background: rgb(120 84 40 / 0.14);
  }
  .grimoire__entry:focus-visible {
    outline: 3px solid #b25d00;
    outline-offset: 2px;
  }
  /* The cover turns on its spine; its back becomes the left page. */
  .grimoire__cover {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-origin: left center;
    transform: rotateY(-178deg);
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .grimoire[data-open='false'] .grimoire__cover {
    transform: rotateY(0);
  }
  /* The tilt keys off the book's fixed box, not the cover itself: a tilted cover
     pulls its right edge in from under the pointer, which would end the hover,
     drop the tilt and start it again in a loop. */
  @media (hover: hover) {
    .grimoire[data-open='false'] .grimoire__book:hover .grimoire__cover {
      transform: rotateY(-24deg);
    }
  }
  .grimoire__cover:focus-visible {
    outline: 3px solid #ffd56a;
    outline-offset: 4px;
  }
  .grimoire__front,
  .grimoire__back {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    backface-visibility: hidden;
  }
  /* Leather cover; the stepped shadows to the right and below are the page block and the back board. */
  .grimoire__front {
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 58% 42%, #4d2b6b, #2c1743 58%, #170c24),
      #2c1743;
    box-shadow:
      3px 3px 0 #f1e6ca,
      5px 5px 0 #d8c7a0,
      7px 7px 0 #bba97e,
      9px 9px 0 #1f1030,
      0 24px 44px rgb(0 0 0 / 0.55);
  }
  .grimoire__art {
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .grimoire__line {
    fill: none;
    stroke: #d6b25e;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .grimoire__line--thin {
    stroke-width: 1.2;
    stroke-opacity: 0.7;
  }
  .grimoire__crest {
    fill: #d6b25e;
    filter: drop-shadow(0 0 6px rgb(185 139 255 / 0.55));
  }
  @media (prefers-reduced-motion: no-preference) {
    .grimoire__pulse {
      animation: tome-pulse 3.6s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
  }
  @keyframes tome-pulse {
    50% {
      opacity: 0.7;
      transform: scale(0.94);
    }
  }
  .grimoire__back {
    transform: rotateY(180deg);
    align-items: end;
    padding: var(--space-5);
    background: radial-gradient(120% 90% at 70% 20%, #f6ead0, #e0c99c);
    box-shadow: inset -12px 0 18px -10px rgb(70 40 10 / 0.45);
  }
  .grimoire__margin {
    font-family: 'Permanent Marker', var(--font-display);
    font-size: var(--step-1);
    color: #7a3fd1;
    transform: rotate(-6deg);
  }
  .grimoire__cta {
    gap: var(--space-2);
    padding-inline: var(--space-5);
    font-size: var(--step-0);
  }
  /* Narrow screens: no room for two pages, the cover swings open edge-on. */
  @media (max-width: 640px) {
    .grimoire__stage {
      width: var(--page-w);
    }
    .grimoire[data-open='false'] .grimoire__book {
      transform: none;
    }
    .grimoire__cover {
      transform: rotateY(-100deg);
    }
  }
</style>

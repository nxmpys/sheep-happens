---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { href } from '../../i18n/locale';
import { PRIMARY_NAV, breadcrumbTrail, navPages, type Locale, type NavGroup, type PageId } from '../../i18n/routes';
import { NAV_GROUP_LABELS, NAV_LABELS, t } from '../../i18n/ui';
import { usedContents } from '../../lib/build-routes';
import { builds } from '../../lib/data';
import { menuBlocks } from '../../lib/nav-menu';

interface Props {
  locale: Locale;
  pageId: PageId | undefined;
  /** Other-language URL for pages outside ROUTES. */
  switchTo?: string | undefined;
}

const { locale, pageId, switchTo } = Astro.props;
const trail = pageId ? breadcrumbTrail(pageId) : [];
const labels = NAV_LABELS[locale];
// Five entries: the link goes to the hub page, the dropdown straight to what is
// inside it (open on hover or with the arrow; always open in the mobile menu).
// The entry is highlighted on its hub and on every page under it.
const menuOptions = { base: import.meta.env.BASE_URL, contents: usedContents(builds) };
const currentGroup =
  PRIMARY_NAV.find((group) => pageId !== undefined && navPages([group]).includes(pageId)) ??
  PRIMARY_NAV.find((group) => trail.includes(group.page));
const inGroup = (group: NavGroup) => group === currentGroup && pageId !== group.page;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={href('home', locale)} aria-label={`${t(locale, 'site.name')} — ${labels.home}`}>
      <Logo size={34} />
      <span class="brand__name">Sheep Happens</span>
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label={t(locale, 'nav.primary')} data-nav>
      <ul class="nav-list">
        {
          PRIMARY_NAV.map((group) => {
            const blocks = menuBlocks(group, locale, menuOptions);
            // Two columns only when one long list would not fit.
            const count = Math.max(...blocks.map((block) => block.links.length));
            const panelId = `nav-panel-${group.key}`;
            const name = NAV_GROUP_LABELS[locale][group.key];
            return (
              <li class="nav-item" data-submenu>
                <a
                  href={href(group.page, locale)}
                  class:list={['nav-link', { 'is-section': inGroup(group) }]}
                  aria-current={pageId === group.page ? 'page' : undefined}
                >
                  {name}
                </a>
                <button
                  type="button"
                  class="nav-toggle"
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-label={t(locale, 'nav.submenu').replace('{name}', name)}
                  data-submenu-toggle
                >
                  <Icon name="chevronDown" size={14} strokeWidth={2.5} />
                </button>
                <div class:list={['nav-panel', { 'nav-panel--wide': count > 6 }]} id={panelId}>
                  <div class="nav-panel__box">
                    {blocks.map((block) => (
                      <div class="nav-block">
                        {block.heading && <p class="nav-block__heading">{block.heading}</p>}
                        <ul class:list={['nav-sublist', { 'nav-sublist--trees': block.links[0]?.tree }]}>
                          {block.links.map((link) => (
                            <li>
                              <a
                                class:list={['nav-sublink', link.tree && ['nav-sublink--tree', `school-${link.tree}`]]}
                                href={link.url}
                                aria-current={link.page && link.page === pageId ? 'page' : undefined}
                              >
                                {link.tree && <Icon name={link.tree} size={15} />}
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
      <span class="nav-thread" aria-hidden="true" data-thread></span>
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger" data-search-open aria-haspopup="dialog">
        <Icon name="search" size={18} />
        <span class="search-trigger__label">{t(locale, 'search.open')}</span>
        <kbd class="search-trigger__kbd" aria-hidden="true">/</kbd>
      </button>
      <LangSwitch locale={locale} pageId={pageId} to={switchTo} />
      <ThemeToggle locale={locale} />
      <button
        type="button"
        class="icon-button menu-toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-menu-toggle
        data-label-open={t(locale, 'nav.menu')}
        data-label-close={t(locale, 'nav.closeMenu')}
      >
        <Icon name="menu" size={22} class="menu-toggle__open" />
        <Icon name="close" size={22} class="menu-toggle__close" />
        <span class="visually-hidden" data-menu-label>{t(locale, 'nav.menu')}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  function setMenu(open: boolean, { restoreFocus = false } = {}) {
    if (!menuButton || !nav) return;
    menuButton.setAttribute('aria-expanded', String(open));
    nav.dataset.open = String(open);
    const label = menuButton.querySelector('[data-menu-label]');
    if (label) label.textContent = (open ? menuButton.dataset.labelClose : menuButton.dataset.labelOpen) ?? '';
    if (!open && restoreFocus) menuButton.focus();
  }

  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));

  // Dropdowns: hover opens them with CSS; the arrow opens them for keyboard and
  // touch. Escape also hides the one under the pointer until the pointer leaves.
  const submenus = [...(nav?.querySelectorAll<HTMLElement>('[data-submenu]') ?? [])];
  const toggleOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('[data-submenu-toggle]');

  function setSubmenu(item: HTMLElement, open: boolean) {
    item.dataset.open = String(open);
    toggleOf(item)?.setAttribute('aria-expanded', String(open));
  }

  for (const item of submenus) {
    toggleOf(item)?.addEventListener('click', () => {
      const open = item.dataset.open !== 'true';
      for (const other of submenus) setSubmenu(other, other === item && open);
    });
    item.addEventListener('mouseleave', () => delete item.dataset.dismissed);
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) setSubmenu(item, false);
    });
    // An anchor on the same page does not navigate: the menu has to get out of the way by itself.
    item.querySelector('.nav-panel')?.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('a')) return;
      setSubmenu(item, false);
      item.dataset.dismissed = 'true';
      setMenu(false);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openItem = submenus.find((item) => item.dataset.open === 'true');
    for (const item of submenus) {
      if (item.matches(':hover')) item.dataset.dismissed = 'true';
    }
    if (openItem) {
      setSubmenu(openItem, false);
      toggleOf(openItem)?.focus();
    } else if (menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false, { restoreFocus: true });
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    for (const item of submenus) {
      if (!item.contains(target)) setSubmenu(item, false);
    }
    if (header && !header.contains(target)) setMenu(false);
  });

  // Mana thread: the line under the current section slides to the entry under
  // the pointer and comes back when it leaves (desktop menu only).
  const thread = nav?.querySelector<HTMLElement>('[data-thread]');
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('.nav-link') ?? [])];
  const desktop = matchMedia('(min-width: 1001px)');
  const home = () => links.find((link) => link.matches('[aria-current="page"], .is-section'));
  const place = (link?: HTMLElement) => {
    if (!thread || !desktop.matches) return;
    if (!link) {
      thread.style.opacity = '0';
      return;
    }
    // Measured against the nav: each entry is now the positioning parent of its own dropdown.
    const box = link.getBoundingClientRect();
    const origin = nav!.getBoundingClientRect();
    thread.style.opacity = '1';
    thread.style.left = `${box.left - origin.left + 10}px`;
    thread.style.width = `${box.width - 20}px`;
    thread.style.top = `${box.bottom - origin.top - 2}px`;
  };
  if (thread && nav) {
    nav.classList.add('has-thread');
    for (const link of links) {
      link.addEventListener('mouseenter', () => place(link));
      link.addEventListener('focus', () => place(link));
    }
    nav.addEventListener('mouseleave', () => place(home()));
    nav.addEventListener('focusout', () => place(home()));
    // No transition for the first placement, so the line does not fly in on every page.
    thread.style.transition = 'none';
    place(home());
    requestAnimationFrame(() => thread.style.removeProperty('transition'));
    window.addEventListener('resize', () => place(home()));
    document.fonts?.ready.then(() => place(home()));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand__name {
    font-family: 'Cinzel Decorative', var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .primary-nav {
    flex: 1;
    min-width: 0;
  }
  .header-actions,
  .brand {
    flex-shrink: 0;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 22px;
    min-height: 40px;
    margin-left: -2px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text-subtle);
    cursor: pointer;
  }
  .nav-toggle:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav-toggle :global(svg) {
    transition: transform 0.15s;
  }
  .nav-item[data-open='true'] .nav-toggle :global(svg) {
    transform: rotate(180deg);
  }
  /* The padding is part of the panel, so the pointer can cross from the entry without closing it. */
  .nav-panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1;
    width: max-content;
    min-width: 13rem;
    padding-top: var(--space-3);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.15s,
      transform 0.15s,
      visibility 0.15s;
  }
  .nav-panel__box {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    box-shadow: var(--shadow);
  }
  /* A title, not a link: a band across the top of the panel, nothing like the rows below it. */
  .nav-block__heading {
    margin: calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--surface-2);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    cursor: default;
  }
  /* The three trees hang from Talents: chips in their school's colour, indented under it. */
  .nav-sublist.nav-sublist--trees {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0 var(--space-2) var(--space-1) var(--space-5);
  }
  .nav-sublink.nav-sublink--tree {
    gap: 0.3em;
    min-height: 30px;
    padding: 0 0.65em;
    border: 1px solid color-mix(in srgb, var(--school) 40%, transparent);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .nav-sublink.nav-sublink--tree :global(svg) {
    color: var(--school);
  }
  .nav-sublink.nav-sublink--tree:hover {
    border-color: var(--school);
    background: var(--school-soft);
  }
  .nav-sublink.nav-sublink--tree[aria-current='page'] {
    border-color: var(--school);
    background: var(--school-soft);
    box-shadow: none;
  }
  .nav-sublist {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-panel--wide .nav-sublist {
    grid-template-columns: repeat(2, minmax(10.5rem, 1fr));
  }
  .nav-sublink {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .nav-sublink:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav-sublink[aria-current='page'] {
    color: var(--text);
    font-weight: 650;
    box-shadow: inset 3px 0 0 var(--accent);
  }
  @media (min-width: 1001px) {
    .nav-item:hover:not([data-dismissed]) .nav-panel,
    .nav-item[data-open='true'] .nav-panel {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-panel,
    .nav-toggle :global(svg) {
      transition: none;
      transform: none;
    }
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-1) 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav-link[aria-current='page'],
  .nav-link.is-section {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .primary-nav {
    position: relative;
  }
  /* With the thread, the static underline steps aside. */
  .has-thread .nav-link[aria-current='page'],
  .has-thread .nav-link.is-section {
    box-shadow: none;
  }
  .nav-thread {
    position: absolute;
    left: 0;
    width: 0;
    height: 2px;
    border-radius: 2px;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent),
      color-mix(in srgb, var(--accent) 45%, #fff),
      var(--accent),
      transparent
    );
    background-size: 200% 100%;
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 80%, transparent);
    transition:
      left 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.2s;
    animation: nav-thread 2.4s linear infinite;
  }
  @keyframes nav-thread {
    to {
      background-position: -200% 0;
    }
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface-1);
    color: var(--text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .search-trigger:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .menu-toggle {
    display: none;
  }
  .menu-toggle :global(.menu-toggle__close) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
    display: inline-block;
  }

  @media (max-width: 1000px) {
    .menu-toggle {
      display: inline-grid;
    }
    .primary-nav {
      display: none;
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
      box-shadow: var(--shadow);
    }
    .primary-nav[data-open='true'] {
      display: block;
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2) var(--gutter) var(--space-4);
    }
    .nav-item {
      display: block;
    }
    .nav-link {
      display: flex;
      min-height: 48px;
      padding: 0 var(--space-3);
      font-size: var(--step-0);
      font-weight: 650;
      color: var(--text);
    }
    /* In the mobile menu everything is already in sight: there is nothing to open. */
    .nav-toggle {
      display: none;
    }
    .nav-panel {
      position: static;
      width: auto;
      min-width: 0;
      padding: 0 0 var(--space-2);
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .nav-panel__box {
      gap: var(--space-1);
      padding: 0 0 0 var(--space-3);
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }
    .nav-sublist,
    .nav-panel--wide .nav-sublist {
      grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    }
    .nav-sublink {
      min-height: 44px;
    }
    .nav-sublink.nav-sublink--tree {
      min-height: 40px;
    }
    .nav-sublist.nav-sublist--trees {
      display: flex;
      padding-left: var(--space-3);
    }
    .nav-block__heading {
      margin: 0 0 var(--space-1);
      padding: 0 var(--space-3);
      border: 0;
      background: none;
    }
    .nav-link[aria-current='page'],
    .nav-link.is-section,
    .has-thread .nav-link[aria-current='page'],
    .has-thread .nav-link.is-section {
      box-shadow: inset 3px 0 0 var(--accent);
      border-radius: 0;
    }
    .nav-thread {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .search-trigger {
      width: 44px;
      height: 44px;
      padding: 0;
      justify-content: center;
      border-radius: var(--radius-sm);
    }
    .search-trigger__label,
    .search-trigger__kbd {
      display: none;
    }
    .brand__name {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 380px) {
    .brand__name {
      display: none;
    }
  }
</style>

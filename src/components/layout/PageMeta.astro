---
/**
 * One line of page metadata under the title: «Revisado 16 oct 2026 · Beta oct
 * 2026 · [Análisis] · 3 fuentes · [Puede cambiar]», then a collapsible legend
 * that explains every verification label once per page and links to the
 * sources page («Cómo verificamos»).
 */
import Icon from '../ui/Icon.astro';
import StatusBadge from '../guide/StatusBadge.astro';
import StatusLegend from '../guide/StatusLegend.astro';
import { href } from '../../i18n/locale';
import type { Locale } from '../../i18n/routes';
import { formatShortDate, t } from '../../i18n/ui';
import { getVersion } from '../../lib/data';
import type { PageFrontmatter } from '../../lib/schemas';

interface Props {
  locale: Locale;
  data: PageFrontmatter;
  /** Latest of the page review and the last update of the data it shows (lib/seo.ts). */
  modified: Date;
  /** Number of sources listed at the end of the page. */
  sourceCount: number;
  /** Show the label legend (pages whose content already has one leave it out). */
  legend?: boolean;
}

const { locale, data, modified, sourceCount, legend = true } = Astro.props;
const version = getVersion(data.gameVersion);
---

<div class="meta">
  <p class="meta__line">
    <span class="meta__item">
      <Icon name="calendar" size={15} />
      {t(locale, 'meta.reviewed')} <time datetime={modified.toISOString().slice(0, 10)}>{formatShortDate(locale, modified)}</time>
    </span>
    <span class="meta__sep" aria-hidden="true">·</span>
    <span class="meta__item">{version.short[locale]}</span>
    <span class="meta__sep" aria-hidden="true">·</span>
    <span class="meta__item">
      <span class="visually-hidden">{t(locale, 'meta.verification')}: </span>
      <StatusBadge status={data.verification} />
    </span>
    {
      sourceCount > 0 && (
        <>
          <span class="meta__sep" aria-hidden="true">·</span>
          <a class="meta__item" href="#page-sources">
            {sourceCount === 1 ? t(locale, 'meta.sourceCount') : t(locale, 'meta.sourcesCount', { count: sourceCount })}
          </a>
        </>
      )
    }
    {
      version.stage === 'beta' && (
        <a class="meta__beta" href={href('sources', locale)} title={t(locale, 'meta.betaWarning')}>
          <Icon name="warning" size={14} />
          {t(locale, 'meta.betaShort')}
          <span class="visually-hidden">: {t(locale, 'meta.betaWarning')} {t(locale, 'meta.howWeVerify')}</span>
        </a>
      )
    }
  </p>
  {
    legend && (
      <details class="meta__legend" data-pagefind-ignore>
        <summary>{t(locale, 'meta.legend')}</summary>
        <p class="meta__legend-intro">{t(locale, 'meta.legendIntro')}</p>
        <StatusLegend />
        <p class="meta__legend-more">
          <a href={href('sources', locale)}>{t(locale, 'meta.howWeVerify')}</a>
        </p>
      </details>
    )
  }
</div>

<style>
  .meta {
    display: grid;
    gap: var(--space-2);
  }
  .meta__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .meta__item :global(svg) {
    color: var(--text-subtle);
  }
  .meta__sep {
    color: var(--text-subtle);
  }
  .meta__beta {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0 0.5em;
    border-radius: 999px;
    background: var(--warning-soft);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .meta__beta :global(svg) {
    color: var(--warning);
  }
  .meta__beta:hover {
    text-decoration: underline;
  }
  .meta__legend {
    font-size: var(--step--1);
  }
  .meta__legend summary {
    width: fit-content;
    cursor: pointer;
    color: var(--link);
    font-weight: 600;
  }
  .meta__legend[open] {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .meta__legend-intro {
    margin: var(--space-2) 0 var(--space-3);
    color: var(--text-muted);
  }
  .meta__legend-more {
    margin: var(--space-3) 0 0;
  }
</style>

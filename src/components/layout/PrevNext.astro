---
import Icon from '../ui/Icon.astro';
import { href } from '../../i18n/locale';
import { neighbours, type Locale, type PageId } from '../../i18n/routes';
import { NAV_LABELS, t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  pageId: PageId;
  /** «compact»: small links next to the page index, to move on without scrolling to the end. */
  variant?: 'full' | 'compact';
}

const { locale, pageId, variant = 'full' } = Astro.props;
const { prev, next } = neighbours(pageId);
---

{
  (prev || next) && variant === 'compact' && (
    <nav class="pager-mini" aria-label={t(locale, 'nav.pager')} data-pagefind-ignore>
      {prev && (
        <a class="pager-mini__link" href={href(prev, locale)} rel="prev">
          <Icon name="arrowLeft" size={14} />
          <span>
            <span class="pager-mini__dir">{t(locale, 'nav.prev')}</span>
            {NAV_LABELS[locale][prev]}
          </span>
        </a>
      )}
      {next && (
        <a class="pager-mini__link pager-mini__link--next" href={href(next, locale)} rel="next">
          <span>
            <span class="pager-mini__dir">{t(locale, 'nav.next')}</span>
            {NAV_LABELS[locale][next]}
          </span>
          <Icon name="arrowRight" size={14} />
        </a>
      )}
    </nav>
  )
}
{
  (prev || next) && variant === 'full' && (
    <nav class="pager" aria-label={t(locale, 'nav.pager')} data-pagefind-ignore>
      {prev ? (
        <a class="pager__link pager__link--prev" href={href(prev, locale)} rel="prev">
          <span class="pager__dir">
            <Icon name="arrowLeft" size={16} />
            {t(locale, 'nav.prev')}
          </span>
          <span class="pager__title">{NAV_LABELS[locale][prev]}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager__link pager__link--next" href={href(next, locale)} rel="next">
          <span class="pager__dir">
            {t(locale, 'nav.next')}
            <Icon name="arrowRight" size={16} />
          </span>
          <span class="pager__title">{NAV_LABELS[locale][next]}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    color: var(--text);
    text-decoration: none;
  }
  .pager__link:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .pager__link--next {
    grid-column: 2;
    text-align: right;
    align-items: flex-end;
  }
  .pager__dir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .pager__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .pager-mini {
    display: grid;
    gap: var(--space-1);
  }
  .pager-mini__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.3;
    text-decoration: none;
  }
  .pager-mini__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .pager-mini__link--next {
    justify-content: flex-end;
    text-align: right;
  }
  .pager-mini__dir {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager__link--next {
      grid-column: 1;
    }
  }
</style>

---
import Icon from '../ui/Icon.astro';
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { SUPPORT_URL } from '../../lib/support';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="support" aria-labelledby="support-title" data-pagefind-ignore>
  <p class="support__title" id="support-title">{t(locale, 'support.title')}</p>
  <p class="support__body">{t(locale, 'support.body')}</p>
  <a class="button button--primary" href={SUPPORT_URL} target="_blank" rel="noopener noreferrer">
    <Icon name="coffee" size={18} />
    {t(locale, 'support.cta')}
  </a>
</aside>

<style>
  .support {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    max-width: var(--content-max);
    margin-top: var(--space-7);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-1);
  }
  .support__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .support__body {
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
</style>

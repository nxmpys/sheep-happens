---
/**
 * The six Mage races as portraits by faction, each with the contents where it is
 * my first pick (race-picks.json). For the first steps page: the full reasoning
 * is on the races page.
 */
import GameIcon from './GameIcon.astro';
import { FACTION_LABELS } from '../../i18n/builds';
import { getLocale, href } from '../../i18n/locale';
import { racePicks, races } from '../../lib/data';
import '../../styles/learn.css';

const locale = getLocale(Astro);
const es = locale === 'es';
const bestAt = (id: string, faction: 'alliance' | 'horde') => racePicks.filter((pick) => pick[faction][0] === id).map((pick) => pick.situation[locale]);
---

<div class="strip" data-no-spell-links>
  {
    (['alliance', 'horde'] as const).map((faction) => (
      <section class={`strip__side strip__side--${faction}`}>
        <p class="strip__faction">{FACTION_LABELS[locale][faction]}</p>
        <ul class="strip__races">
          {races
            .filter((race) => race.faction === faction)
            .map((race) => (
              <li>
                <a class="strip__race" href={`${href('races', locale)}#race-${race.id}`}>
                  <GameIcon icon={race.icon} size={56} />
                  <span class="strip__name">{race.name[locale].replace(/\s*\(.*\)$/, '')}</span>
                  <span class="strip__best">
                    {bestAt(race.id, faction).length > 0 ? bestAt(race.id, faction).join(' · ') : es ? 'Sobre todo por gusto' : 'Mostly for the looks'}
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
  }
  .strip__side {
    padding: var(--space-3);
    border-top: 3px solid var(--faction);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--faction-soft), transparent 70%);
  }
  .strip__side--alliance {
    --faction: var(--frost);
    --faction-soft: var(--frost-soft);
  }
  .strip__side--horde {
    --faction: var(--fire);
    --faction-soft: var(--fire-soft);
  }
  .strip__faction {
    margin: 0 0 var(--space-2);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faction);
  }
  :global(.prose) .strip__races {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.prose) .strip__races li {
    margin: 0;
  }
  .strip__race {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-1);
    border-radius: var(--radius-sm);
    color: var(--text);
    text-align: center;
    text-decoration: none;
  }
  .strip__race:hover {
    background: var(--surface-2);
  }
  .strip__race :global(.game-icon) {
    border-radius: 50%;
  }
  .strip__name {
    font-weight: 650;
  }
  .strip__best {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-muted);
  }
</style>

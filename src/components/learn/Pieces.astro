---
/**
 * A Markdown list shown as a grid of cards, for short points that start in bold:
 *   <Pieces>
 *   - **Freeze to shatter.** Ice Lance…
 *   </Pieces>
 * `dont` marks each one as a mistake to avoid.
 */
import '../../styles/learn.css';

interface Props {
  dont?: boolean;
}

const { dont = false } = Astro.props;
---

<div class:list={['pieces', { 'pieces--dont': dont }]}>
  <slot />
</div>

<style>
  .pieces :global(ul) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pieces :global(li) {
    margin: 0 !important;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-left: 3px solid var(--school, var(--accent));
    border-radius: var(--radius);
    background: var(--surface-1);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .pieces :global(li > strong:first-child),
  .pieces :global(li > p > strong:first-child) {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--step-0);
  }
  .pieces--dont :global(li) {
    border-left-color: var(--nerf);
  }
</style>

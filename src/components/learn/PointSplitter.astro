---
/**
 * «Your 51 points»: three sliders that share the budget, with each tree's
 * milestone talents lighting up as you reach their points.
 */
import GameIcon from './GameIcon.astro';
import Icon from '../ui/Icon.astro';
import '../../styles/learn.css';
import { getLocale, href } from '../../i18n/locale';
import { NAV_LABELS, t } from '../../i18n/ui';
import { milestonesForTree, talentText, talents } from '../../lib/data';
import { TREE_ICONS } from '../../lib/icons';
import { localSpellName } from '../../lib/names';

const TOTAL = 51;
const TREES = ['arcane', 'fire', 'frost'] as const;
const locale = getLocale(Astro);
const es = locale === 'es';
const trees = TREES.map((tree) => ({
  tree,
  milestones: milestonesForTree(tree).map((slot) => {
    const talent = talents.find((t) => t.tree === tree && t.name === slot.name);
    return { points: slot.points, name: slot.name ?? '', icon: talent ? talentText.talents[talent.id]?.icon : undefined };
  }),
}));
const initial = { arcane: 0, fire: 0, frost: 0 };
const copy = es
  ? { left: 'Puntos libres', calc: 'Probarlo con todos los talentos en la calculadora', points: 'puntos' }
  : { left: 'Points left', calc: 'Try it with every talent in the calculator', points: 'points' };
---

<point-splitter class="splitter" data-total={TOTAL} data-no-spell-links>
  <p class="splitter__left">
    <output data-left>{TOTAL - initial.arcane - initial.fire - initial.frost}</output>
    <span>{copy.left}</span>
  </p>
  <div class="splitter__trees">
    {
      trees.map(({ tree, milestones }) => (
        <section class={`tree school-${tree}`}>
          <header class="tree__head">
            <GameIcon icon={TREE_ICONS[tree]} size={40} />
            <span class="tree__name">{NAV_LABELS[locale][`talents-${tree}`]}</span>
            <output class="tree__points" data-points={tree}>{initial[tree]}</output>
          </header>
          <input
            class="tree__range"
            type="range"
            min="0"
            max={TOTAL}
            value={initial[tree]}
            data-tree={tree}
            aria-label={`${NAV_LABELS[locale][`talents-${tree}`]}: ${copy.points}`}
          />
          <ol class="tree__milestones">
            {milestones.map((milestone) => (
              <li class="milestone" data-at={milestone.points} data-tree-of={tree}>
                {milestone.name ? <GameIcon spell={milestone.name} icon={milestone.icon} size={40} /> : <span class="milestone__blank" aria-hidden="true">?</span>}
                <span class="milestone__name">{milestone.name ? localSpellName(milestone.name, locale) : t(locale, 'milestones.unknown')}</span>
                <span class="milestone__at">{milestone.points}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
  <p class="splitter__links">
    <a href={href('talent-calc', locale)}>{copy.calc} <Icon name="arrowRight" size={14} /></a>
  </p>
</point-splitter>

<script>
  class PointSplitter extends HTMLElement {
    connectedCallback() {
      const total = Number(this.dataset.total);
      const ranges = [...this.querySelectorAll<HTMLInputElement>('input[data-tree]')];
      const left = this.querySelector('[data-left]')!;
      const draw = () => {
        left.textContent = String(total - ranges.reduce((sum, r) => sum + Number(r.value), 0));
        for (const range of ranges) {
          const tree = range.dataset.tree!;
          this.querySelector(`[data-points="${tree}"]`)!.textContent = range.value;
          range.style.setProperty('--fill', `${(Number(range.value) / total) * 100}%`);
          for (const milestone of this.querySelectorAll<HTMLElement>(`[data-tree-of="${tree}"]`)) {
            milestone.dataset.on = String(Number(range.value) >= Number(milestone.dataset.at));
          }
        }
      };
      for (const range of ranges) {
        range.addEventListener('input', () => {
          // The three trees share the budget: a slider stops where the points run out.
          const others = ranges.filter((r) => r !== range).reduce((sum, r) => sum + Number(r.value), 0);
          if (Number(range.value) + others > total) range.value = String(total - others);
          draw();
        });
      }
      draw();
    }
  }
  customElements.define('point-splitter', PointSplitter);
</script>

<style>
  .splitter {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .splitter p {
    margin: 0;
  }
  .splitter__left {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 650;
  }
  .splitter__left output {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    color: var(--accent);
  }
  .splitter__trees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
  }
  .tree {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--school) 35%, var(--border));
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--school-soft), var(--surface-1) 60%);
  }
  .tree__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .tree__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .tree__points {
    margin-left: auto;
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--school);
  }
  .tree__range {
    width: 100%;
    height: 44px;
    margin: 0;
    background: none;
    accent-color: var(--school);
    cursor: pointer;
  }
  :global(.prose) .tree__milestones {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.prose) .milestone {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    transition: opacity 0.2s;
  }
  .milestone :global(.game-icon) {
    transition:
      filter 0.2s,
      box-shadow 0.2s;
  }
  .milestone[data-on='false'] {
    opacity: 0.55;
    color: var(--text-muted);
  }
  .milestone[data-on='false'] :global(.game-icon) {
    filter: grayscale(1);
  }
  .milestone[data-on='true'] :global(.game-icon) {
    box-shadow: 0 0 0 1px var(--school), 0 0 12px color-mix(in srgb, var(--school) 55%, transparent);
  }
  .milestone__blank {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px dashed var(--border-strong);
    border-radius: 6px;
    font-weight: 800;
  }
  .milestone__at {
    display: grid;
    place-items: center;
    min-width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .milestone[data-on='true'] .milestone__at {
    border-color: var(--school);
    background: var(--school);
    color: var(--surface-1);
  }
  .splitter__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--step--1);
    font-weight: 600;
  }
</style>

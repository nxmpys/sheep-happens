---
/**
 * A row of big picture cards (<HCard>) that the page scroll moves sideways while
 * the row stays pinned, with a counter and ticks. On phones, with «reduce motion»
 * or without JavaScript it is a row you swipe by hand, and every card stays readable.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<h-scroll class="hs" role="group" aria-label={label}>
  <div class="hs__sticky">
    <div class="hs__track" data-track>
      <slot />
    </div>
    <div class="hs__meter" aria-hidden="true">
      <span class="hs__count"><strong data-current>01</strong> / <span data-total></span></span>
      <span class="hs__bar"><span class="hs__fill" data-fill></span></span>
    </div>
  </div>
</h-scroll>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');

  class HScroll extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-track]')!;
      const cards = [...track.children] as HTMLElement[];
      const current = this.querySelector<HTMLElement>('[data-current]')!;
      const fill = this.querySelector<HTMLElement>('[data-fill]')!;
      this.querySelector<HTMLElement>('[data-total]')!.textContent = pad(cards.length);
      const pinnable = matchMedia('(min-width: 62rem) and (prefers-reduced-motion: no-preference)');
      let distance = 0;
      let frame = 0;

      const show = (progress: number) => {
        fill.style.transform = `scaleX(${progress})`;
        // The card that fills the view: the first at the start, the last only at the very end.
        current.textContent = pad(Math.round(progress * (cards.length - 1)) + 1);
      };
      const draw = () => {
        frame = 0;
        if (!this.classList.contains('is-pinned')) {
          const max = track.scrollWidth - track.clientWidth;
          show(max > 0 ? track.scrollLeft / max : 0);
          return;
        }
        const travel = this.offsetHeight - innerHeight;
        const progress = travel > 0 ? Math.min(1, Math.max(0, -this.getBoundingClientRect().top / travel)) : 0;
        track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;
        show(progress);
      };
      const request = () => {
        if (!frame) frame = requestAnimationFrame(draw);
      };
      const measure = () => {
        this.classList.toggle('is-pinned', pinnable.matches);
        track.style.transform = '';
        if (pinnable.matches) {
          distance = Math.max(0, track.scrollWidth - innerWidth);
          this.style.height = `${distance + innerHeight}px`;
        } else {
          this.style.height = '';
        }
        draw();
      };

      addEventListener('scroll', request, { passive: true });
      track.addEventListener('scroll', request, { passive: true });
      addEventListener('resize', measure);
      pinnable.addEventListener('change', measure);
      // Pictures load lazily and can change the row's width.
      new ResizeObserver(measure).observe(track);
      measure();
      // Cards off to the side would load only as they slide in, blank at first: load them all on approach.
      const approach = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          for (const picture of this.querySelectorAll('img')) picture.loading = 'eager';
          approach.disconnect();
        },
        { rootMargin: '100% 0px' },
      );
      approach.observe(this);
    }
  }
  if (!customElements.get('h-scroll')) customElements.define('h-scroll', HScroll);
</script>

<style>
  .hs {
    display: block;
    margin-block: var(--space-5);
    margin-inline: calc(50% - 50vw);
  }
  /* A fixed column: without it the row's full width would stretch the meter off the screen. */
  .hs__sticky {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .hs__track {
    display: flex;
    gap: var(--space-4);
    padding-inline: max(var(--space-4), calc(50vw - var(--content-max, 72rem) / 2));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-4);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .hs__meter {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: max(var(--space-4), calc(50vw - var(--content-max, 72rem) / 2));
    font-size: var(--step--1);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .hs__count strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--text);
  }
  .hs__bar {
    flex: 1;
    height: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .hs__fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* Pinned: the row fills the window under the header and moves with the page scroll. */
  .hs.is-pinned .hs__sticky {
    position: sticky;
    top: var(--header-h);
    align-content: center;
    height: calc(100vh - var(--header-h));
    overflow: hidden;
  }
  .hs.is-pinned .hs__track {
    width: max-content;
    overflow: visible;
    will-change: transform;
  }
</style>

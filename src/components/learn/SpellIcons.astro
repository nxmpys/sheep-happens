---
/**
 * The icons of the spells a card talks about, in a row, each with its tooltip.
 * The names are in the text next to them, so the icons carry no label:
 *   - <SpellIcons spells={['Ice Lance', 'Frost Nova']} /> **Freeze to shatter.** …
 */
import GameIcon from './GameIcon.astro';
import '../../styles/learn.css';

interface Props {
  spells: string[];
}

const { spells } = Astro.props;
---

<span class="spell-icons">{spells.map((spell) => <GameIcon spell={spell} size={36} />)}</span>

<style>
  .spell-icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
</style>

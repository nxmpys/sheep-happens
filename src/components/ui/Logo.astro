---
/** The Sheep Happens mark: a polymorphed sheep with an arcane spark. Original artwork. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className } = Astro.props;
---

<svg class:list={['logo', className]} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <g class="logo__legs">
    <rect x="12.2" y="26" width="2.8" height="8" rx="1.4"></rect>
    <rect x="23.6" y="26" width="2.8" height="8" rx="1.4"></rect>
  </g>
  <g class="logo__wool">
    <circle cx="12" cy="19" r="6.4"></circle>
    <circle cx="19" cy="14.5" r="6.4"></circle>
    <circle cx="26" cy="19" r="6.4"></circle>
    <circle cx="15.5" cy="24" r="5.8"></circle>
    <circle cx="22.5" cy="24" r="5.8"></circle>
  </g>
  <g class="logo__head">
    <ellipse cx="31.5" cy="20.5" rx="4.6" ry="5.6"></ellipse>
    <ellipse cx="28.6" cy="15.6" rx="2.6" ry="1.3" transform="rotate(-25 28.6 15.6)"></ellipse>
  </g>
  <circle class="logo__eye" cx="32.9" cy="19.4" r="1"></circle>
  <path class="logo__spark" d="M7 1.5l1.3 4.2L12.5 7 8.3 8.3 7 12.5 5.7 8.3 1.5 7l4.2-1.3z"></path>
</svg>

<style>
  .logo {
    flex-shrink: 0;
  }
  .logo__wool {
    fill: var(--text);
  }
  .logo__legs,
  .logo__head {
    fill: var(--accent);
  }
  .logo__eye {
    fill: var(--bg);
  }
  .logo__spark {
    fill: var(--baseline);
  }
</style>

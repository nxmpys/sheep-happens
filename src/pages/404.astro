---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/ui/Logo.astro';
import { href } from '../i18n/locale';
import { t } from '../i18n/ui';
---

<BaseLayout locale="es" pageId={undefined} title={t('es', 'notFound.title')} description={t('es', 'notFound.body')} noindex>
  <div class="container not-found">
    <Logo size={96} />
    <h1>{t('es', 'notFound.title')}</h1>
    <p>{t('es', 'notFound.body')}</p>
    <p lang="en">{t('en', 'notFound.body')}</p>
    <p class="links">
      <a class="button button--primary" href={href('home', 'es')}>Ir al inicio</a>
      <a class="button" href={href('home', 'en')} lang="en">Go home</a>
      <button type="button" class="button" data-search-open>{t('es', 'search.open')}</button>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-8);
    max-width: 40rem;
  }
  h1 {
    font-size: var(--step-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

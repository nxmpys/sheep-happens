  "chain": [
    {
      "kind": "data",
      "text": {
        "es": "Conjurar agua cuesta lo mismo, se aprende a los mismos niveles y crece igual. La botella rinde lo mismo en los rangos 1 a 4.",
        "en": "Conjure Water costs the same, is learned at the same levels and grows the same way. A bottle restores the same in ranks 1 to 4."
      }
    },
    {
      "kind": "data",
      "text": {
        "es": "Los hechizos cuestan el mismo maná y hacen menos daño base.",
        "en": "Spells cost the same mana and deal less base damage."
      }
    },
    {
      "kind": "data",
      "text": {
        "es": "Parte del equipo de tela cambia Intelecto por spell power o mp5.",
        "en": "Some cloth gear trades Intellect for spell power or mp5."
      }
    },
    {
      "kind": "inference",
      "text": {
        "es": "Si el spell power no cubre la diferencia, matar al mismo enemigo cuesta más maná.",
        "en": "If spell power does not cover the gap, killing the same enemy costs more mana."
      }
    },
    {
      "kind": "inference",
      "text": {
        "es": "Más maná gastado por muerte significa más botellas. Con menos reserva, además, paras antes.",
        "en": "More mana spent per kill means more bottles. With a smaller pool you also stop sooner."
      }
    },
    {
      "kind": "data",
      "text": {
        "es": "Hay más mazmorras en cada tramo de nivel y sus misiones dan mucha experiencia.",
        "en": "There are more dungeons in every level band and their quests give a lot of experience."
      }
    },
    {
      "kind": "inference",
      "text": {
        "es": "Más tiempo en grupo significa más gente pidiéndote agua. El efecto depende de cuántas mazmorras se hagan de verdad.",
        "en": "More group time means more people asking you for water. The effect depends on how many dungeons people actually run."
      }
    }
  ]
